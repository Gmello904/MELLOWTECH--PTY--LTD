HERE = Path(__file__).resolve().parent


def _load_settings_file():
    """Optional backend/settings.env with lines like KEY=value. Real environment variables always win."""
    file = HERE / "settings.env"
    if not file.is_file():
        return
    for line in file.read_text(encoding="utf-8-sig").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))


_load_settings_file()
ROOT = HERE if (HERE / "index.html").exists() else HERE.parent      # folder with index.html


def pick_data_dir():
    """First folder we can actually write to. On Elastic Beanstalk this is /var/app/data (survives deploys)."""
    candidates = [os.environ.get("MELLOWTECH_DATA_DIR"), "/var/app/data", str(HERE / "data"),
                  str(Path(tempfile.gettempdir()) / "mellowtech")]
    for candidate in candidates:
        if not candidate:
            continue
        try:
            folder = Path(candidate)
            folder.mkdir(parents=True, exist_ok=True)
            probe = folder / ".write_test"
            probe.write_text("ok")
            probe.unlink()
            if candidate == candidates[-1]:
                print(f"WARNING: using temporary folder {folder}. Data will be lost on redeploy.", flush=True)
            return folder
        except OSError:
            continue
    raise RuntimeError("No writable folder found for the MellowTech database.")


