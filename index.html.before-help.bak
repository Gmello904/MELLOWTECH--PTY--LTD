<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        /* Stops VS Code Live Server's auto-reload socket (it caused an endless reload loop).
           After editing a file, refresh with Ctrl+Shift+R. */
        (function () {
            var Native = window.WebSocket;
            if (!Native) return;
            function Blocked() {
                window.__mtLiveReloadBlocked = true;
                return { readyState: 3, close: function () {}, send: function () {},
                         addEventListener: function () {}, removeEventListener: function () {} };
            }
            window.WebSocket = function (url, protocols) {
                if (/\/ws$/.test(String(url).split("?")[0])) return Blocked();
                return protocols === undefined ? new Native(url) : new Native(url, protocols);
            };
            window.WebSocket.prototype = Native.prototype;
            ["CONNECTING", "OPEN", "CLOSING", "CLOSED"].forEach(function (k, i) { window.WebSocket[k] = i; });
        })();
    </script>
    <meta name="description" content="MellowTech Security Platform: live cybersecurity monitoring dashboard.">
    <meta name="theme-color" content="#0d1b2a">
    <meta name="mellowtech-version" content="2026.10.15-protection">
    <title>MellowTech Security Platform</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2l9 3v7c0 5.5-3.8 8.6-9 10-5.2-1.4-9-4.5-9-10V5z' fill='%230d1b2a'/%3E%3Cpath d='M8 12l3 3 5-6' fill='none' stroke='%233ddbb0' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <script>
    (function () {
        var t = null;
        try { t = localStorage.getItem("mt-theme"); } catch (e) {}
        if (!t) t = (window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
    })();
    </script>
    <link rel="stylesheet" href="style.css">

    <style>
        /* ===== top-right corner: plan badge, avatar, name, sign out ===== */
        .user-area { gap: 14px; }
        .plan-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: #e8eef5; color: #1d3550;
            padding: 7px 14px; border-radius: 999px;
            font-size: 12px; font-weight: 800; letter-spacing: .4px; cursor: pointer;
            transition: transform .15s, box-shadow .15s;
        }
        .plan-badge:hover { transform: translateY(-1px); box-shadow: 0 6px 14px rgba(15, 34, 54, .12); }
        .plan-badge.paid { background: linear-gradient(135deg, #d9f5ea, #bdeedd); color: #0b6b52; }
        .user-chip {
            display: flex; align-items: center; gap: 10px;
            padding: 5px 14px 5px 5px; border-radius: 999px;
            background: #f4f7fb; border: 1px solid #e3e9f0;
            font-size: 14px; font-weight: 700; color: #17202a;
        }
        .avatar {
            width: 34px; height: 34px; border-radius: 50%;
            display: grid; place-items: center;
            background: linear-gradient(135deg, #3ddbb0, #2f7de1);
            color: #07111d; font-size: 15px; font-weight: 800;
            box-shadow: 0 4px 10px rgba(47, 125, 225, .3);
        }
        .logout-button {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 18px; border-radius: 12px;
            background: #fff; color: #b4232f;
            border: 1.5px solid #f0b9be;
            font-family: inherit; font-size: 14px; font-weight: 700; cursor: pointer;
            transition: background .15s, color .15s, border-color .15s, transform .15s, box-shadow .15s;
        }
        .logout-button .icon { width: 18px; height: 18px; }
        .logout-button:hover {
            background: linear-gradient(135deg, #c62f3b, #8b2635); color: #fff; border-color: transparent;
            transform: translateY(-1px); box-shadow: 0 8px 18px rgba(139, 38, 53, .35); filter: none;
        }

        /* ===== Ask Mellow ===== */
        .am-box { background: #fff; border: 1px solid #e3e8ef; border-radius: 14px; margin-top: 16px; overflow: hidden; }
        .am-log { padding: 18px; min-height: 280px; max-height: 56vh; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        .am-msg { max-width: 82%; padding: 11px 14px; border-radius: 14px; line-height: 1.5; font-size: 14.5px; white-space: pre-wrap; word-wrap: break-word; }
        .am-msg.me { align-self: flex-end; background: #12b886; color: #fff; border-bottom-right-radius: 4px; }
        .am-msg.bot { align-self: flex-start; background: #f1f5f9; color: #0f2236; border-bottom-left-radius: 4px; }
        .am-msg.err { background: #ffeaea; color: #b42318; }
        .am-hints { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 14px; }
        .am-hints button { border: 1px solid #d8dee3; background: #fff; border-radius: 99px; padding: 7px 13px; cursor: pointer; font: 13px inherit; font-family: inherit; color: #0f2236; }
        .am-hints button:hover { border-color: #12b886; color: #0b6b50; }
        .am-form { display: flex; gap: 10px; padding: 14px 18px; border-top: 1px solid #eef1f4; }
        .am-form textarea { flex: 1; box-sizing: border-box; min-height: 44px; max-height: 120px; resize: vertical; padding: 10px 12px; border: 1.5px solid #d8dee3; border-radius: 9px; font: 14px inherit; font-family: inherit; }
        .am-foot { color: #5b6b7b; font-size: 12.5px; padding: 0 18px 14px; }

        /* ===== settings hub ===== */
        .stx-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 16px; margin-top: 18px; }
        .stx-tile { display: flex; gap: 14px; align-items: flex-start; text-align: left; width: 100%; padding: 18px; background: #fff; border: 1px solid #e3e8ef;
            border-radius: 14px; cursor: pointer; font-family: inherit; color: #0f2236; transition: transform .15s, box-shadow .15s, border-color .15s; }
        .stx-tile:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15, 34, 54, .10); border-color: #12b886; }
        .stx-tile:focus-visible { outline: 3px solid #12b886; outline-offset: 2px; }
        .stx-ico { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .stx-ico svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .stx-tile b { display: block; font-size: 15.5px; margin-bottom: 4px; }
        .stx-tile span.t { color: #5b6b7b; font-size: 13.5px; line-height: 1.45; }
        .stx-layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 20px; margin-top: 16px; align-items: start; }
        .stx-subnav { background: #fff; border: 1px solid #e3e8ef; border-radius: 14px; padding: 10px; position: sticky; top: 16px; }
        .stx-subnav button { display: block; width: 100%; text-align: left; border: 0; background: transparent; padding: 11px 12px; border-radius: 9px; cursor: pointer;
            font: 600 14px inherit; font-family: inherit; color: #3a4a5a; }
        .stx-subnav button:hover { background: #f1f5f9; }
        .stx-subnav button.on { background: #e6f7f1; color: #0b6b50; box-shadow: inset 3px 0 0 #12b886; }
        .stx-pane[hidden] { display: none; }
        .stx-note { color: #5b6b7b; font-size: 13.5px; margin: 6px 0 0; }
        .stx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 12px; }
        .stx-grid label.field, .stx-pane label.field { display: block; font-weight: 600; font-size: 13.5px; }
        .stx-pane textarea, .stx-pane select, .stx-pane input[type="text"], .stx-pane input[type="email"] { width: 100%; margin-top: 6px; padding: 10px 12px; border: 1.5px solid #d8dee3; border-radius: 9px; font: 14px inherit; font-family: inherit; background: #fff; }
        .stx-pane textarea, .stx-pane select, .stx-pane input[type="text"], .stx-pane input[type="email"] { box-sizing: border-box; }
        .stx-pane textarea { min-height: 96px; resize: vertical; }
        .stx-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 13px 0; border-top: 1px solid #eef1f4; }
        .stx-row:first-child { border-top: 0; }
        .stx-row small { color: #5b6b7b; display: block; margin-top: 2px; }
        .stx-off { opacity: .55; }
        .stx-int { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 0; border-top: 1px solid #eef1f4; }
        .stx-int:first-child { border-top: 0; }
        @media (max-width: 860px) { .stx-layout { grid-template-columns: 1fr; } .stx-subnav { position: static; display: flex; overflow-x: auto; } .stx-subnav button { width: auto; white-space: nowrap; } }

        /* ===== billing page ===== */
        .bl-hero {
            position: relative; display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: center;
            margin-bottom: 20px; padding: 30px 34px; overflow: hidden; border-radius: 20px; color: #eaf2fb;
            background:
                radial-gradient(520px 320px at 100% 0, rgba(61, 219, 176, .22), transparent 65%),
                radial-gradient(460px 300px at 0 100%, rgba(74, 168, 255, .22), transparent 65%),
                linear-gradient(150deg, #0f2236 0%, #08121f 100%);
            box-shadow: 0 18px 44px rgba(8, 18, 31, .35), inset 0 0 0 1px rgba(255, 255, 255, .06);
        }
        .bl-hero::before {
            content: ""; position: absolute; inset: 0; pointer-events: none;
            background-image: linear-gradient(rgba(143, 166, 191, .07) 1px, transparent 1px), linear-gradient(90deg, rgba(143, 166, 191, .07) 1px, transparent 1px);
            background-size: 44px 44px;
            -webkit-mask-image: radial-gradient(ellipse at 80% 50%, #000 20%, transparent 75%);
            mask-image: radial-gradient(ellipse at 80% 50%, #000 20%, transparent 75%);
        }
        .bl-hero > * { position: relative; }
        .bl-eyebrow {
            display: inline-block; padding: 5px 13px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 1.6px;
            color: #3ddbb0; background: rgba(61, 219, 176, .1); border: 1px solid rgba(61, 219, 176, .35);
        }
        .bl-hero h3 { margin: 14px 0 4px; font-size: 38px; line-height: 1.05; font-weight: 800; letter-spacing: -.5px; color: #fff; }
        .bl-hero p { margin: 0; font-size: 15px; color: #9fb4c9; }
        .bl-ring { position: relative; width: 140px; height: 140px; }
        .bl-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        .bl-ring circle { fill: none; stroke-width: 10; }
        .bl-ring .t { stroke: rgba(143, 166, 191, .2); }
        .bl-ring .v { stroke: #3ddbb0; stroke-linecap: round; stroke-dasharray: 289; stroke-dashoffset: 289; filter: drop-shadow(0 0 6px #3ddbb0); transition: stroke-dashoffset 1.2s cubic-bezier(.22, 1, .36, 1); }
        .bl-ring-text { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .bl-ring-text b { font-size: 34px; line-height: 1; color: #fff; }
        .bl-ring-text small { margin-top: 4px; font-size: 11px; letter-spacing: 1px; color: #8fa6bf; }

        .plans-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin: 4px 0 20px; align-items: stretch; }
        .plan-card {
            position: relative; display: flex; flex-direction: column;
            padding: 28px 26px 26px; border-radius: 20px; background: #fff; color: #17202a;
            border: 1.5px solid #e3e9f0; box-shadow: 0 4px 18px rgba(15, 34, 54, .05);
            transition: transform .2s, box-shadow .2s, border-color .2s;
        }
        .plan-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(15, 34, 54, .12); }
        .plan-card.featured { border-color: #3ddbb0; box-shadow: 0 18px 44px rgba(18, 144, 110, .18); }
        .plan-card.current { border-color: #12906e; }
        .plan-ribbon {
            position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
            padding: 5px 16px; border-radius: 999px; white-space: nowrap;
            background: linear-gradient(135deg, #3ddbb0, #2f7de1); color: #07111d; font-size: 11px; font-weight: 800; letter-spacing: 1px;
            box-shadow: 0 6px 14px rgba(47, 125, 225, .35);
        }
        .plan-tag { align-self: flex-start; margin-bottom: 10px; padding: 3px 11px; border-radius: 999px; background: #e6f7f1; color: #0b6b52; font-size: 11px; font-weight: 800; letter-spacing: .8px; }
        .plan-card h4 { margin: 0 0 4px; font-size: 20px; color: #17202a; }
        .plan-sub { margin: 0 0 14px; font-size: 13px; color: #68737d; }
        .plan-price { font-size: 40px; font-weight: 800; line-height: 1.05; color: #17202a; letter-spacing: -1px; }
        .plan-price small { font-size: 14px; font-weight: 700; color: #68737d; letter-spacing: 0; margin-right: 4px; }
        .plan-days { margin: 4px 0 18px; font-size: 13px; color: #68737d; }
        .plan-features { list-style: none; margin: 0 0 22px; padding: 18px 0 0; border-top: 1px solid #e3e9f0; display: grid; gap: 11px; flex: 1; }
        .plan-features li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: #33414e; }
        .plan-features svg { width: 18px; height: 18px; flex: none; margin-top: 1px; fill: none; stroke: #12906e; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
        .pp-slot { min-height: 46px; }
        .pp-fake {
            width: 100%; padding: 13px; border: 0; border-radius: 10px;
            background: #ffc439; color: #1a1a1a; font-family: inherit; font-size: 15px; font-weight: 800;
            opacity: .45; cursor: not-allowed;
        }
        .pp-fake b { color: #003087; font-style: italic; }
        .pp-note { margin: 8px 0 0; font-size: 12px; text-align: center; color: #8a949e; }
        .free-btn { width: 100%; padding: 13px; border: 1.5px solid #d5dce3; border-radius: 10px; background: #f5f8fb; color: #68737d; font-family: inherit; font-size: 14px; font-weight: 700; cursor: default; }

        .bl-trust { display: flex; flex-wrap: wrap; gap: 14px 28px; justify-content: center; margin: 6px 0 4px; padding: 18px 20px; border-radius: 16px; background: #fff; border: 1px solid #e3e9f0; }
        .bl-trust span { display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 600; color: #4a5560; }
        .bl-trust svg { width: 20px; height: 20px; fill: none; stroke: #12906e; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

        .bill-notice { padding: 14px 18px; border-radius: 12px; margin: 0 0 18px; font-size: 14px; font-weight: 600; }
        .bill-notice.ok { background: #e6f7f1; color: #0b6b52; }
        .bill-notice.err { background: #fde8e8; color: #b42318; }
        .bill-notice.info { background: #eef3f9; color: #1d3550; }
        .bill-notice code { padding: 2px 6px; border-radius: 5px; background: rgba(0, 0, 0, .07); font-size: 12px; }

        @media (max-width: 760px) {
            .bl-hero { grid-template-columns: 1fr; padding: 24px; }
            .bl-hero h3 { font-size: 30px; }
            .user-chip #logged-user { display: none; }
            .user-chip { padding-right: 5px; }
        }

        /* ===== moon / sun button ===== */
        .theme-toggle {
            width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
            border: 1px solid #e3e9f0; background: #f4f7fb; color: #1d3550; cursor: pointer;
            transition: transform .15s, background .15s;
        }
        .theme-toggle:hover { transform: translateY(-1px); }
        .theme-toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        /* ===== dark mode ===== */
        html[data-theme="dark"] {
            color-scheme: dark;
            --ink: #e5e7eb; --line: #243049; --bg: #0b1220; --text: #e5e7eb; --mute: #9fb0c3;
        }
        html[data-theme="dark"] .topbar, html[data-theme="dark"] .panel, html[data-theme="dark"] .stat-card,
        html[data-theme="dark"] .severity-card, html[data-theme="dark"] .device-card, html[data-theme="dark"] .ov-card,
        html[data-theme="dark"] .tg-card, html[data-theme="dark"] .plan-card, html[data-theme="dark"] .bl-trust,
        html[data-theme="dark"] .am-box, html[data-theme="dark"] .stx-tile, html[data-theme="dark"] .stx-subnav {
            background: #111a2e; border-color: #243049;
        }
        html[data-theme="dark"] .device-details { background: #162038; }
        html[data-theme="dark"] .plan-card, html[data-theme="dark"] .plan-card h4, html[data-theme="dark"] .plan-price,
        html[data-theme="dark"] .stx-tile, html[data-theme="dark"] .stx-tile b { color: #f3f4f6; }
        html[data-theme="dark"] .plan-sub, html[data-theme="dark"] .plan-days, html[data-theme="dark"] .plan-price small,
        html[data-theme="dark"] .plan-features li, html[data-theme="dark"] .bl-trust span,
        html[data-theme="dark"] .stx-note, html[data-theme="dark"] .stx-tile span.t,
        html[data-theme="dark"] .rl-skills, html[data-theme="dark"] .am-foot { color: #9fb0c3; }
        html[data-theme="dark"] .btn-small { background: #111a2e; color: #e5e7eb; border-color: #334155; }
        html[data-theme="dark"] .btn-small:hover { background: #1b2740; border-color: #5b6b82; }
        html[data-theme="dark"] .btn-danger { color: #ff8a93; border-color: #7a2a33; }
        html[data-theme="dark"] .btn-danger:hover { background: #3a1a1f; }
        html[data-theme="dark"] input, html[data-theme="dark"] select, html[data-theme="dark"] textarea {
            background: #0f172a; color: #e5e7eb; border-color: #334155;
        }
        html[data-theme="dark"] .events-table tbody tr:hover { background: #1b2740; }
        html[data-theme="dark"] #threats .events-table tbody tr { background: #162038; }
        html[data-theme="dark"] #threats .events-table tbody tr:hover { background: #1b2740; }
        html[data-theme="dark"] #threats .form-row { background: #0f172a; border-color: #334155; }
        html[data-theme="dark"] .distribution-bar, html[data-theme="dark"] .ov-scale i,
        html[data-theme="dark"] .demo-tag { background: #243049; }
        html[data-theme="dark"] .tg-gauge .trk { stroke: #243049; }
        html[data-theme="dark"] .live-indicator, html[data-theme="dark"] .badge.safe,
        html[data-theme="dark"] .plan-tag { background: #12332c; color: #3ddbb0; }
        html[data-theme="dark"] .badge.warning { background: #3a2f10; color: #f5c451; }
        html[data-theme="dark"] .badge.danger { background: #3a1a1f; color: #ff8a93; }
        html[data-theme="dark"] .user-chip { background: #111a2e; border-color: #243049; color: #e5e7eb; }
        html[data-theme="dark"] .plan-badge { background: #1b2740; color: #cbd5e1; }
        html[data-theme="dark"] .plan-badge.paid { background: #12332c; color: #3ddbb0; }
        html[data-theme="dark"] .logout-button { background: transparent; border-color: #7a2a33; color: #ff8a93; }
        html[data-theme="dark"] .theme-toggle { background: #1b2740; border-color: #334155; color: #ffd36b; }
        html[data-theme="dark"] .am-msg.bot { background: #1b2740; color: #e5e7eb; }
        html[data-theme="dark"] .am-msg.err { background: #3a1a1f; color: #ff9aa2; }
        html[data-theme="dark"] .am-hints button { background: #111a2e; color: #e5e7eb; border-color: #334155; }
        html[data-theme="dark"] .am-form, html[data-theme="dark"] .stx-row, html[data-theme="dark"] .stx-int,
        html[data-theme="dark"] .plan-features { border-color: #243049; }
        html[data-theme="dark"] .stx-subnav button { color: #cbd5e1; }
        html[data-theme="dark"] .stx-subnav button:hover { background: #1b2740; }
        html[data-theme="dark"] .stx-subnav button.on { background: #12332c; color: #3ddbb0; }
        html[data-theme="dark"] .bill-notice.info { background: #1b2740; color: #cbd5e1; }
        html[data-theme="dark"] .bill-notice.ok { background: #12332c; color: #3ddbb0; }
        html[data-theme="dark"] .bill-notice.err { background: #3a1a1f; color: #ff9aa2; }
        html[data-theme="dark"] .free-btn { background: #1b2740; border-color: #334155; color: #9fb0c3; }

        /* colours injected by app.js */
        html[data-theme="dark"] .sev-high, html[data-theme="dark"] .sev-critical { color: #ff8a93; background: rgba(255,107,107,.18); }
        html[data-theme="dark"] .sev-medium { color: #ffc46b; background: rgba(255,180,84,.18); }
        html[data-theme="dark"] .sev-low { color: #3ddbb0; background: rgba(61,219,176,.16); }
        html[data-theme="dark"] .st-new { color: #7db4ff; background: rgba(47,125,225,.2); }
        html[data-theme="dark"] .st-investigating, html[data-theme="dark"] .st-monitoring,
        html[data-theme="dark"] .st-open { color: #ffc46b; background: rgba(255,180,84,.18); }
        html[data-theme="dark"] .st-blocked { color: #ff8a93; background: rgba(255,107,107,.18); }
        html[data-theme="dark"] .st-resolved { color: #3ddbb0; background: rgba(61,219,176,.16); }
        html[data-theme="dark"] .st-false-positive { color: #aab6c5; background: #243049; }
        html[data-theme="dark"] .primary-button {
            background: linear-gradient(135deg, #2f7de1, #1c5fd1);
            box-shadow: 0 6px 16px rgba(47,125,225,.3);
        }
        html[data-theme="dark"] #ov-svg circle:first-child,
        html[data-theme="dark"] #tg-svg circle:first-child { stroke: #243049; }
    </style>
    <style id="mt-polish">
        /* ===== MellowTech polish: header, search, sign out, dashboard ===== */
        body { background: radial-gradient(900px 500px at 8% -5%, rgba(47,125,225,.10), transparent 60%), radial-gradient(800px 500px at 100% 0, rgba(61,219,176,.10), transparent 55%), var(--bg); background-attachment: fixed; }
        html[data-theme="dark"] body { background: radial-gradient(900px 500px at 8% -5%, rgba(47,125,225,.14), transparent 60%), radial-gradient(800px 500px at 100% 0, rgba(61,219,176,.08), transparent 55%), #0b1220; }

        .topbar { position: sticky; top: 12px; z-index: 60; display: grid; grid-template-columns: auto minmax(220px, 1fr) auto; gap: 22px; align-items: center;
            padding: 14px 20px 14px 24px; background: rgba(255,255,255,.84); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4);
            border: 1px solid rgba(227,233,240,.9); border-radius: 18px; box-shadow: 0 10px 30px rgba(15,34,54,.08); }
        html[data-theme="dark"] .topbar { background: rgba(17,26,46,.86); border-color: #243049; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
        .topbar h1 { font-size: 24px; font-weight: 800; letter-spacing: .2px; background: linear-gradient(90deg, #0d1b2a, #2f7de1 70%, #3ddbb0); -webkit-background-clip: text; background-clip: text; color: transparent; }
        html[data-theme="dark"] .topbar h1 { background: linear-gradient(90deg, #fff, #7db4ff 70%, #3ddbb0); -webkit-background-clip: text; background-clip: text; }

        /* search */
        .mt-search { position: relative; width: 100%; max-width: 480px; justify-self: center; }
        .mt-search > .icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #7b8794; pointer-events: none; }
        .mt-search input { width: 100%; padding: 11px 46px 11px 42px; border-radius: 999px; border: 1.5px solid #e1e8f0; background: #f4f7fb; font-size: 14px; font-family: inherit; color: inherit; transition: border-color .15s, box-shadow .15s, background .15s; }
        .mt-search input:focus { outline: none; background: #fff; border-color: #3ddbb0; box-shadow: 0 0 0 4px rgba(61,219,176,.22); }
        .mt-search kbd { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font: 700 11px "Segoe UI", sans-serif; padding: 2px 8px; border-radius: 6px; border: 1px solid #d5dce3; color: #68737d; background: #fff; pointer-events: none; }
        .mt-search-results { position: absolute; left: 0; right: 0; top: calc(100% + 10px); z-index: 80; padding: 8px; max-height: 62vh; overflow: auto; background: #fff; border: 1px solid #e3e9f0; border-radius: 16px; box-shadow: 0 24px 50px rgba(15,34,54,.2); }
        .sr-group { padding: 8px 10px 4px; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #7b8794; text-transform: uppercase; }
        .sr-item { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; width: 100%; padding: 9px 12px; border: 0; border-radius: 10px; background: transparent; text-align: left; cursor: pointer; font-family: inherit; color: #17202a; }
        .sr-item b { font-size: 14px; }
        .sr-item small { font-size: 12px; color: #68737d; }
        .sr-item:hover, .sr-item.on { background: #e6f7f1; }
        .sr-empty { padding: 14px; font-size: 14px; color: #68737d; }
        html[data-theme="dark"] .mt-search input { background: #0f172a; border-color: #334155; }
        html[data-theme="dark"] .mt-search input:focus { background: #111a2e; }
        html[data-theme="dark"] .mt-search kbd { background: #111a2e; border-color: #334155; color: #9fb0c3; }
        html[data-theme="dark"] .mt-search-results { background: #111a2e; border-color: #243049; }
        html[data-theme="dark"] .sr-item { color: #e5e7eb; }
        html[data-theme="dark"] .sr-item small, html[data-theme="dark"] .sr-empty { color: #9fb0c3; }
        html[data-theme="dark"] .sr-item:hover, html[data-theme="dark"] .sr-item.on { background: #12332c; }

        /* sign out */
        .logout-button { padding: 5px 18px 5px 5px; gap: 10px; border: 0; border-radius: 999px; background: linear-gradient(135deg, #17304b, #0b1727); color: #fff; box-shadow: 0 6px 16px rgba(11,23,39,.28); }
        .logout-button .lo-ico { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #ff6b78, #c62f3b); transition: transform .25s, background .25s; }
        .logout-button .lo-ico .icon { width: 16px; height: 16px; stroke: #fff; }
        .logout-button:hover { background: linear-gradient(135deg, #c62f3b, #8b2635); color: #fff; transform: translateY(-1px); box-shadow: 0 10px 22px rgba(139,38,53,.4); }
        .logout-button:hover .lo-ico { transform: translateX(3px); background: rgba(255,255,255,.22); }
        html[data-theme="dark"] .logout-button { background: linear-gradient(135deg, #1b2740, #111a2e); border: 1px solid #2b3a57; color: #fff; }
        html[data-theme="dark"] .logout-button:hover { background: linear-gradient(135deg, #c62f3b, #8b2635); border-color: transparent; }

        /* dashboard hero */
        .dh-hero { position: relative; display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; align-items: center; margin-bottom: 22px; padding: 32px 36px; overflow: hidden; border-radius: 22px; color: #eaf2fb;
            background: radial-gradient(520px 320px at 100% 0, rgba(61,219,176,.24), transparent 65%), radial-gradient(460px 300px at 0 100%, rgba(74,168,255,.26), transparent 65%), linear-gradient(150deg, #0f2236 0%, #08121f 100%);
            box-shadow: 0 18px 44px rgba(8,18,31,.35), inset 0 0 0 1px rgba(255,255,255,.06); }
        .dh-hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(143,166,191,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(143,166,191,.07) 1px, transparent 1px); background-size: 44px 44px; -webkit-mask-image: radial-gradient(ellipse at 75% 50%, #000 15%, transparent 75%); mask-image: radial-gradient(ellipse at 75% 50%, #000 15%, transparent 75%); }
        .dh-hero > * { position: relative; }
        .dh-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 5px 13px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #3ddbb0; background: rgba(61,219,176,.1); border: 1px solid rgba(61,219,176,.35); }
        .dh-eyebrow i { width: 7px; height: 7px; border-radius: 50%; background: #3ddbb0; animation: dhPulse 2s infinite; }
        @keyframes dhPulse { 0% { box-shadow: 0 0 0 0 rgba(61,219,176,.6); } 70% { box-shadow: 0 0 0 8px rgba(61,219,176,0); } 100% { box-shadow: 0 0 0 0 rgba(61,219,176,0); } }
        .dh-hero h2 { margin: 14px 0 6px; font-size: 36px; line-height: 1.05; font-weight: 800; letter-spacing: -.5px; color: #fff; }
        .dh-hero p { margin: 0 0 20px; max-width: 48ch; font-size: 15px; color: #9fb4c9; }
        .dh-actions { display: flex; flex-wrap: wrap; gap: 10px; }
        .dh-btn { padding: 11px 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.08); color: #fff; font-family: inherit; font-size: 14px; font-weight: 700; cursor: pointer; transition: transform .15s, background .15s, box-shadow .15s; }
        .dh-btn:hover { background: rgba(255,255,255,.16); transform: translateY(-1px); }
        .dh-btn.primary { border: 0; color: #07111d; background: linear-gradient(135deg, #3ddbb0, #2f7de1); box-shadow: 0 8px 20px rgba(47,125,225,.4); }
        .dh-btn.primary:hover { background: linear-gradient(135deg, #5be6c2, #4a93f0); }
        .dh-meta { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 18px; font-size: 13px; color: #8fa6bf; }
        .dh-meta span:last-child { font-variant-numeric: tabular-nums; color: #cfe0f0; font-weight: 600; }
        .dh-shield { position: relative; display: grid; place-items: center; width: 100%; max-width: 250px; aspect-ratio: 1; margin: 0 auto; }
        .dh-shield > svg { position: relative; width: 92px; height: 92px; fill: rgba(61,219,176,.12); stroke: #3ddbb0; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 14px rgba(61,219,176,.7)); }
        .dh-ring { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(61,219,176,.35); animation: dhRing 4.5s ease-out infinite; }
        .dh-ring.r2 { animation-delay: 1.5s; }
        .dh-ring.r3 { animation-delay: 3s; }
        @keyframes dhRing { from { transform: scale(.45); opacity: .9; } to { transform: scale(1); opacity: 0; } }
        .dh-level { position: absolute; bottom: 6px; left: 0; right: 0; text-align: center; }
        .dh-level small { display: block; font-size: 10px; letter-spacing: 1.6px; color: #7f96ad; }
        .dh-level b { font-size: 22px; font-weight: 800; color: #3ddbb0; }

        /* stat cards */
        #dashboard .stat-card { padding: 22px 24px; border-radius: 18px; background: linear-gradient(180deg, #fff, #f6f9fc); }
        #dashboard .stat-card strong { font-size: 38px; letter-spacing: -1px; }
        #dashboard .stat-card .dh-ico { position: absolute; right: 18px; top: 18px; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: rgba(47,125,225,.12); color: #2f7de1; }
        #dashboard .stat-card:nth-child(2) .dh-ico { background: rgba(139,92,246,.13); color: #8b5cf6; }
        #dashboard .stat-card:nth-child(3) .dh-ico { background: rgba(198,47,59,.12); color: #c62f3b; }
        #dashboard .stat-card:nth-child(4) .dh-ico { background: rgba(18,144,110,.13); color: #12906e; }
        #dashboard .stat-card .dh-ico svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        html[data-theme="dark"] #dashboard .stat-card { background: linear-gradient(180deg, #131d33, #0f1829); }

        /* cards and panels */
        #dashboard .ov-card, #dashboard .panel { border-radius: 18px; transition: transform .2s, box-shadow .2s; }
        #dashboard .ov-card:hover, #dashboard .panel:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(15,34,54,.11); }
        #dashboard .panel h3 { position: relative; padding-left: 14px; }
        #dashboard .panel h3::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 4px; border-radius: 4px; background: linear-gradient(180deg, #3ddbb0, #2f7de1); }
        #activity-feed .activity-item { position: relative; padding-left: 26px; }
        #activity-feed .activity-item::before { content: ""; position: absolute; left: 4px; top: 20px; width: 10px; height: 10px; border-radius: 50%; background: #fff; border: 2px solid #3ddbb0; }
        html[data-theme="dark"] #activity-feed .activity-item::before { background: #111a2e; }

        /* entrance */
        @keyframes dhRise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
        #dashboard > * { animation: dhRise .6s cubic-bezier(.22,1,.36,1) both; }
        #dashboard > *:nth-child(2) { animation-delay: .06s; }
        #dashboard > *:nth-child(3) { animation-delay: .12s; }
        #dashboard > *:nth-child(4) { animation-delay: .18s; }
        #dashboard > *:nth-child(5) { animation-delay: .24s; }

        @media (max-width: 1100px) {
            .topbar { grid-template-columns: 1fr auto; }
            .mt-search { grid-column: 1 / -1; order: 3; max-width: none; }
            .dh-hero { grid-template-columns: 1fr; }
            .dh-shield { max-width: 190px; }
        }
        @media (max-width: 760px) { .dh-hero { padding: 24px; } .dh-hero h2 { font-size: 28px; } .logout-button span:last-child { display: none; } .logout-button { padding-right: 5px; } }
    </style>
<style id="mt-packages">
.nav-button { position: relative; }
.nav-lock { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 8px 3px 6px; border-radius: 999px; font-size: 10px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
  color: #3b2a00; background: linear-gradient(135deg, #ffe9a8, #f4c24d); box-shadow: 0 2px 8px rgba(244,194,77,.35); pointer-events: none; }
.nav-lock svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
.nav-lock.open { background: rgba(61,219,176,.16); color: #3ddbb0; box-shadow: none; }
.svc-lockbox { text-align: center; max-width: 560px; margin: 10px auto; padding: 34px 28px; }
.svc-lockicon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, rgba(61,219,176,.22), rgba(31,110,200,.16)); }
.svc-lockicon svg { width: 30px; height: 30px; fill: none; stroke: #12906e; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.svc-lockhead, .plan-svc-head { margin: 18px 0 6px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .65; }
.svc-locklist { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
.svc-locklist li { padding: 8px 12px; border-radius: 10px; background: rgba(120,140,160,.12); font-weight: 600; }
.plan-svc { margin-top: 14px; padding-top: 12px; border-top: 1px dashed rgba(120,140,160,.35); text-align: left; }
.plan-svc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 14px; }
.plan-svc li { display: flex; gap: 8px; align-items: flex-start; }
.plan-svc-all { font-weight: 700; }
</style>
<style id="mt-locks2">
.nav-lock { padding: 5px; gap: 0; right: 14px; }
.nav-lock > span { display: none; }
.nav-lock svg { width: 13px; height: 13px; }
.pkg-pill { display: inline-block; vertical-align: middle; margin-left: 12px; padding: 4px 12px; border-radius: 999px; font: 800 11px/1 inherit; letter-spacing: .06em; text-transform: uppercase;
  color: #3b2a00; background: linear-gradient(135deg, #ffe9a8, #f4c24d); }
.pg-locked > *:not(h2):not(.pg-lockcard) { display: none !important; }
.pg-lockcard { text-align: center; max-width: 560px; margin: 24px auto; padding: 34px 28px; }
</style>
</head>

<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Icon sprite -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="i-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 11a3 3 0 100-6M21 20c0-2.6-1.7-4.8-4-5.6"/></symbol>
        <symbol id="i-laptop" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/></symbol>
        <symbol id="i-network" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v5M12 12l-6 5M12 12l6 5"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></symbol>
        <symbol id="i-bars" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M2 20h20"/></symbol>
        <symbol id="i-list" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></symbol>
        <symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V5l8-2v18M12 9h8v12M8 9h.01M8 13h.01M8 17h.01M16 13h.01M16 17h.01"/></symbol>
        <symbol id="i-card" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></symbol>
        <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18h.01"/></symbol>
        <symbol id="i-flame" viewBox="0 0 24 24"><path d="M12 3c1 4 5 6 5 11a5 5 0 01-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-4-1-6 1-10z"/></symbol>
        <symbol id="i-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 4H5a2 2 0 00-2 2v12a2 2 0 002 2h4M16 8l4 4-4 4M20 12H9"/></symbol>
        <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></symbol>
        <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 12a8 8 0 11-2.3-5.7M20 4v5h-5"/></symbol>
    </svg>

    <!-- ========== SIDEBAR ========== -->
    <aside class="sidebar">
        <div class="brand">
            <div class="logo">MELLOWTECH</div>
            <div class="logo-subtitle">CYBERSECURITY PLATFORM</div>
        </div>

        <nav aria-label="Main navigation">
            <button type="button" class="nav-button active" data-page="dashboard" aria-current="page">
                <svg class="icon" aria-hidden="true"><use href="#i-dashboard"/></svg>Dashboard
            </button>
            <button type="button" class="nav-button" data-page="devices">
                <svg class="icon" aria-hidden="true"><use href="#i-laptop"/></svg>Devices
            </button>
            <button type="button" class="nav-button" data-page="network">
                <svg class="icon" aria-hidden="true"><use href="#i-network"/></svg>Network Monitoring
            </button>
            <button type="button" class="nav-button" data-page="threats">
                <svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg>Threat Detection
            </button>
            <button type="button" class="nav-button" data-page="severity">
                <svg class="icon" aria-hidden="true"><use href="#i-bars"/></svg>Threat Severity
            </button>
            <button type="button" class="nav-button" data-page="events">
                <svg class="icon" aria-hidden="true"><use href="#i-list"/></svg>Security Events
            </button>
            <button type="button" class="nav-button" data-page="scanner">
                <svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg>Vulnerability Scanner
            </button>
            <button type="button" class="nav-button" data-page="billing">
                <svg class="icon" aria-hidden="true"><use href="#i-card"/></svg>Billing &amp; Plans
            </button>
            <button type="button" class="nav-button" data-page="docscan">
                <svg class="icon" aria-hidden="true"><use href="#i-list"/></svg>Document Scanner
            </button>
            <button type="button" class="nav-button" data-page="svc-ai_security">
                <svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>AI Security
            </button>
            <button type="button" class="nav-button" data-page="svc-incident_response">
                <svg class="icon" aria-hidden="true"><use href="#i-alert"/></svg>Incident Response
            </button>
            <button type="button" class="nav-button" data-page="svc-cloud_security">
                <svg class="icon" aria-hidden="true"><use href="#i-network"/></svg>Cloud Security
            </button>
            <button type="button" class="nav-button" data-page="svc-soc_monitoring">
                <svg class="icon" aria-hidden="true"><use href="#i-bars"/></svg>Security Monitoring
            </button>
            <button type="button" class="nav-button" data-page="svc-grc_compliance">
                <svg class="icon" aria-hidden="true"><use href="#i-building"/></svg>Compliance and Risk
            </button>
            <button type="button" class="nav-button" data-page="svc-requests" data-platform-admin hidden>
                <svg class="icon" aria-hidden="true"><use href="#i-users"/></svg>Service requests
            </button>
            <button type="button" class="nav-button" data-page="autopilot">
                <svg class="icon" aria-hidden="true"><use href="#i-refresh"/></svg>Autopilot
            </button>
            <button type="button" class="nav-button" data-page="assistant">
                <svg class="icon" aria-hidden="true"><use href="#i-shield"/></svg>Ask Mellow
            </button>
            <button type="button" class="nav-button" data-page="settings">
                <svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>Settings
            </button>
            <button type="button" class="nav-button" data-page="company">
                <svg class="icon" aria-hidden="true"><use href="#i-building"/></svg>Company
            </button>
            <button type="button" class="nav-button" data-page="requests" data-platform-admin hidden>
                <svg class="icon" aria-hidden="true"><use href="#i-users"/></svg>Account requests
                <span id="request-badge" class="nav-badge" hidden>0</span>
            </button>
        </nav>

        <div class="sidebar-bottom">
            <p>MellowTech Security</p>
            <span class="online" id="sidebar-status" role="status">● CONNECTING</span>
            <p id="app-version" style="margin-top:10px"></p>
        </div>
    </aside>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="main-content" id="main">

        <header class="topbar">
            <div>
                <h1>MellowTech</h1>
                <p>Intelligent cybersecurity monitoring platform</p>
            </div>
            <div class="mt-search" id="mt-search" role="search">
                <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
                <input type="search" id="mt-search-input" placeholder="Search pages, alerts, devices..." autocomplete="off" aria-label="Search the platform">
                <kbd title="Press / to search">/</kbd>
                <div class="mt-search-results" id="mt-search-results" hidden></div>
            </div>
            <div class="user-area">
                <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch light or dark mode" title="Light / dark mode"></button>
                <span class="plan-badge" id="plan-badge" title="Open Billing &amp; Plans">Plan: ...</span>
                <div class="user-chip">
                    <span class="avatar" id="avatar">M</span>
                    <span id="logged-user">Admin</span>
                </div>
                <button type="button" class="logout-button" onclick="logout()">
                    <span class="lo-ico"><svg class="icon" aria-hidden="true"><use href="#i-logout"/></svg></span><span>Sign out</span>
                </button>
            </div>
        </header>

        <!-- ========== DASHBOARD ========== -->
        <section id="dashboard" class="page active-page">
            <div class="dh-hero">
                <div class="dh-left">
                    <span class="dh-eyebrow"><i></i><span id="dh-greet">Welcome back</span></span>
                    <h2>Security Dashboard</h2>
                    <p>Monitor your cybersecurity environment from one central dashboard.</p>
                    <div class="dh-actions">
                        <button type="button" class="dh-btn primary" onclick="runScan()">Run security scan</button>
                        <button type="button" class="dh-btn" data-goto="threats">View alerts</button>
                        <button type="button" class="dh-btn" data-goto="devices">My devices</button>
                    </div>
                    <div class="dh-meta"><span id="dh-date"></span><span id="dh-time"></span></div>
                </div>
                <div class="dh-shield" aria-hidden="true">
                    <div class="dh-ring r1"></div><div class="dh-ring r2"></div><div class="dh-ring r3"></div>
                    <svg viewBox="0 0 24 24"><path d="M12 2l9 3v7c0 5.5-3.8 8.6-9 10-5.2-1.4-9-4.5-9-10V5z"/><path d="M8 12l3 3 5-6"/></svg>
                    <div class="dh-level"><small>THREAT LEVEL</small><b id="dh-level">Secure</b></div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <span>PROTECTED DEVICES</span>
                    <strong id="device-count">0</strong>
                </div>
                <div class="stat-card">
                    <span>SECURITY EVENTS</span>
                    <strong id="event-count">0</strong>
                </div>
                <div class="stat-card">
                    <span>HIGH THREATS</span>
                    <strong id="high-threat-count">0</strong>
                </div>
                <div class="stat-card">
                    <span>SYSTEM STATUS</span>
                    <strong id="system-status" class="success-text" role="status">CONNECTING</strong>
                </div>
            </div>

            <!-- the threat level, donut and 7-day chart are inserted here by the script at the bottom -->

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h3>Local System Information</h3>
                        <p>Live telemetry collected from this computer.</p>
                    </div>
                    <span class="live-indicator">LIVE</span>
                </div>
                <div class="status-item"><span>Hostname</span><strong id="system-hostname">Loading...</strong></div>
                <div class="status-item"><span>Operating System</span><strong id="system-os">Loading...</strong></div>
                <div class="status-item"><span>Processor</span><strong id="system-processor">Loading...</strong></div>
                <div class="status-item"><span>Total Memory</span><strong id="system-memory-total">Loading...</strong></div>
                <div class="status-item"><span>Total Disk</span><strong id="system-disk-total">Loading...</strong></div>
                <div class="status-item"><span>Last Update</span><strong id="system-last-update">Loading...</strong></div>
            </div>

            <div class="dashboard-grid">
                <div class="panel">
                    <h3>Security Status</h3>
                    <div class="status-item"><span>Network</span><span class="badge safe">Protected</span></div>
                    <div class="status-item"><span>Threat Detection</span><span class="badge safe">Active</span></div>
                    <div class="status-item"><span>Monitoring</span><span class="badge safe">Running</span></div>
                </div>

                <div class="panel">
                    <h3>Security Scan</h3>
                    <p>Refresh live system telemetry and security events. Full vulnerability scanning is available on the Vulnerability Scanner page.</p>
                    <button type="button" class="primary-button" onclick="runScan()">Run Security Scan</button>
                    <div id="scan-result" class="result-message" role="status" aria-live="polite"></div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h3>Live Security Activity</h3>
                        <p>Recent simulated security activity.</p>
                    </div>
                    <span class="live-indicator">LIVE</span>
                </div>
                <div id="activity-feed" class="activity-feed">
                    <div class="activity-item">
                        <div><strong>Network monitoring active</strong><p>MellowTech monitoring service is running.</p></div>
                        <span>Just now</span>
                    </div>
                    <div class="activity-item">
                        <div><strong>Security event reviewed</strong><p>Event EVT-002 is being monitored.</p></div>
                        <span>1 min ago</span>
                    </div>
                    <div class="activity-item">
                        <div><strong>Device connected</strong><p>A monitored device was detected.</p></div>
                        <span>3 min ago</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== DEVICES ========== -->
        <section id="devices" class="page" hidden>
            <h2>Devices</h2>
            <p class="page-description">Laptops and computers connected to MellowTech. Each one reports its health and security signals every few seconds.</p>
            <div class="actions" data-admin-only>
                <button type="button" class="primary-button" data-action="connect-laptop">Connect a laptop</button>
            </div>
            <div id="enroll-box" class="panel" hidden></div>
            <div id="devices-grid" class="mt-net"></div>
        </section>

        <!-- ========== NETWORK MONITORING ========== -->
        <section id="network" class="page" hidden>
            <h2>Network Monitoring</h2>
            <p class="page-description">Monitor local network interfaces and network telemetry.</p>

            <div id="network-details" class="panel">
                <div class="panel-header">
                    <div>
                        <h3>Local Network Interfaces</h3>
                        <p>Live network telemetry from the local computer.</p>
                    </div>
                    <span class="live-indicator">LIVE</span>
                </div>
                <p>Connecting to the MellowTech backend...</p>
            </div>

            <div class="stats-grid">
                <div class="stat-card"><span>MONITORING</span><strong class="success-text">ACTIVE</strong></div>
                <div class="stat-card"><span>NETWORK STATUS</span><strong class="success-text">NORMAL</strong></div>
                <div class="stat-card"><span>DATA SOURCE</span><strong>LOCAL</strong></div>
                <div class="stat-card"><span>BACKEND</span><strong id="backend-status" class="success-text" role="status">CONNECTING</strong></div>
            </div>

            <div class="panel">
                <h3>Network Traffic <span class="demo-tag">Demo data</span></h3>
                <p>Demonstration network traffic activity.</p>
                <div class="traffic-chart" role="img" aria-label="Demonstration bar chart of network traffic over eight periods">
                    <div class="bar" style="height:40%;"></div>
                    <div class="bar" style="height:65%;"></div>
                    <div class="bar" style="height:50%;"></div>
                    <div class="bar" style="height:80%;"></div>
                    <div class="bar" style="height:60%;"></div>
                    <div class="bar" style="height:90%;"></div>
                    <div class="bar" style="height:70%;"></div>
                    <div class="bar" style="height:55%;"></div>
                </div>
            </div>

            <div class="panel">
                <h3>Monitored Devices <span class="demo-tag">Demo data</span></h3>
                <p>Select a demonstration device to view its monitoring information.</p>
                <div class="device-grid">
                    <button type="button" class="device-card" aria-controls="device-details" onclick="showDevice('Admin-PC')">
                        <strong>Admin-PC</strong><span>Windows</span><small>Online</small>
                    </button>
                    <button type="button" class="device-card" aria-controls="device-details" onclick="showDevice('Server-01')">
                        <strong>Server-01</strong><span>Linux Server</span><small>Online</small>
                    </button>
                    <button type="button" class="device-card" aria-controls="device-details" onclick="showDevice('Router-01')">
                        <strong>Router-01</strong><span>Network Router</span><small>Online</small>
                    </button>
                    <button type="button" class="device-card" aria-controls="device-details" onclick="showDevice('Workstation-04')">
                        <strong>Workstation-04</strong><span>Windows</span><small>Monitoring</small>
                    </button>
                </div>
                <div id="device-details" class="device-details" role="status" aria-live="polite">Select a device to view details.</div>
            </div>

            <button type="button" class="primary-button" onclick="networkScan()">Refresh Network Telemetry</button>
            <div id="network-result" class="result-message" role="status" aria-live="polite"></div>
        </section>

        <!-- ========== THREAT DETECTION ========== -->
        <section id="threats" class="page" hidden>
            <h2>Threat Detection</h2>
            <p class="page-description">Alerts from your connected laptops. Review them, and block an attacking address with one click.</p>

            <!-- command-centre banner -->
            <div class="tg-hero">
                <div>
                    <span class="tg-eyebrow"><i></i>LIVE THREAT MONITORING</span>
                    <h3 class="tg-title" id="tg-level">Secure</h3>
                    <p class="tg-note" id="tg-note">No open alerts. All quiet.</p>
                    <div class="tg-scale" id="tg-scale"><i></i><i></i><i></i><i></i></div>
                    <div class="tg-scale-names"><span>SECURE</span><span>ELEVATED</span><span>HIGH</span><span>CRITICAL</span></div>
                    <div class="tg-meta">
                        <div><b id="tg-m-open">0</b>open alerts</div>
                        <div><b id="tg-m-blocks">0</b>active blocks</div>
                        <div><b id="tg-m-time">--:--:--</b>last refresh</div>
                    </div>
                </div>
                <div class="tg-radar-box">
                    <div class="tg-radar" id="tg-radar" aria-hidden="true">
                        <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="96"/><circle cx="100" cy="100" r="68"/><circle cx="100" cy="100" r="40"/><path d="M100 4v192M4 100h192"/></svg>
                        <div class="tg-sweep"></div>
                        <div class="tg-centre"></div>
                    </div>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card"><div class="ico"><svg><use href="#i-alert"/></svg></div><span>OPEN ALERTS</span><strong id="threat-open">0</strong></div>
                <div class="stat-card"><div class="ico"><svg><use href="#i-flame"/></svg></div><span>HIGH SEVERITY</span><strong id="threat-high">0</strong></div>
                <div class="stat-card"><div class="ico"><svg><use href="#i-ban"/></svg></div><span>ACTIVE BLOCKS</span><strong id="threat-blocked">0</strong></div>
                <div class="stat-card"><div class="ico"><svg><use href="#i-laptop"/></svg></div><span>CONNECTED LAPTOPS</span><strong id="threat-devices">0</strong></div>
            </div>

            <!-- charts -->
            <div class="tg-grid">
                <div class="tg-card">
                    <h3>Risk score</h3>
                    <div class="tg-gauge">
                        <svg viewBox="0 0 200 112"><path class="trk" d="M12 100 A88 88 0 0 1 188 100"/><path class="val" id="tg-arc" d="M12 100 A88 88 0 0 1 188 100" stroke="#12906e" stroke-dasharray="276.5" stroke-dashoffset="276.5"/></svg>
                        <div class="tg-gauge-num"><b id="tg-score">0</b><small>OUT OF 100</small></div>
                    </div>
                </div>
                <div class="tg-card">
                    <h3>Open alerts by severity</h3>
                    <div class="tg-donut">
                        <svg viewBox="0 0 120 120" id="tg-svg"></svg>
                        <div>
                            <div class="t" id="tg-total">0</div>
                            <div class="tg-legend">
                                <span><i style="background:#c62f3b"></i>High <b id="tg-h">0</b></span>
                                <span><i style="background:#f5a524"></i>Medium <b id="tg-m">0</b></span>
                                <span><i style="background:#12906e"></i>Low <b id="tg-l">0</b></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tg-card">
                    <h3>Alerts, last 7 days</h3>
                    <div class="tg-trend" id="tg-trend"></div>
                </div>
            </div>

            <div id="threat-result" class="result-message" role="status" aria-live="polite"></div>

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h3>Alert queue</h3>
                        <p>Newest first. Signals come from the agent on each laptop.</p>
                    </div>
                    <div class="actions">
                        <select id="alert-filter" aria-label="Filter alerts">
                            <option value="open">Open alerts</option>
                            <option value="all">All alerts</option>
                            <option value="closed">Closed alerts</option>
                        </select>
                        <button type="button" class="btn-small" data-action="test-alert" data-admin-only>Create test alert</button>
                    </div>
                </div>
                <div class="table-scroll">
                    <table class="events-table">
                        <caption class="sr-only">Security alerts</caption>
                        <thead><tr>
                            <th scope="col">Severity</th><th scope="col">Time</th><th scope="col">Device</th>
                            <th scope="col">Source IP</th><th scope="col">Alert</th><th scope="col">Status</th><th scope="col">Actions</th>
                        </tr></thead>
                        <tbody id="alerts-body"><tr><td colspan="7">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h3>Blocked addresses</h3>
                        <p>A block is applied by the firewall on every connected laptop and lifts itself when the time is up.</p>
                    </div>
                </div>
                <div class="table-scroll">
                    <table class="events-table">
                        <caption class="sr-only">Blocked IP addresses</caption>
                        <thead><tr>
                            <th scope="col">Address</th><th scope="col">Reason</th><th scope="col">Added</th>
                            <th scope="col">Lifts at</th><th scope="col">Applied on</th><th scope="col">Status</th><th scope="col">Action</th>
                        </tr></thead>
                        <tbody id="blocks-body"><tr><td colspan="7">Loading...</td></tr></tbody>
                    </table>
                </div>
                <div class="form-row" data-admin-only>
                    <label class="field">IP address <input type="text" id="block-ip" placeholder="e.g. 198.51.100.23" autocomplete="off" spellcheck="false"></label>
                    <label class="field">Reason <input type="text" id="block-reason" placeholder="Optional" maxlength="200"></label>
                    <label class="field">Block for
                        <select id="block-hours">
                            <option value="1">1 hour</option><option value="24" selected>24 hours</option>
                            <option value="168">7 days</option><option value="720">30 days</option>
                        </select>
                    </label>
                    <button type="button" class="btn-small btn-danger" data-action="block-form">Block address</button>
                </div>
            </div>
        </section>

        <!-- ========== THREAT SEVERITY ========== -->
        <section id="severity" class="page" hidden>
            <h2>Threat Severity</h2>
            <p class="page-description">Overview of security events by severity level.</p>

            <div class="severity-grid">
                <div class="severity-card high">
                    <span>HIGH</span><strong id="severity-high">0</strong><p>Requires attention</p>
                </div>
                <div class="severity-card medium">
                    <span>MEDIUM</span><strong id="severity-medium">0</strong><p>Under monitoring</p>
                </div>
                <div class="severity-card low">
                    <span>LOW</span><strong id="severity-low">0</strong><p>Low priority</p>
                </div>
            </div>

            <div class="panel">
                <h3>Threat Distribution</h3>
                <div class="distribution-item">
                    <div class="distribution-label"><span>High</span><span>0%</span></div>
                    <div class="distribution-bar"><div class="distribution-fill high-fill" style="width:0%;"></div></div>
                </div>
                <div class="distribution-item">
                    <div class="distribution-label"><span>Medium</span><span>0%</span></div>
                    <div class="distribution-bar"><div class="distribution-fill medium-fill" style="width:0%;"></div></div>
                </div>
                <div class="distribution-item">
                    <div class="distribution-label"><span>Low</span><span>0%</span></div>
                    <div class="distribution-bar"><div class="distribution-fill low-fill" style="width:0%;"></div></div>
                </div>
            </div>

            <div class="panel">
                <h3>Current Security Status</h3>
                <p class="large-status">MONITORING ACTIVE</p>
            </div>
        </section>

        <!-- ========== SECURITY EVENTS ========== -->
        <section id="events" class="page" hidden>
            <h2>Security Events</h2>
            <p class="page-description">Review security events recorded by the platform.</p>

            <div class="event-controls">
                <label for="severity-filter">Filter by severity:</label>
                <select id="severity-filter">
                    <option value="all">All</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
                <button type="button" class="primary-button" onclick="refreshEvents()">Refresh Events</button>
            </div>

            <div class="panel table-panel">
                <table class="events-table">
                    <caption class="sr-only">Security events recorded by the platform</caption>
                    <thead>
                        <tr>
                            <th scope="col">Event ID</th>
                            <th scope="col">Event Type</th>
                            <th scope="col">Device</th>
                            <th scope="col">Severity</th>
                            <th scope="col">Status</th>
                            <th scope="col">Time</th>
                        </tr>
                    </thead>
                    <tbody id="events-table-body" aria-live="polite">
                        <tr>
                            <td>Loading...</td><td>Loading...</td><td>Loading...</td>
                            <td>-</td><td>-</td><td>-</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ========== VULNERABILITY SCANNER ========== -->
        <section id="scanner" class="page" hidden>
            <h2>Vulnerability Scanner</h2>
            <p class="page-description">Scan a website you own for common security weaknesses. You must prove you own a domain before MellowTech will scan it.</p>

            <div class="panel" data-admin-only>
                <h3>Add a domain</h3>
                <div class="form-row" style="margin-top:0;border-top:0;padding-top:0">
                    <label class="field" style="flex:1">Domain <input type="text" id="vs-domain" placeholder="yourcompany.com" autocomplete="off" spellcheck="false"></label>
                    <button type="button" class="btn-small" id="vs-add">Add domain</button>
                </div>
            </div>

            <div id="vs-message" class="result-message" role="status" aria-live="polite"></div>
            <div id="vs-domains"></div>
        </section>

        <!-- ========== BILLING & PLANS ========== -->
        <section id="billing" class="page" hidden>
            <h2>Billing &amp; Plans</h2>
            <p class="page-description">Choose a plan and pay securely with PayPal or Payfast.</p>

            <div class="bl-hero">
                <div>
                    <span class="bl-eyebrow">YOUR SUBSCRIPTION</span>
                    <h3 id="bill-plan">Loading...</h3>
                    <p id="bill-expires">Loading...</p>
                </div>
                <div class="bl-ring" aria-hidden="true">
                    <svg viewBox="0 0 100 100"><circle class="t" cx="50" cy="50" r="46"/><circle class="v" id="bl-ring" cx="50" cy="50" r="46"/></svg>
                    <div class="bl-ring-text"><b id="bl-days">0</b><small>DAYS LEFT</small></div>
                </div>
            </div>

            <div id="bill-message"></div>
            

            <div class="plans-grid" id="plans-grid"></div>

            <div class="panel" id="feature-locks">
                <h3>What each plan unlocks</h3>
                <p class="page-description" style="margin-top:4px">Some features stay locked until a plan that includes them is paid for.</p>
                <div id="feature-locks-list">Loading...</div>
            </div>
            <div class="panel" id="lock-log-panel" hidden>
                <h3>Locked-feature log</h3>
                <p class="page-description" style="margin-top:4px">Times a customer tried a feature their plan does not include.</p>
                <div class="table-scroll">
                    <table class="events-table">
                        <caption class="sr-only">Locked feature attempts</caption>
                        <thead><tr><th scope="col">Time</th><th scope="col">What happened</th></tr></thead>
                        <tbody id="lock-log-body"></tbody>
                    </table>
                </div>
            </div>

            <div class="bl-trust">
                <span><svg viewBox="0 0 24 24"><use href="#i-lock"/></svg>Secure checkout by PayPal or Payfast</span>
                <span><svg viewBox="0 0 24 24"><use href="#i-shield"/></svg>We never see or store your card details</span>
                <span><svg viewBox="0 0 24 24"><use href="#i-refresh"/></svg>One-time payment, no automatic renewals</span>
            </div>
            <p class="page-description" style="text-align:center;margin-top:14px">
                Paying again before your plan ends adds the new days on top of your remaining time.
            </p>
        </section>

        <!-- ========== ACCOUNT REQUESTS ========== -->
        <section id="requests" class="page" hidden>
            <h2>Account requests</h2>
            <p class="page-description">People who asked for a MellowTech account. They cannot sign in until you approve them.</p>
            <div id="request-result" class="result-message" role="status" aria-live="polite"></div>

            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h3>Waiting for your decision</h3>
                        <p>Make sure you recognise the company and the person before you approve.</p>
                    </div>
                </div>
                <div class="table-scroll">
                    <table class="events-table">
                        <caption class="sr-only">Account requests waiting for a decision</caption>
                        <thead><tr>
                            <th scope="col">Company</th><th scope="col">Name</th><th scope="col">Email</th>
                            <th scope="col">Requested</th><th scope="col">Email confirmed</th><th scope="col">Decision</th>
                        </tr></thead>
                        <tbody id="requests-pending"><tr><td colspan="6">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <h3>Recent decisions</h3>
                <div class="table-scroll">
                    <table class="events-table">
                        <caption class="sr-only">Decided account requests</caption>
                        <thead><tr>
                            <th scope="col">Company</th><th scope="col">Name</th><th scope="col">Email</th>
                            <th scope="col">Decision</th><th scope="col">Decided</th><th scope="col">Note</th>
                        </tr></thead>
                        <tbody id="requests-decided"><tr><td colspan="6">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ========== DOCUMENT SCANNER ========== -->
        <section id="docscan" class="page" hidden>
            <h2>Document Scanner</h2>
            <p class="page-description">Check an invoice, payslip or other document for signs that it was edited or generated.</p>

            <div id="ds-lock" class="bill-notice info" hidden>
                Locked: the Document Scanner is included in Starter Protection or a higher plan.
                <button type="button" class="btn-small" id="ds-unlock" style="margin-left:12px">Unlock with a plan</button>
            </div>

            <div class="panel">
                <h3>Scan a document</h3>
                <div class="form-row" style="margin-top:0;border-top:0;padding-top:0">
                    <label class="field">Document type
                        <select id="ds-type">
                            <option value="invoice">Invoice</option>
                            <option value="payslip">Payslip</option>
                            <option value="bank_statement">Bank statement</option>
                            <option value="id_document">ID document or passport</option>
                            <option value="proof_of_address">Proof of address or utility bill</option>
                            <option value="tax_document">Tax document</option>
                            <option value="contract">Contract or agreement</option>
                            <option value="qualification">Qualification certificate</option>
                            <option value="medical">Medical certificate</option>
                            <option value="other">Other document</option>
                        </select>
                    </label>
                    <label class="field" style="flex:1">File (PDF, JPG or PNG, up to 5 MB)
                        <input type="file" id="ds-file" accept=".pdf,.jpg,.jpeg,.png">
                    </label>
                    <button type="button" class="btn-small" id="ds-scan">Scan document</button>
                </div>
                <p class="page-description" style="margin:10px 0 0">The scan reads the hidden details inside the file: which program made it, and when it was created and changed. It shows warning signs only. It cannot prove that a document is genuine, so always confirm important documents with whoever issued them.</p>
            </div>

            <div id="ds-message" class="result-message" role="status" aria-live="polite"></div>
            <div id="ds-result"></div>

            <div class="panel">
                <h3>Recent scans</h3>
                <div class="table-scroll">
                    <table class="events-table">
                        <caption class="sr-only">Recent document scans</caption>
                        <thead><tr><th scope="col">Time</th><th scope="col">Document</th><th scope="col">Type</th><th scope="col">Result</th></tr></thead>
                        <tbody id="ds-history"><tr><td colspan="4">Loading...</td></tr></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ========== SERVICE: AI Security ========== -->
        <section id="svc-ai_security" class="page" hidden>
            <h2>AI Security</h2>
            <p class="page-description">Run a quick security check, ask MellowTech for help, or report a problem.</p>
            <div id="svc-top-ai_security">Loading...</div>
