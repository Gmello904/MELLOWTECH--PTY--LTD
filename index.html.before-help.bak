        <footer>
            <p>MellowTech Security Platform</p>
            <p>© 2026 MellowTech (Pty) Ltd. All rights reserved.</p>
        </footer>
    </main>

    <script src="app.js"></script>

    <!-- Billing, PayPal and Payfast (self-contained, does not change app.js) -->
    <script>
    (function () {
        var csrf = "";
        var me = null;
        var paypalLoaded = false;
        var billingReady = false;
        var paymentsOn = true;
        window.__payfastReady = false;

        var ppNote = "Available once PayPal is connected";
        var pfNote = "Available once Payfast is connected";
        var lastKey = "";

        /* Edit these lists to describe what each plan includes. */
        var FEATURES = {
            free:     ["Dashboard and live monitoring", "Security event log", "Email support"],
            starter:  ["Basic security assessment", "Monthly vulnerability scans", "Security alerts for supported systems",
                       "Monthly security report", "Standard email support"],
            business: ["Everything in Starter", "Weekly vulnerability scans", "Ongoing monitoring of supported devices",
                       "Priority security alerts", "Monthly risk reports", "Remote incident guidance"],
            enterprise: ["Advanced security monitoring for agreed systems", "Threat detection and prioritised alerts",
                         "Regular vulnerability assessments", "Incident response coordination",
                         "Executive-level security reports", "POPIA security-control support",
                         "Dedicated onboarding and security reviews"]
        };
        var SUBTITLE = {
            free: "Get started at no cost",
            starter: "For startups and small businesses.",
            business: "For established and growing businesses.",
            enterprise: "Government, large enterprises, financial institutions and critical infrastructure."
        };
        var TICK = '<svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>';

        function $(id) { return document.getElementById(id); }

        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) { throw new Error(data.error || "Something went wrong."); }
                    return data;
                });
            });
        }

        function say(text, kind, html) {
            var box = $("bill-message");
            box.textContent = "";
            if (!text) { return; }
            var note = document.createElement("div");
            note.className = "bill-notice " + kind;
            if (html) { note.innerHTML = text; } else { note.textContent = text; }
            box.appendChild(note);
        }

        function niceDate(value) {
            if (!value) { return "No active plan"; }
            var date = new Date(value);
            return isNaN(date) ? value : date.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" });
        }

        function planName(key) {
            return key ? key.charAt(0).toUpperCase() + key.slice(1) : "Free";
        }

        function daysLeft() {
            if (!me || me.plan === "free" || !me.plan_expires) { return 0; }
            var ms = new Date(me.plan_expires).getTime() - Date.now();
            return ms > 0 ? Math.ceil(ms / 86400000) : 0;
        }

        function showPlan() {
            var plan = me ? me.plan : "free";
            var badge = $("plan-badge");
            badge.textContent = "Plan: " + planName(plan);
            badge.className = "plan-badge" + (plan !== "free" ? " paid" : "");
            $("bill-plan").textContent = planName(plan) + " plan";
            $("bill-expires").textContent = plan === "free"
                ? "Free plan, no expiry. Upgrade any time."
                : "Active until " + niceDate(me.plan_expires) + " \u00b7 " + daysLeft() + " of 30 days left";

            var days = daysLeft();
            $("bl-days").textContent = plan === "free" ? "-" : String(days);
            var share = plan === "free" ? 0 : Math.min(1, days / 30);
            $("bl-ring").style.strokeDashoffset = (289 * (1 - share)).toFixed(1);

            if (me && me.name) {
                $("avatar").textContent = me.name.trim().charAt(0).toUpperCase() || "M";
            }
        }

        function loadPayPal(clientId, currency) {
            return new Promise(function (resolve, reject) {
                if (paypalLoaded && window.paypal) { resolve(); return; }
                var script = document.createElement("script");
                script.src = "https://www.paypal.com/sdk/js?client-id=" + encodeURIComponent(clientId) +
                             "&currency=" + encodeURIComponent(currency) + "&intent=capture";
                script.onload = function () { paypalLoaded = true; resolve(); };
                script.onerror = function () { reject(new Error("Could not load PayPal. Check your internet connection and that the Client ID is correct.")); };
                document.head.appendChild(script);
            });
        }

        function featureList(key) {
            return '<ul class="plan-features">' + (FEATURES[key] || []).map(function (f) {
                return "<li>" + TICK + "<span>" + f + "</span></li>";
            }).join("") + "</ul>";
        }

        function serviceList(plan) {
            var own = plan.services || [];
            if (!own.length) { return ""; }
            var prev = { business: "Starter Protection", enterprise: "Business Protection" }[plan.key];
            return '<div class="plan-svc"><p class="plan-svc-head">Security services unlocked</p><ul>' +
                (prev ? '<li class="plan-svc-all">Everything in ' + prev + "</li>" : "") +
                own.map(function (n) { return "<li>" + TICK + "<span>" + n + "</span></li>"; }).join("") + "</ul></div>";
        }

        function zar(value) {
            return "R " + Number(value).toLocaleString("en-ZA", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function drawPlans(info, canPay) {
            var grid = $("plans-grid");
            grid.textContent = "";

            /* the Free plan card */
            var free = document.createElement("div");
            free.className = "plan-card" + (me.plan === "free" ? " current" : "");
            free.innerHTML =
                (me.plan === "free" ? '<span class="plan-tag">CURRENT PLAN</span>' : "") +
                "<h4>Free</h4><p class=\"plan-sub\">" + SUBTITLE.free + "</p>" +
                '<div class="plan-price"><small>' + info.currency + "</small>0</div>" +
                '<div class="plan-days">forever</div>' + featureList("free") +
                '<button type="button" class="free-btn" disabled>' + (me.plan === "free" ? "You are on this plan" : "Included") + "</button>";
            grid.appendChild(free);

            info.plans.forEach(function (plan, index) {
                var featured = plan.key === "business";
                var card = document.createElement("div");
                card.className = "plan-card" + (featured ? " featured" : "") + (me.plan === plan.key ? " current" : "");
                card.innerHTML =
                    (featured ? '<span class="plan-ribbon">MOST POPULAR</span>' : "") +
                    (me.plan === plan.key ? '<span class="plan-tag">CURRENT PLAN</span>' : "") +
                    "<h4>" + plan.name + '</h4><p class="plan-sub">' + (SUBTITLE[plan.key] || "") + "</p>" +
                    '<div class="plan-price"><small>' + info.currency + "</small>" + plan.price + "</div>" +
                    '<div class="plan-days">' + (plan.key === "enterprise" ? "/ month starting price &middot; custom contracts and SLAs available" : "/ month (" + (plan.days || 30) + " days)" + (plan.setup_fee ? " &middot; Setup fee: " + info.currency + " " + plan.setup_fee : "")) + "</div>" + featureList(plan.key) + serviceList(plan) +
                    '<div class="pp-slot" id="paypal-' + plan.key + '"></div>' +
                    '<div class="pp-slot" id="payfast-' + plan.key + '"></div>';
                grid.appendChild(card);

                var payPalSlot = card.querySelector("#paypal-" + plan.key);
                var payFastSlot = card.querySelector("#payfast-" + plan.key);

                if (plan.key === "enterprise") {
                    var contact = document.createElement("a");
                    contact.className = "btn-small";
                    contact.style.cssText = "display:block;text-align:center;text-decoration:none;margin-top:10px;padding:13px;border-radius:10px;background:#0f2236;color:#fff;font-weight:700";
                    contact.href = "mailto:mphogivenmello@gmail.com?subject=Enterprise%20Protection%20enquiry";
                    contact.textContent = "Contact sales";
                    card.appendChild(contact);
                }

                /* PayPal button */
                if (!canPay) {
                    payPalSlot.innerHTML = '<button type="button" class="pp-fake" disabled><b>Pay</b>Pal</button>' +
                                           '<p class="pp-note">' + ppNote + '</p>';
                } else {
                    window.paypal.Buttons({
                        style: { layout: "vertical", shape: "rect", label: "pay", height: 44 },
                        createOrder: function () {
                            say("", "info");
                            return api("/api/paypal/create-order", { plan: plan.key }).then(function (data) { return data.id; });
                        },
                        onApprove: function (data) {
                            say("Confirming your payment...", "info");
                            return api("/api/paypal/capture-order", { order_id: data.orderID }).then(function () {
                                return api("/api/auth/me");
                            }).then(function (fresh) {
                                me = fresh.user;
                                csrf = fresh.csrf;
                                showPlan();
                                drawPlans(info, canPay);
                                say("Payment received. Your " + planName(me.plan) + " plan is active until " + niceDate(me.plan_expires) + ".", "ok");
                            }).catch(function (problem) {
                                say(problem.message, "err");
                            });
                        },
                        onCancel: function () { say("Payment cancelled. You were not charged.", "info"); },
                        onError: function () { say("PayPal reported a problem. You were not charged. Please try again.", "err"); }
                    }).render("#paypal-" + plan.key);
                }

                /* Payfast button */
                if (!window.__payfastReady) {
                    payFastSlot.innerHTML = '<button type="button" class="pp-fake" disabled style="background:#f26522;color:#fff">Pay with card or PayShap</button>' +
                                            '<p class="pp-note">' + pfNote + '</p>';
                } else {
                    var pfBtn = document.createElement("button");
                    pfBtn.type = "button";
                    pfBtn.className = "btn-small";
                    pfBtn.style.cssText = "width:100%;margin-top:8px;padding:12px;background:#f26522;color:#fff;border:0;font-weight:700;border-radius:8px;cursor:pointer";
                    pfBtn.textContent = "Pay with card or PayShap" + (plan.zar_due ? " \u00b7 " + zar(plan.zar_due) : "");
                    pfBtn.addEventListener("click", function () {
                        pfBtn.disabled = true;
                        api("/api/payfast/create-order", { plan: plan.key }).then(function (data) {
                            var form = document.createElement("form");
                            form.method = "POST";
                            form.action = data.process_url;
                            Object.keys(data.fields).forEach(function (key) {
                                var input = document.createElement("input");
                                input.type = "hidden"; input.name = key; input.value = data.fields[key];
                                form.appendChild(input);
                            });
                            document.body.appendChild(form);
                            form.submit();
                        }).catch(function (err) {
                            say(err.message, "err");
                            pfBtn.disabled = false;
                        });
                    });
                    payFastSlot.appendChild(pfBtn);
                    if (plan.zar_due) {
                        var note = document.createElement("p");
                        note.className = "pp-note";
                        note.textContent = plan.setup_fee
                            ? "Rand amount now includes the one-time setup fee; after that " + zar(plan.zar_month) + " per month (" + info.rate + " ZAR per USD)."
                            : zar(plan.zar_month) + " per month (" + info.rate + " ZAR per USD).";
                        payFastSlot.appendChild(note);
                    }
                }
            });
        }

        function openBilling() {
            if (!billingReady) { say("Loading plans...", "info"); }
            api("/api/billing").then(function (info) {
                var on = info.payments || { paypal: info.payments_enabled !== false, payfast: info.payments_enabled !== false };
                var isAdmin = me.role === "admin";
                var ppOk = !!(on.paypal && info.paypal_client_id && isAdmin);
                var pfWanted = !!(on.payfast && isAdmin);
                ppNote = !on.paypal ? "PayPal is temporarily unavailable"
                       : !info.paypal_client_id ? "Available once PayPal is connected"
                       : !isAdmin ? "Only an account administrator can pay" : "";
                pfNote = !on.payfast ? "Payfast is temporarily unavailable"
                       : !isAdmin ? "Only an account administrator can pay" : "Available once Payfast is connected";

                var key = JSON.stringify([on, me.plan, info.paypal_client_id, isAdmin]);
                if (billingReady && key === lastKey) { return; }       /* nothing changed since the last visit */

                var check = pfWanted
                    ? api("/api/payfast/ready").then(function (pf) { window.__payfastReady = !!pf.ready; })
                          .catch(function () { window.__payfastReady = false; })
                    : Promise.resolve().then(function () { window.__payfastReady = false; });

                return check.then(function () {
                    return ppOk ? loadPayPal(info.paypal_client_id, info.currency) : null;
                }).then(function () {
                    drawPlans(info, ppOk);
                    if (!on.paypal && !on.payfast) {
                        say("Payments are temporarily unavailable. Please try again later.", "info");
                    } else if (!isAdmin) {
                        say("Only an account administrator can buy or change a plan.", "info");
                    } else if (!info.paypal_client_id && me.is_platform) {
                        say("PayPal is not connected yet. Put <code>PAYPAL_CLIENT_ID</code> and <code>PAYPAL_SECRET</code> in " +
                            "<code>backend/settings.env</code>, then restart <code>python app.py</code>.", "info", true);
                    } else {
                        say("", "info");
                    }
                    lastKey = key;
                    billingReady = true;
                });
            }).catch(function (problem) {
                say(problem.message, "err");
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (data) {
                me = data.user;
                csrf = data.csrf;
                showPlan();
            }).catch(function () {
                $("plan-badge").textContent = "Plan: ?";
            });


            $("plan-badge").addEventListener("click", function () {
                var button = document.querySelector('.nav-button[data-page="billing"]');
                if (button) { button.click(); }
            });

            var navButton = document.querySelector('.nav-button[data-page="billing"]');
            if (navButton) {
                navButton.addEventListener("click", function () {
                    if (me) { openBilling(); }
                    else { setTimeout(openBilling, 800); }
                });
            }
        });
    })();
    </script>

    <!-- Dashboard threat overview (reads the data app.js already loads) -->
    <script>
    (function () {
        var host = document.querySelector("#dashboard .stats-grid");
        if (!host) return;

        var box = document.createElement("div");
        box.className = "ov-grid";
        box.innerHTML =
            '<div class="ov-card"><h3>Threat level</h3><div class="ov-level" id="ov-level">...</div>' +
            '<p class="ov-sub" id="ov-sub"></p><div class="ov-scale" id="ov-scale"><i></i><i></i><i></i><i></i></div>' +
            '<div class="ov-scale-names"><span>Secure</span><span>Elevated</span><span>High</span><span>Critical</span></div></div>' +
            '<div class="ov-card"><h3>Open alerts by severity</h3><div class="ov-donut"><svg viewBox="0 0 120 120" id="ov-svg"></svg>' +
            '<div><div class="ov-total" id="ov-total">0</div><div class="ov-legend">' +
            '<span><i style="background:#c62f3b"></i>High <b id="ov-h">0</b></span>' +
            '<span><i style="background:#f5a524"></i>Medium <b id="ov-m">0</b></span>' +
            '<span><i style="background:#12906e"></i>Low <b id="ov-l">0</b></span></div></div></div></div>' +
            '<div class="ov-card"><h3>Events, last 7 days</h3><div class="ov-trend" id="ov-trend"></div></div>';
        host.after(box);

        var C = 2 * Math.PI * 46;
        var OPEN = ["New", "Investigating", "Blocked", "Open", "Monitoring"];
        var LEVELS = [
            { name: "Secure", color: "#12906e", note: "No open alerts. All quiet." },
            { name: "Elevated", color: "#f5a524", note: "Some alerts need a look." },
            { name: "High", color: "#e8590c", note: "A high severity alert is open." },
            { name: "Critical", color: "#c62f3b", note: "Several high severity alerts. Act now." }
        ];

        function draw() {
            var ev = (typeof lastEvents !== "undefined" && Array.isArray(lastEvents)) ? lastEvents : [];
            var open = ev.filter(function (e) { return OPEN.indexOf(e.status) !== -1; });
            var n = { high: 0, medium: 0, low: 0 };
            open.forEach(function (e) {
                var s = String(e.severity).toLowerCase();
                if (n[s] !== undefined) n[s]++;
            });

            var level = n.high >= 3 ? 3 : n.high >= 1 ? 2 : n.medium >= 1 ? 1 : 0;
            var L = LEVELS[level];
            var lv = document.getElementById("ov-level");
            lv.textContent = L.name;
            lv.style.color = L.color;
            document.getElementById("ov-sub").textContent = L.note;
            document.querySelectorAll("#ov-scale i").forEach(function (b, i) {
                b.style.background = i <= level ? LEVELS[i].color : "";
            });

            var total = n.high + n.medium + n.low;
            document.getElementById("ov-total").textContent = total;
            document.getElementById("ov-h").textContent = n.high;
            document.getElementById("ov-m").textContent = n.medium;
            document.getElementById("ov-l").textContent = n.low;

            var svg = '<circle cx="60" cy="60" r="46" stroke="#e9eef3"/>';
            if (total === 0) {
                svg += '<circle cx="60" cy="60" r="46" stroke="#12906e" stroke-linecap="round"/>';
            } else {
                var off = 0;
                [[n.high, "#c62f3b"], [n.medium, "#f5a524"], [n.low, "#12906e"]].forEach(function (p) {
                    if (!p[0]) return;
                    var len = p[0] / total * C;
                    svg += '<circle cx="60" cy="60" r="46" stroke="' + p[1] + '" stroke-dasharray="' + len.toFixed(1) +
                           ' ' + (C - len).toFixed(1) + '" stroke-dashoffset="' + (-off).toFixed(1) + '"/>';
                    off += len;
                });
            }
            document.getElementById("ov-svg").innerHTML = svg;

            var days = [], counts = {};
            for (var d = 6; d >= 0; d--) {
                var day = new Date();
                day.setHours(0, 0, 0, 0);
                day.setDate(day.getDate() - d);
                var key = day.toDateString();
                days.push({ key: key, label: day.toLocaleDateString(undefined, { weekday: "short" }) });
                counts[key] = 0;
            }
            ev.forEach(function (e) {
                var t = new Date(e.timestamp);
                if (!isNaN(t) && counts[t.toDateString()] !== undefined) counts[t.toDateString()]++;
            });
            var max = Math.max.apply(null, days.map(function (x) { return counts[x.key]; }).concat([1]));
            document.getElementById("ov-trend").innerHTML = days.map(function (x) {
                var c = counts[x.key];
                return '<div class="ov-col"><b>' + c + '</b><i style="height:' + Math.round(c / max * 85) + '%"></i><small>' + x.label + '</small></div>';
            }).join("");
        }

        draw();
        setInterval(draw, 3000);
    })();
    </script>

    <!-- Threat Detection page graphics: radar, risk gauge, donut and 7-day chart -->
    <script>
    (function () {
        var OPEN = ["New", "Investigating", "Blocked", "Open", "Monitoring"];
        var LEVELS = [
            { name: "Secure", color: "#3ddbb0", note: "No open alerts. All quiet." },
            { name: "Elevated", color: "#f5a524", note: "Some alerts need a look." },
            { name: "High Risk", color: "#ff7a3d", note: "A high severity alert is open. Review it now." },
            { name: "Critical", color: "#ff5b66", note: "Several high severity alerts. Act now." }
        ];
        var SEV = { high: "#ff5b66", medium: "#f5a524", low: "#3ddbb0" };
        var C = 2 * Math.PI * 46;
        var ARC = 276.5;

        function el(id) { return document.getElementById(id); }

        /* a stable position for each alert on the radar, so blips do not jump around */
        function spot(key) {
            var h = 0, s = String(key);
            for (var i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) % 100003; }
            var angle = (h % 360) * Math.PI / 180;
            var dist = 22 + (h % 70);
            return { x: 50 + Math.cos(angle) * dist / 2, y: 50 + Math.sin(angle) * dist / 2 };
        }

        function draw() {
            if (!el("tg-level")) return;
            var ev = (typeof lastEvents !== "undefined" && Array.isArray(lastEvents)) ? lastEvents : [];
            var blocks = (typeof lastBlocks !== "undefined" && Array.isArray(lastBlocks)) ? lastBlocks : [];
            var open = ev.filter(function (e) { return OPEN.indexOf(e.status) !== -1; });
            var n = { high: 0, medium: 0, low: 0 };
            open.forEach(function (e) {
                var s = String(e.severity).toLowerCase();
                if (n[s] !== undefined) n[s]++;
            });
            var total = n.high + n.medium + n.low;
            var activeBlocks = blocks.filter(function (b) { return b.status === "active"; }).length;

            var level = n.high >= 3 ? 3 : n.high >= 1 ? 2 : n.medium >= 1 ? 1 : 0;
            var L = LEVELS[level];
            el("tg-level").textContent = L.name;
            el("tg-level").style.color = level === 0 ? "#fff" : L.color;
            el("tg-note").textContent = L.note;
            document.querySelectorAll("#tg-scale i").forEach(function (b, i) {
                b.style.background = i <= level ? LEVELS[i].color : "";
                b.style.boxShadow = i <= level ? "0 0 10px " + LEVELS[i].color : "none";
            });
            el("tg-m-open").textContent = total;
            el("tg-m-blocks").textContent = activeBlocks;
            el("tg-m-time").textContent = new Date().toLocaleTimeString();

            var score = Math.min(100, n.high * 30 + n.medium * 12 + n.low * 4);
            var gaugeColor = score >= 70 ? "#c62f3b" : score >= 35 ? "#f5a524" : "#12906e";
            el("tg-score").textContent = score;
            el("tg-score").style.color = gaugeColor;
            el("tg-arc").style.stroke = gaugeColor;
            el("tg-arc").style.strokeDashoffset = (ARC * (1 - score / 100)).toFixed(1);

            el("tg-total").textContent = total;
            el("tg-h").textContent = n.high;
            el("tg-m").textContent = n.medium;
            el("tg-l").textContent = n.low;
            var svg = '<circle cx="60" cy="60" r="46" stroke="#e9eef3"/>';
            if (total === 0) {
                svg += '<circle cx="60" cy="60" r="46" stroke="#12906e" stroke-linecap="round"/>';
            } else {
                var off = 0;
                [[n.high, "#c62f3b"], [n.medium, "#f5a524"], [n.low, "#12906e"]].forEach(function (p) {
                    if (!p[0]) return;
                    var len = p[0] / total * C;
                    svg += '<circle cx="60" cy="60" r="46" stroke="' + p[1] + '" stroke-dasharray="' + len.toFixed(1) +
                           ' ' + (C - len).toFixed(1) + '" stroke-dashoffset="' + (-off).toFixed(1) + '"/>';
                    off += len;
                });
            }
            el("tg-svg").innerHTML = svg;

            var days = [], counts = {};
            for (var d = 6; d >= 0; d--) {
                var day = new Date();
                day.setHours(0, 0, 0, 0);
                day.setDate(day.getDate() - d);
                var key = day.toDateString();
                days.push({ key: key, label: day.toLocaleDateString(undefined, { weekday: "short" }) });
                counts[key] = 0;
            }
            ev.forEach(function (e) {
                var t = new Date(e.timestamp);
                if (!isNaN(t) && counts[t.toDateString()] !== undefined) counts[t.toDateString()]++;
            });
            var max = Math.max.apply(null, days.map(function (x) { return counts[x.key]; }).concat([1]));
            el("tg-trend").innerHTML = days.map(function (x) {
                var c = counts[x.key];
                return '<div class="tg-col"><b>' + c + '</b><i style="height:' + Math.round(c / max * 85) + '%"></i><small>' + x.label + '</small></div>';
            }).join("");

            var radar = el("tg-radar");
            radar.querySelectorAll(".tg-blip").forEach(function (b) { b.remove(); });
            open.slice(0, 24).forEach(function (e) {
                var p = spot(e.row_key || e.id);
                var colour = SEV[String(e.severity).toLowerCase()] || SEV.low;
                var blip = document.createElement("div");
                blip.className = "tg-blip";
                blip.style.left = p.x + "%";
                blip.style.top = p.y + "%";
                blip.style.background = colour;
                blip.style.setProperty("--c", colour);
                blip.title = e.type + " (" + e.severity + ")";
                radar.appendChild(blip);
            });
        }

        draw();
        setInterval(draw, 2000);
    })();
    </script>

    <!-- Vulnerability Scanner -->
    <script>
    (function () {
        var csrf = "";
        var isAdmin = false;

        function el(id) { return document.getElementById(id); }

        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) { throw new Error(data.error || "Something went wrong."); }
                    return data;
                });
            });
        }

        function say(text, kind) {
            var box = el("vs-message");
            box.textContent = text || "";
            box.style.color = kind === "err" ? "#b42318" : kind === "ok" ? "#12906e" : "";
        }

        function sevColor(sev) {
            return sev === "High" ? "danger" : sev === "Medium" ? "warning" : "safe";
        }

        function scoreColor(score) {
            return score >= 80 ? "#12906e" : score >= 50 ? "#c47b00" : "#b42318";
        }

        function renderDomains(domains) {
            var host = el("vs-domains");
            host.innerHTML = "";
            if (!domains.length) {
                host.innerHTML = '<div class="panel"><p class="empty">No domains added yet.</p></div>';
                return;
            }
            domains.forEach(function (d) {
                var card = document.createElement("div");
                card.className = "panel";
                var html = "<div class=\"panel-header\"><div><h3>" + d.domain + "</h3>" +
                    "<p>" + (d.verified ? "Ownership verified" : "Not verified yet") + "</p></div>";
                if (d.last_score !== null && d.last_score !== undefined) {
                    html += '<span class="badge" style="background:' + scoreColor(d.last_score) + '22;color:' + scoreColor(d.last_score) + '">Score: ' + d.last_score + '/100</span>';
                }
                html += "</div>";

                if (!d.verified) {
                    html += '<div class="status-item"><span>Step 1</span><strong>Publish this exact text at the address below</strong></div>' +
                        '<div class="code-box">' + d.verify_token + "</div>" +
                        '<div class="status-item"><span>Address</span><strong>' + d.verify_url + "</strong></div>" +
                        (isAdmin ? '<div class="actions" style="margin-top:14px"><button type="button" class="btn-small" data-action="vs-verify" data-id="' + d.id + '">I have published it, verify now</button>' +
                        '<button type="button" class="btn-small btn-danger" data-action="vs-remove" data-id="' + d.id + '">Remove</button></div>' : "");
                } else {
                    html += (isAdmin ? '<div class="actions"><button type="button" class="btn-small" data-action="vs-scan" data-id="' + d.id + '">Run scan</button>' +
                        '<button type="button" class="btn-small btn-danger" data-action="vs-remove" data-id="' + d.id + '">Remove</button></div>' : "");
                    if (d.last_findings && d.last_findings.length) {
                        html += '<div class="table-scroll"><table class="events-table"><thead><tr><th>Severity</th><th>Finding</th><th>Detail</th></tr></thead><tbody>';
                        d.last_findings.forEach(function (f) {
                            html += "<tr><td><span class=\"badge " + sevColor(f.severity) + "\">" + f.severity + "</span></td><td>" + f.title + "</td><td>" + f.detail + "</td></tr>";
                        });
                        html += "</tbody></table></div>";
                    } else if (d.last_scanned_at) {
                        html += '<p class="result-message">No issues found in the last scan.</p>';
                    } else {
                        html += '<p class="empty">Not scanned yet.</p>';
                    }
                }
                card.innerHTML = html;
                host.appendChild(card);
            });
        }

        function loadDomains() {
            api("/api/scanner/domains").then(renderDomains).catch(function (err) { say(err.message, "err"); });
        }

        document.addEventListener("click", function (event) {
            var button = event.target.closest("[data-action^='vs-']");
            if (!button) return;
            var id = button.dataset.id;
            button.disabled = true;
            var action = button.dataset.action;

            var task = action === "vs-verify" ? api("/api/scanner/domains/" + id + "/verify", {})
                : action === "vs-scan" ? api("/api/scanner/domains/" + id + "/scan", {})
                : action === "vs-remove" && window.confirm("Remove this domain and its scan history?") ? api("/api/scanner/domains/" + id + "/remove", {})
                : null;

            if (!task) { button.disabled = false; return; }

            say(action === "vs-scan" ? "Scanning..." : "Working...", "");
            task.then(function () {
                say("", "");
                loadDomains();
            }).catch(function (err) {
                say(err.message, "err");
            }).finally(function () { button.disabled = false; });
        });

        el("vs-add").addEventListener("click", function () {
            var domain = el("vs-domain").value.trim();
            if (!domain) { say("Enter a domain first.", "err"); return; }
            say("Adding...", "");
            api("/api/scanner/domains", { domain: domain }).then(function () {
                el("vs-domain").value = "";
                say("Domain added. Publish the verification file to continue.", "ok");
                loadDomains();
            }).catch(function (err) { say(err.message, "err"); });
        });

        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (data) {
                csrf = data.csrf;
                isAdmin = data.user.role === "admin";
                loadDomains();
            }).catch(function () {});

            var navButton = document.querySelector('.nav-button[data-page="scanner"]');
            if (navButton) { navButton.addEventListener("click", loadDomains); }
        });
    })();
    </script>
<!-- Document Scanner, Security Roles and locked features -->
    <style>
        .rl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .rl-card ul { margin: 10px 0 12px; padding-left: 20px; display: grid; gap: 6px; }
        .rl-skills { margin: 0; font-size: 13px; color: #68737d; }
    </style>
    <script>
    (function () {
        var csrf = "";
        var me = null;
        var NEEDS = { starter: "Starter Protection", business: "Business Protection", enterprise: "Premium Enterprise Protection" };

        /* Edit this list to change the Security Roles page. */
        var ROLES = [
            { name: "AI Security Engineer",
              points: ["Protects AI models and applications against attacks.", "Tests AI systems for security weaknesses.", "Protects sensitive data used by AI."],
              skills: "Python, cybersecurity, AI and machine learning." },
            { name: "Incident Response Analyst",
              points: ["Investigates confirmed cyberattacks.", "Contains threats to prevent further damage.", "Examines digital evidence to determine what happened.", "Helps organisations recover securely after an attack."],
              skills: "Digital forensics, security logs, investigation and problem-solving." },
            { name: "Cloud Security Engineer",
              points: ["Protects data, applications and systems stored in the cloud.", "Secures cloud platforms such as AWS and Microsoft Azure.", "Controls who can access cloud resources."],
              skills: "Cloud computing, networking, Linux and IAM (Identity and Access Management)." },
            { name: "SOC Analyst (Security Operations Centre)",
              points: ["Monitors computer systems for cyber threats.", "Investigates suspicious activities and security alerts.", "Detects and helps stop cyberattacks."],
              skills: "Networking, Linux, SIEM tools and threat detection." },
            { name: "GRC Analyst (Governance, Risk and Compliance)",
              points: ["Creates cybersecurity policies and procedures.", "Identifies and assesses cyber risks.", "Ensures companies follow laws and security standards.", "Supports AI governance and cybersecurity strategy."],
              skills: "Communication, risk assessment, report writing and compliance." }
        ];

        function $(id) { return document.getElementById(id); }

        function esc(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }

        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) {
                        var problem = new Error(data.error || "Something went wrong.");
                        problem.locked = !!data.locked;
                        throw problem;
                    }
                    return data;
                });
            });
        }

        function openBilling() {
            var button = document.querySelector('.nav-button[data-page="billing"]');
            if (button) { button.click(); }
        }

        function say(text, kind) {
            var box = $("ds-message");
            box.textContent = text || "";
            box.style.color = kind === "err" ? "#b42318" : kind === "ok" ? "#12906e" : "";
        }

        function badgeClass(severity) {
            return severity === "High" ? "danger" : severity === "Medium" ? "warning" : "safe";
        }

        function drawRoles() {
            var host = $("roles-grid");
            if (!host) { return; }
            host.innerHTML = ROLES.map(function (role) {
                return '<div class="panel rl-card"><h3>' + esc(role.name) + "</h3><ul>" +
                    role.points.map(function (point) { return "<li>" + esc(point) + "</li>"; }).join("") +
                    '</ul><p class="rl-skills"><b>Key skills:</b> ' + esc(role.skills) + "</p></div>";
            }).join("");
        }

        function loadFeatures() {
            api("/api/features").then(function (data) {
                $("feature-locks-list").innerHTML = data.features.map(function (f) {
                    var tag = f.unlocked
                        ? '<span class="badge safe">Unlocked</span>'
                        : '<span class="badge danger">Locked: needs ' + esc(NEEDS[f.needs] || f.needs) + "</span>";
                    return '<div class="status-item"><span>' + esc(f.label) + "</span>" + tag + "</div>";
                }).join("");
                var scan = data.features.filter(function (f) { return f.key === "document_scan"; })[0];
                $("ds-lock").hidden = !scan || scan.unlocked;
            }).catch(function () {});
        }

        function loadLockLog() {
            api("/api/locked-log").then(function (rows) {
                $("lock-log-panel").hidden = false;
                $("lock-log-body").innerHTML = rows.length
                    ? rows.map(function (r) {
                        return "<tr><td>" + esc(new Date(r.ts).toLocaleString()) + "</td><td>" + esc(r.detail) + "</td></tr>";
                    }).join("")
                    : '<tr><td colspan="2">Nothing yet.</td></tr>';
            }).catch(function () {});
        }

        function loadHistory() {
            api("/api/documents/history").then(function (rows) {
                $("ds-history").innerHTML = rows.length
                    ? rows.map(function (r) {
                        return "<tr><td>" + esc(new Date(r.at).toLocaleString()) + "</td><td>" + esc(r.name) + "</td><td>" +
                            esc(r.type) + "</td><td>" + esc(r.verdict) + " (" + esc(r.score) + "/100)</td></tr>";
                    }).join("")
                    : '<tr><td colspan="4">No documents scanned yet.</td></tr>';
            }).catch(function () {});
        }

        function show(r) {
            var colour = r.level === "high" ? "#b42318" : r.level === "medium" ? "#c47b00" : "#12906e";
            var html = '<div class="panel"><div class="panel-header"><div><h3>' + esc(r.name) + "</h3><p>" + esc(r.type_label) +
                " &middot; SHA-256 " + esc(r.sha256.slice(0, 16)) + '...</p></div><span class="badge" style="background:' +
                colour + "22;color:" + colour + '">' + esc(r.verdict) + " (" + esc(r.score) + "/100)</span></div>";

            if (r.findings.length) {
                html += '<div class="table-scroll"><table class="events-table"><thead><tr><th>Level</th><th>Warning sign</th><th>Detail</th></tr></thead><tbody>';
                r.findings.forEach(function (f) {
                    html += '<tr><td><span class="badge ' + badgeClass(f.severity) + '">' + esc(f.severity) + "</span></td><td>" +
                        esc(f.title) + "</td><td>" + esc(f.detail) + "</td></tr>";
                });
                html += "</tbody></table></div>";
            } else {
                html += '<p class="result-message">No warning signs were found in the hidden details of this file.</p>';
            }

            if (r.facts.length) {
                html += "<h3 style=\"margin-top:18px\">What the file says about itself</h3>";
                r.facts.forEach(function (f) {
                    html += '<div class="status-item"><span>' + esc(f.label) + "</span><strong>" + esc(f.value) + "</strong></div>";
                });
            }

            html += '<h3 style="margin-top:18px">Always check these yourself</h3><ul style="margin:8px 0 0;padding-left:20px;display:grid;gap:6px">' +
                r.checks.map(function (c) { return "<li>" + esc(c) + "</li>"; }).join("") + "</ul>" +
                '<p class="page-description" style="margin-top:14px">This scan reads hidden file details only. A clean result does not prove a document is genuine, and a warning does not prove it is fake.</p></div>';
            $("ds-result").innerHTML = html;
        }

        function scan() {
            var file = $("ds-file").files[0];
            if (!file) { say("Choose a file first.", "err"); return; }
            if (file.size > 5 * 1024 * 1024) { say("That file is bigger than 5 MB.", "err"); return; }
            var button = $("ds-scan");
            var reader = new FileReader();
            reader.onload = function () {
                var data = String(reader.result).split(",")[1] || "";
                say("Scanning...", "");
                button.disabled = true;
                api("/api/documents/scan", { name: file.name, type: $("ds-type").value, data: data }).then(function (result) {
                    say("", "");
                    show(result);
                    loadHistory();
                }).catch(function (problem) {
                    say(problem.message, "err");
                    if (problem.locked) { loadFeatures(); }
                }).then(function () { button.disabled = false; });
            };
            reader.onerror = function () { say("The file could not be read.", "err"); };
            reader.readAsDataURL(file);
        }

        document.addEventListener("DOMContentLoaded", function () {
            drawRoles();
            $("ds-scan").addEventListener("click", scan);
            $("ds-unlock").addEventListener("click", openBilling);

            api("/api/auth/me").then(function (data) {
                csrf = data.csrf;
                me = data.user;
                loadFeatures();
                loadHistory();
                if (me.is_platform && me.role === "admin") { loadLockLog(); }
            }).catch(function () {});

            var scanNav = document.querySelector('.nav-button[data-page="docscan"]');
            if (scanNav) { scanNav.addEventListener("click", function () { loadFeatures(); loadHistory(); }); }
            var billNav = document.querySelector('.nav-button[data-page="billing"]');
            if (billNav) {
                billNav.addEventListener("click", function () {
                    loadFeatures();
                    if (me && me.is_platform && me.role === "admin") { loadLockLog(); }
                });
            }
        });
    })();
    </script>
<!-- Security service pages (one menu button each) -->
    <script>
    (function () {
        var csrf = "";
        var me = null;
        var services = [];

        function $(id) { return document.getElementById(id); }

        function esc(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }

        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) {
                        var problem = new Error(data.error || "Something went wrong.");
                        problem.locked = !!data.locked;
                        throw problem;
                    }
                    return data;
                });
            });
        }

        function openPage(page) {
            var button = document.querySelector('.nav-button[data-page="' + page + '"]');
            if (button) { button.click(); }
        }

        function isStaffAdmin() { return !!(me && me.is_platform && me.role === "admin"); }

        function say(key, text, kind, withUnlock) {
            var box = $("svc-msg-" + key);
            if (!box) { return; }
            box.textContent = text || "";
            box.style.color = kind === "err" ? "#b42318" : kind === "ok" ? "#12906e" : "";
            if (text && withUnlock) {
                var unlock = document.createElement("button");
                unlock.type = "button";
                unlock.className = "btn-small";
                unlock.style.marginLeft = "12px";
                unlock.textContent = "Unlock with a plan";
                unlock.addEventListener("click", function () { openPage("billing"); });
                box.appendChild(unlock);
            }
        }

        function find(key) {
            return services.filter(function (s) { return s.key === key; })[0];
        }

        var PKG_ORDER = { starter: 1, business: 2, enterprise: 3 };

        function drawLocked(s, top) {
            var same = services.filter(function (x) { return x.needs === s.needs; });
            var admin = me && me.role === "admin";
            var form = $("svc-form-" + s.key);
            if (form) { form.innerHTML = ""; }
            var msg = $("svc-msg-" + s.key);
            if (msg) { msg.textContent = ""; }
            top.setAttribute("data-was-locked", "1");
            top.innerHTML = '<div class="panel svc-lockbox">' +
                '<div class="svc-lockicon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></div>' +
                "<h3>" + esc(s.name) + " is locked</h3>" +
                "<p>This service is part of <b>" + esc(s.package) + "</b>" +
                (s.price ? " ($" + esc(s.price) + " / month)" : "") + ". It unlocks as soon as your payment goes through.</p>" +
                '<p class="svc-lockhead">Also in this package</p><ul class="svc-locklist">' +
                same.map(function (x) { return "<li>" + esc(x.name) + "</li>"; }).join("") + "</ul>" +
                '<div class="actions" style="margin-top:14px">' +
                (admin ? '<button type="button" class="btn-small svc-unlock" data-svc-open="billing">Unlock with ' + esc(s.package) + "</button>"
                       : '<p class="rl-skills">Ask your account administrator to pay for this package.</p>') +
                "</div></div>";
        }

        function markNav() {
            services.forEach(function (s) {
                var b = document.querySelector('.nav-button[data-page="svc-' + s.key + '"]');
                if (!b) { return; }
                var locked = s.unlocked === false;
                b.classList.toggle("svc-lock", locked);
                if (locked) { b.setAttribute("data-lock", (s.needs || "").charAt(0).toUpperCase() + (s.needs || "").slice(1)); }
                else { b.removeAttribute("data-lock"); }
            });
        }

        function drawService(s) {
            var top = $("svc-top-" + s.key);
            if (!top) { return; }
            if (s.unlocked === false) { drawLocked(s, top); return; }
            if ($("svc-form-" + s.key) && top.getAttribute("data-was-locked")) { top.removeAttribute("data-was-locked"); }
            var last = s.last
                ? '<p class="rl-skills">Last check: <b>' + esc(s.last.score) + "%</b> on " + esc(new Date(s.last.at).toLocaleDateString()) + "</p>"
                : '<p class="rl-skills">Not checked yet.</p>';
            var extra = s.extra === "alerts"
                ? '<button type="button" class="btn-small" data-svc-open="threats">Open live alerts</button>'
                : s.extra === "incident"
                    ? '<button type="button" class="btn-small btn-danger" data-svc-incident="1">Report an incident</button>'
                    : "";
            top.innerHTML = '<div class="panel"><h3>' + esc(s.role) + "</h3><p>" + esc(s.blurb) + "</p>" + last +
                '<div class="actions" style="margin-top:12px">' +
                '<button type="button" class="btn-small" data-svc-check="' + esc(s.key) + '">Run security check</button>' +
                '<button type="button" class="btn-small" data-svc-request="' + esc(s.key) + '">Request help</button>' +
                extra + "</div></div>";
        }

        function loadServices() {
            api("/api/services").then(function (list) {
                services = list;
                services.forEach(drawService);
                markNav();
            }).catch(function (problem) {
                document.querySelectorAll('[id^="svc-top-"]').forEach(function (box) { box.textContent = problem.message; });
            });
        }

        function loadRequests() {
            api("/api/services/requests").then(function (rows) {
                $("svc-requests-body").innerHTML = rows.length ? rows.map(function (r) {
                    var done = r.status === "done";
                    return "<tr><td>" + esc(new Date(r.at).toLocaleString()) + "</td><td>" + esc(r.company) + "</td><td>" +
                        esc(r.person) + " (" + esc(r.email) + ")</td><td>" + (r.urgent ? '<span class="badge danger">URGENT</span> ' : "") +
                        esc(r.service) + "</td><td>" + esc(r.note || "") + "</td><td>" + esc(r.status.replace("_", " ")) + "</td><td>" +
                        (done ? "" : '<button type="button" class="btn-small" data-svc-done="' + esc(r.id) + '">Mark done</button>') +
                        "</td></tr>";
                }).join("") : '<tr><td colspan="7">No requests yet.</td></tr>';
            }).catch(function () {});
        }

        function openCheck(key) {
            var s = find(key);
            if (!s) { return; }
            var html = '<div class="panel"><div class="panel-header"><div><h3>' + esc(s.name) + ' security check</h3>' +
                "<p>Answer honestly. This is practical guidance, not a formal audit.</p></div></div>";
            s.questions.forEach(function (q, i) {
                html += '<div class="status-item" style="align-items:flex-start;gap:16px"><span style="flex:1">' + esc(q) + "</span><span>" +
                    [["yes", "Yes"], ["no", "No"], ["unsure", "Not sure"]].map(function (o) {
                        return '<label style="margin-left:12px;white-space:nowrap"><input type="radio" name="svcq-' + esc(key) + "-" + i + '" value="' + o[0] + '"> ' + o[1] + "</label>";
                    }).join("") + "</span></div>";
            });
            html += '<div class="actions" style="margin-top:14px"><button type="button" class="btn-small" data-svc-submit="' + esc(key) +
                '">See my result</button></div><div id="svc-result-' + esc(key) + '"></div></div>';
            $("svc-form-" + key).innerHTML = html;
            $("svc-form-" + key).scrollIntoView({ behavior: "smooth", block: "start" });
        }

        function submitCheck(key) {
            var s = find(key);
            var answers = [];
            for (var i = 0; i < s.questions.length; i++) {
                var chosen = document.querySelector('input[name="svcq-' + key + "-" + i + '"]:checked');
                if (!chosen) { say(key, "Answer every question first.", "err"); return; }
                answers.push(chosen.value);
            }
            say(key, "", "");
            api("/api/services/check", { service: key, answers: answers }).then(function (r) {
                var colour = r.level === "high" ? "#b42318" : r.level === "medium" ? "#c47b00" : "#12906e";
                var html = '<h3 style="margin-top:18px">Your result: <span style="color:' + colour + '">' + esc(r.score) + "% (" + esc(r.verdict) + ")</span></h3>";
                if (r.gaps.length) {
                    html += "<p>Fix these first:</p><ul style=\"margin:8px 0 0;padding-left:20px;display:grid;gap:10px\">" +
                        r.gaps.map(function (g) {
                            return "<li><b>" + esc(g.question) + "</b><br>" + esc(g.fix) + "</li>";
                        }).join("") + "</ul>" +
                        '<div class="actions" style="margin-top:14px"><button type="button" class="btn-small" data-svc-request="' + esc(key) + '">Ask MellowTech to help with these</button></div>';
                } else {
                    html += "<p>Well done: every answer was Yes. Re-check regularly, because things change.</p>";
                }
                $("svc-result-" + key).innerHTML = html;
                loadServices();
            }).catch(function (problem) { say(key, problem.message, "err"); });
        }

        function sendRequest(key, urgent) {
            var s = find(key);
            var note = window.prompt(urgent
                ? "Describe what happened, in a few words.\n\nIf you can, disconnect the affected devices from the network. This sends an URGENT alert to MellowTech."
                : "How can MellowTech help with " + s.name + "? (optional)", "");
            if (note === null) { return; }
            api("/api/services/request", { service: key, note: note, urgent: !!urgent }).then(function () {
                say(key, urgent ? "Incident reported. MellowTech has been alerted and a High alert was added to your dashboard."
                                : "Request sent. MellowTech will contact you.", "ok");
                if (urgent && typeof loadSecurityEvents === "function") { loadSecurityEvents(); }
                if (isStaffAdmin()) { loadRequests(); }
            }).catch(function (problem) { say(key, problem.message, "err", problem.locked); });
        }

        document.addEventListener("click", function (event) {
            var t = event.target.closest("[data-svc-check],[data-svc-request],[data-svc-submit],[data-svc-open],[data-svc-incident],[data-svc-done]");
            if (!t) { return; }
            var d = t.dataset;
            if (d.svcCheck) { openCheck(d.svcCheck); }
            else if (d.svcSubmit) { submitCheck(d.svcSubmit); }
            else if (d.svcRequest) { sendRequest(d.svcRequest, false); }
            else if (d.svcIncident) { sendRequest("incident_response", true); }
            else if (d.svcOpen) { openPage(d.svcOpen); }
            else if (d.svcDone) {
                api("/api/services/requests/" + encodeURIComponent(d.svcDone) + "/status", { status: "done" })
                    .then(loadRequests).catch(function () {});
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (data) {
                csrf = data.csrf;
                me = data.user;
                loadServices();
                if (isStaffAdmin()) { loadRequests(); }
            }).catch(function () {});
            document.querySelectorAll('.nav-button[data-page^="svc-"]').forEach(function (button) {
                button.addEventListener("click", function () {
                    loadServices();
                    if (isStaffAdmin()) { loadRequests(); }
                });
            });
        });
    })();
    </script>
    <!-- Autopilot -->
    <script>
    (function () {
        var csrf = "";
        var me = null;

        function $(id) { return document.getElementById(id); }

        function esc(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }

        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) {
                        var problem = new Error(data.error || "Something went wrong.");
                        problem.locked = !!data.locked;
                        throw problem;
                    }
                    return data;
                });
            });
        }

        function say(text, kind, withUnlock) {
            var box = $("ap-message");
            box.textContent = text || "";
            box.style.color = kind === "err" ? "#b42318" : kind === "ok" ? "#12906e" : "";
            if (text && withUnlock) {
                var unlock = document.createElement("button");
                unlock.type = "button";
                unlock.className = "btn-small";
                unlock.style.marginLeft = "12px";
                unlock.textContent = "Unlock with a plan";
                unlock.addEventListener("click", openBilling);
                box.appendChild(unlock);
            }
        }

        function openBilling() {
            var button = document.querySelector('.nav-button[data-page="billing"]');
            if (button) { button.click(); }
        }

        function ago(seconds) {
            if (seconds < 90) { return Math.max(0, seconds) + " seconds ago"; }
            if (seconds < 5400) { return Math.round(seconds / 60) + " minutes ago"; }
            return Math.round(seconds / 3600) + " hours ago";
        }

        function row(label, value) {
            return '<div class="status-item"><span>' + esc(label) + "</span><strong>" + esc(value) + "</strong></div>";
        }

        function renderStatus(d) {
            var checked = d.last_run ? new Date(d.last_run) : null;
            var age = checked ? Math.round((Date.now() - checked.getTime()) / 1000) : null;
            var colour = "#c47b00", text;
            if (!d.allowed) { text = "Autopilot is switched off for your plan. Unlock it so the software can fix problems by itself."; }
            else if (!d.laptops_total) { text = "No laptop is connected yet. Autopilot starts as soon as one is."; }
            else if (age === null) { text = "Waiting for the first check-in from a connected laptop."; }
            else if (age <= 180) { colour = "#12906e"; text = "Autopilot is running."; }
            else { text = "Autopilot is waiting: no laptop has checked in for " + Math.round(age / 60) + " minute(s)."; }
            $("ap-status-body").innerHTML = '<p style="font-size:18px;margin:0 0 8px"><span style="color:' + colour + '">&#9679;</span> <b>' + esc(text) + "</b></p>" +
                row("Last check", checked ? checked.toLocaleTimeString() + " (" + ago(age) + ")" : "Not yet") +
                row("Laptops online", d.laptops_online + " of " + d.laptops_total) +
                row("Actions in the last 24 hours", d.actions_24h);
        }

        function loadOwner() {
            api("/api/autopilot/all").then(function (d) {
                $("ap-owner").hidden = false;
                $("ap-owner-summary").innerHTML = row("Customers with Autopilot active (last 5 minutes)", d.companies_active) +
                    row("Actions across all customers (24 hours)", d.actions_24h);
                $("ap-owner-log").innerHTML = d.log.length ? d.log.map(function (l) {
                    return "<tr><td>" + esc(new Date(l.ts).toLocaleString()) + "</td><td>" + esc(l.company) + "</td><td><b>" + esc(l.action) + "</b></td><td>" + esc(l.detail) + "</td></tr>";
                }).join("") : '<tr><td colspan="4">Nothing yet.</td></tr>';
            }).catch(function () {});
        }

        function load() {
            api("/api/autopilot").then(function (data) {
                $("ap-lock").hidden = data.allowed;
                renderStatus(data);
                $("ap-rules").innerHTML = data.rules.map(function (r) {
                    return '<label class="status-item" style="align-items:flex-start;gap:14px;cursor:pointer">' +
                        '<input type="checkbox" data-ap-rule="' + esc(r.key) + '"' + (r.enabled ? " checked" : "") + ' style="margin-top:4px">' +
                        '<span style="flex:1"><b>' + esc(r.label) + "</b>" + (r.risky ? ' <span class="badge warning">Use with care</span>' : "") +
                        '<br><span class="rl-skills">' + esc(r.description) + "</span></span></label>";
                }).join("");
                $("ap-log").innerHTML = data.log.length ? data.log.map(function (l) {
                    return "<tr><td>" + esc(new Date(l.ts).toLocaleString()) + "</td><td><b>" + esc(l.action) + "</b></td><td>" + esc(l.detail) + "</td></tr>";
                }).join("") : '<tr><td colspan="3">Nothing yet. Autopilot acts as soon as a connected laptop reports a problem.</td></tr>';
            }).catch(function (problem) { say(problem.message, "err"); });
            if (me && me.is_platform && me.role === "admin") { loadOwner(); }
        }

        document.addEventListener("change", function (event) {
            var box = event.target;
            if (!box.dataset || !box.dataset.apRule) { return; }
            var wanted = box.checked;
            api("/api/autopilot/rule", { key: box.dataset.apRule, enabled: wanted }).then(function () {
                say(wanted ? "Turned on." : "Turned off.", "ok");
            }).catch(function (problem) {
                box.checked = !wanted;
                say(problem.message, "err", problem.locked);
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (data) { csrf = data.csrf; me = data.user; load(); }).catch(function () {});
            var nav = document.querySelector('.nav-button[data-page="autopilot"]');
            if (nav) { nav.addEventListener("click", load); }
            $("ap-unlock").addEventListener("click", openBilling);
            setInterval(function () { if (!$("autopilot").hidden) { load(); } }, 15000);
        });
    })();
    </script>
    <script src="consent.js"></script>
<!-- Settings -->
    <script>
    (function () {
        var csrf = "";
        var me = null;

        function $(id) { return document.getElementById(id); }

        function esc(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }

        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) { throw new Error(data.error || "Something went wrong."); }
                    return data;
                });
            });
        }

        function say(text, kind) {
            var box = $("st-message");
            box.textContent = text || "";
            box.style.color = kind === "err" ? "#b42318" : kind === "ok" ? "#12906e" : "";
        }

        function when(value) {
            var date = new Date(value);
            return isNaN(date) ? "" : date.toLocaleString();
        }

        function row(label, value) {
            return '<div class="status-item"><span>' + esc(label) + "</span><strong>" + esc(value) + "</strong></div>";
        }

        function isAdmin() { return !!(me && me.role === "admin"); }

        function loadProfile() {
            api("/api/account").then(function (p) {
                $("st-profile").innerHTML = row("Email", p.email) + row("Organisation", p.org) + row("Role", p.role) +
                    row("Account created", when(p.created_at)) + row("Last sign-in", when(p.last_login) || "This is your first sign-in");
                $("st-name").value = p.name;
            }).catch(function (problem) { say(problem.message, "err"); });
        }

        function loadSessions() {
            api("/api/account/sessions").then(function (rows) {
                $("st-sessions").innerHTML = rows.length ? rows.map(function (s) {
                    return "<tr><td><b>" + esc(s.device) + "</b>" + (s.current ? ' <span class="badge safe">This device</span>' : "") + "</td><td>" +
                        esc(s.ip || "") + "</td><td>" + esc(when(s.created_at)) + "</td><td>" + esc(when(s.last_seen)) + "</td><td>" +
                        (s.current ? "" : '<button type="button" class="btn-small" data-st-revoke="' + esc(s.id) + '">Sign out</button>') + "</td></tr>";
                }).join("") : '<tr><td colspan="5">No other devices.</td></tr>';
            }).catch(function (problem) { say(problem.message, "err"); });
        }

        function loadAudit() {
            if (!isAdmin()) { return; }
            var all = me.is_platform && $("st-all").checked;
            $("st-all-wrap").hidden = !me.is_platform;
            api("/api/account/audit" + (all ? "?all=1" : "")).then(function (rows) {
                $("st-audit-panel").hidden = false;
                $("st-audit").innerHTML = rows.length ? rows.map(function (r) {
                    return "<tr><td>" + esc(when(r.ts)) + "</td><td>" + esc(r.who) + (all && r.company ? " &middot; " + esc(r.company) : "") +
                        "</td><td><b>" + esc(r.action.replace(/_/g, " ")) + "</b></td><td>" + esc(r.detail || "") + "</td><td>" + esc(r.ip || "") + "</td></tr>";
                }).join("") : '<tr><td colspan="5">Nothing yet.</td></tr>';
            }).catch(function () {});
        }

        function loadAll() { loadProfile(); loadSessions(); loadAudit(); }

        function showName(name) {
            var label = name + (me.role === "admin" ? " (admin)" : "") + (me.is_platform ? "" : ", " + me.org);
            if ($("logged-user")) { $("logged-user").textContent = label; }
            if ($("avatar")) { $("avatar").textContent = name.trim().charAt(0).toUpperCase() || "M"; }
        }

        $("st-save-name").addEventListener("click", function () {
            var name = $("st-name").value;
            api("/api/account/profile", { name: name }).then(function (r) {
                showName(r.name);
                say("Name saved.", "ok");
                loadProfile();
            }).catch(function (problem) { say(problem.message, "err"); });
        });

        $("st-pw-save").addEventListener("click", function () {
            var next = $("st-pw-new").value;
            if (next !== $("st-pw-repeat").value) { say("The two new passwords do not match.", "err"); return; }
            api("/api/account/password", { current: $("st-pw-current").value, new: next }).then(function () {
                ["st-pw-current", "st-pw-new", "st-pw-repeat"].forEach(function (id) { $(id).value = ""; });
                say("Password changed. Every other device was signed out.", "ok");
                loadSessions();
            }).catch(function (problem) { say(problem.message, "err"); });
        });

        $("st-signout-others").addEventListener("click", function () {
            if (!window.confirm("Sign out of every other device?")) { return; }
            api("/api/account/sessions/revoke-others", {}).then(function (r) {
                say(r.count + " device(s) signed out.", "ok");
                loadSessions();
            }).catch(function (problem) { say(problem.message, "err"); });
        });

        document.addEventListener("click", function (event) {
            var button = event.target.closest("[data-st-revoke]");
            if (!button) { return; }
            api("/api/account/sessions/revoke", { id: Number(button.dataset.stRevoke) }).then(function () {
                say("Device signed out.", "ok");
                loadSessions();
            }).catch(function (problem) { say(problem.message, "err"); });
        });

        $("st-all").addEventListener("change", loadAudit);

        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (data) { csrf = data.csrf; me = data.user; }).catch(function () {});
            var nav = document.querySelector('.nav-button[data-page="settings"]');
            if (nav) { nav.addEventListener("click", function () { if (me) { loadAll(); } else { setTimeout(loadAll, 500); } }); }
        });
    })();
    </script>

    <!-- Ask Mellow -->
    <script>
    (function () {
        var csrf = "", history = [], busy = false;
        function $(id) { return document.getElementById(id); }
        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) { options.method = "POST"; options.headers["X-CSRF-Token"] = csrf; options.body = JSON.stringify(body); }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) { var problem = new Error(data.error || "Something went wrong."); problem.locked = !!data.locked; throw problem; }
                    return data;
                });
            });
        }
        function bubble(text, kind) {
            var div = document.createElement("div");
            div.className = "am-msg " + kind;
            div.textContent = text;
            $("am-log").appendChild(div);
            $("am-log").scrollTop = $("am-log").scrollHeight;
            return div;
        }
        function usage(data) { $("am-foot").textContent = "Questions used today: " + data.used + " of " + data.limit + ". Answers are guidance, not a guarantee. For an active attack, contact MellowTech support right away."; }
        function status() {
            api("/api/assistant/status").then(function (s) {
                $("am-locked").hidden = s.unlocked;
                $("am-main").hidden = !s.unlocked;
                if (s.unlocked) { usage(s); }
                if (s.unlocked && !s.configured) { $("am-message").textContent = "Ask Mellow is not switched on yet. MellowTech still needs to add its AI key."; }
                else { $("am-message").textContent = ""; }
                if (s.unlocked && !$("am-log").children.length) { bubble("Hello. I can explain your incidents and devices. What would you like to know?", "bot"); }
            }).catch(function (e) { $("am-message").textContent = e.message; });
        }
        function ask(question) {
            question = (question || "").trim();
            if (!question || busy) { return; }
            busy = true; $("am-send").disabled = true; $("am-hints").hidden = true;
            bubble(question, "me");
            var waiting = bubble("Thinking...", "bot");
            api("/api/assistant/ask", { question: question, history: history.slice(-6) }).then(function (r) {
                waiting.textContent = r.answer;
                history.push({ role: "user", text: question }, { role: "assistant", text: r.answer });
                usage(r);
            }).catch(function (e) {
                waiting.textContent = e.message; waiting.className = "am-msg bot err";
            }).then(function () { busy = false; $("am-send").disabled = false; $("am-input").focus(); });
        }
        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (d) { csrf = d.csrf; }).catch(function () {});
            var nav = document.querySelector('.nav-button[data-page="assistant"]');
            if (nav) { nav.addEventListener("click", status); }
            $("am-form").addEventListener("submit", function (event) {
                event.preventDefault();
                var q = $("am-input").value; $("am-input").value = ""; ask(q);
            });
            $("am-input").addEventListener("keydown", function (event) {
                if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); $("am-form").requestSubmit(); }
            });
            $("am-hints").addEventListener("click", function (event) { var b = event.target.closest("[data-q]"); if (b) { ask(b.dataset.q); } });
            $("am-upgrade").addEventListener("click", function () { var b = document.querySelector('.nav-button[data-page="billing"]'); if (b) { b.click(); } });
        });
    })();
    </script>

    <!-- Settings hub: tiles, team, security rules, alerts, company -->
    <script>
    (function () {
        var csrf = "", me = null, loaded = {};
        function $(id) { return document.getElementById(id); }
        function esc(value) {
            return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }
        function api(path, body) {
            var options = { credentials: "same-origin", headers: { "Content-Type": "application/json" } };
            if (body !== undefined) {
                options.method = "POST";
                options.headers["X-CSRF-Token"] = csrf;
                options.body = JSON.stringify(body);
            }
            return fetch(path, options).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    if (!response.ok) { throw new Error(data.error || "Something went wrong."); }
                    return data;
                });
            });
        }
        function say(text, kind) {
            var box = $("st-message");
            box.textContent = text || "";
            box.style.color = kind === "err" ? "#b42318" : kind === "ok" ? "#12906e" : "";
        }
        function fail(problem) { say(problem.message, "err"); }
        function when(value) { var d = new Date(value); return value && !isNaN(d) ? d.toLocaleString() : "Never"; }
        function isCompanyAdmin() { return !!(me && me.role === "admin" && !me.is_platform); }

        var ICON = {
            account: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c.6-3.8 3.4-6 7-6s6.4 2.2 7 6"/>',
            team: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c.5-3.6 3-5.5 6-5.5s5.5 1.9 6 5.5"/><path d="M16 5.2a3 3 0 0 1 0 5.6M18 14.8c1.7.7 2.8 2.4 3 5.2"/>',
            security: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
            alerts: '<path d="M6 17V11a6 6 0 0 1 12 0v6l1.5 2h-15z"/><path d="M10 21a2 2 0 0 0 4 0"/>',
            company: '<path d="M4 21V7l8-4 8 4v14"/><path d="M9 21v-6h6v6M9 10h.01M15 10h.01"/>',
            audit: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>',
            billing: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/>'
        };
        var SECTIONS = [
            { key: "account", title: "My account", text: "Your name, password and the devices signed in to your account.", color: "#e7f1ff;color:#1c5fd1", who: "all" },
            { key: "team", title: "Team and users", text: "Add people, change who can edit, and switch accounts off.", color: "#e6f7f1;color:#0b6b50", who: "admin" },
            { key: "security", title: "Security policies", text: "Idle sign-out, allowed IP addresses and sign everyone out.", color: "#ffeaea;color:#b4232f", who: "admin" },
            { key: "alerts", title: "Alerts and notifications", text: "Choose which incidents send an email, and to whom.", color: "#fff4e0;color:#a15c00", who: "admin" },
            { key: "company", title: "Company and integrations", text: "Company details and the tools you can connect.", color: "#efe8ff;color:#5b34c9", who: "admin" },
            { key: "audit", title: "Activity log", text: "Important actions on your company's accounts, newest first.", color: "#e9eef3;color:#2a3b4d", who: "admin" },
            { key: "billing", title: "Billing and plans", text: "Your plan, what it includes and how to pay.", color: "#e6f7f1;color:#0b6b50", who: "admin", go: "billing" }
        ];
        function visible() {
            return SECTIONS.filter(function (s) { return s.who === "all" || (me && me.role === "admin"); });
        }
        function icon(key, color) { return '<span class="stx-ico" style="background:' + color + '"><svg viewBox="0 0 24 24" aria-hidden="true">' + ICON[key] + "</svg></span>"; }

        function drawHub() {
            $("stx-tiles").innerHTML = visible().map(function (s) {
                return '<button type="button" class="stx-tile" data-stx="' + s.key + '">' + icon(s.key, s.color) +
                    "<span><b>" + esc(s.title) + '</b><span class="t">' + esc(s.text) + "</span></span></button>";
            }).join("");
        }
        function showHub() {
            $("st-detail").hidden = true;
            $("st-hub").hidden = false;
            say("");
        }
        function openSection(key) {
            var section = SECTIONS.filter(function (s) { return s.key === key; })[0];
            if (section && section.go) {
                var nav = document.querySelector('.nav-button[data-page="' + section.go + '"]');
                if (nav) { nav.click(); }
                return;
            }
            $("st-hub").hidden = true;
            $("st-detail").hidden = false;
            $("stx-subnav").innerHTML = visible().filter(function (s) { return !s.go; }).map(function (s) {
                return '<button type="button" data-stx-sub="' + s.key + '" class="' + (s.key === key ? "on" : "") + '">' + esc(s.title) + "</button>";
            }).join("");
            Array.prototype.forEach.call(document.querySelectorAll(".stx-pane"), function (p) { p.hidden = p.id !== "stx-p-" + key; });
            say("");
            if (key === "team") { loadTeam(); }
            if (key === "security" || key === "alerts" || key === "company") { loadSettings(); }
        }

        /* ---------- team ---------- */
        function loadTeam() {
            api("/api/team").then(function (rows) {
                $("stx-team-rows").innerHTML = rows.map(function (u) {
                    var role = u.you ? "<b>" + (u.role === "admin" ? "Administrator" : "Viewer") + "</b> (you)" :
                        '<select data-stx-role="' + u.id + '" aria-label="Role for ' + esc(u.name) + '"><option value="viewer"' + (u.role === "viewer" ? " selected" : "") +
                        '>Viewer</option><option value="admin"' + (u.role === "admin" ? " selected" : "") + ">Administrator</option></select>";
                    var action = u.you ? "" : '<button type="button" class="btn-small' + (u.active ? " btn-danger" : "") + '" data-stx-active="' + u.id + '" data-to="' + (u.active ? 0 : 1) + '">' + (u.active ? "Disable" : "Enable") + "</button>";
                    return "<tr><td><b>" + esc(u.name) + "</b></td><td>" + esc(u.email) + "</td><td>" + role + "</td><td>" + esc(when(u.last_login)) +
                        '</td><td><span class="badge ' + (u.active ? "safe" : "") + '">' + (u.active ? "Active" : "Disabled") + "</span></td><td>" + action + "</td></tr>";
                }).join("");
            }).catch(fail);
        }
        $("stx-inv-btn").addEventListener("click", function () {
            api("/api/team/invite", { name: $("stx-inv-name").value, email: $("stx-inv-email").value, role: $("stx-inv-role").value }).then(function (r) {
                $("stx-inv-name").value = ""; $("stx-inv-email").value = "";
                say(r.emailed ? "Teammate added. They were emailed a link to choose a password." : "Teammate added, but the email could not be sent. Check the email setup in settings.env.", r.emailed ? "ok" : "err");
                loadTeam();
            }).catch(fail);
        });

        /* ---------- security, alerts, company ---------- */
        function loadSettings() {
            api("/api/settings").then(function (s) {
                $("stx-idle").value = s.policy.idle_minutes ? String(s.policy.idle_minutes) : "";
                $("stx-ips").value = s.policy.allowed_ips.join("\n");
                $("stx-myip").textContent = s.policy.your_ip;
                $("stx-alert-on").checked = !!s.alerts.high_incidents;
                $("stx-alert-email").value = s.alerts.email || "";
                $("stx-co-name").value = s.profile.company || "";
                $("stx-co-email").value = s.profile.contact_email || "";
                $("stx-co-phone").value = s.profile.phone || "";
                $("stx-co-industry").value = s.profile.industry || "";
                $("stx-co-size").value = s.profile.company_size || "";
                $("stx-integrations").innerHTML = s.integrations.map(function (i) {
                    return '<div class="stx-int"><div><b>' + esc(i.name) + "</b><small style=\"display:block;color:#5b6b7b\">" + esc(i.note) + "</small></div>" +
                        '<span class="badge ' + (i.state === "on" ? "safe" : "") + '">' + (i.state === "on" ? "On" : "Coming soon") + "</span></div>";
                }).join("");
            }).catch(fail);
        }
        $("stx-addip").addEventListener("click", function () {
            var ips = $("stx-ips").value.split(/[\s,]+/).filter(Boolean), mine = $("stx-myip").textContent;
            if (mine && ips.indexOf(mine) === -1) { ips.push(mine); }
            $("stx-ips").value = ips.join("\n");
        });
        $("stx-pol-save").addEventListener("click", function () {
            api("/api/settings/policy", { idle_minutes: $("stx-idle").value, allowed_ips: $("stx-ips").value.split(/[\s,]+/).filter(Boolean) })
                .then(function () { say("Sign-in rules saved.", "ok"); loadSettings(); }).catch(fail);
        });
        $("stx-signout-all").addEventListener("click", function () {
            if (!window.confirm("Sign out everyone in your company except you?")) { return; }
            api("/api/settings/signout-others", {}).then(function () { say("Everyone else was signed out.", "ok"); }).catch(fail);
        });
        $("stx-alert-save").addEventListener("click", function () {
            api("/api/settings/alerts", { high_incidents: $("stx-alert-on").checked, email: $("stx-alert-email").value })
                .then(function () { say("Alert settings saved.", "ok"); }).catch(fail);
        });
        $("stx-co-save").addEventListener("click", function () {
            api("/api/settings/profile", { company: $("stx-co-name").value, contact_email: $("stx-co-email").value, phone: $("stx-co-phone").value,
                industry: $("stx-co-industry").value, company_size: $("stx-co-size").value })
                .then(function () { say("Company profile saved.", "ok"); if ($("logged-user") && me) { me.org = $("stx-co-name").value; } }).catch(fail);
        });

        /* ---------- clicks ---------- */
        document.addEventListener("click", function (event) {
            var tile = event.target.closest("[data-stx]");
            if (tile) { openSection(tile.dataset.stx); return; }
            var sub = event.target.closest("[data-stx-sub]");
            if (sub) { openSection(sub.dataset.stxSub); return; }
            var toggle = event.target.closest("[data-stx-active]");
            if (toggle) {
                api("/api/team/" + toggle.dataset.stxActive + "/active", { active: toggle.dataset.to === "1" })
                    .then(function () { say(toggle.dataset.to === "1" ? "Account enabled." : "Account disabled and signed out.", "ok"); loadTeam(); }).catch(fail);
            }
        });
        document.addEventListener("change", function (event) {
            var select = event.target.closest("[data-stx-role]");
            if (select) {
                api("/api/team/" + select.dataset.stxRole + "/role", { role: select.value })
                    .then(function () { say("Role changed. The person was signed out and must sign in again.", "ok"); loadTeam(); })
                    .catch(function (problem) { fail(problem); loadTeam(); });
            }
        });
        $("stx-back").addEventListener("click", showHub);

        document.addEventListener("DOMContentLoaded", function () {
            api("/api/auth/me").then(function (data) { csrf = data.csrf; me = data.user; drawHub(); }).catch(function () {});
            var nav = document.querySelector('.nav-button[data-page="settings"]');
            if (nav) {
                nav.addEventListener("click", function () {
                    if (me) { drawHub(); showHub(); }
                    else { setTimeout(function () { drawHub(); showHub(); }, 600); }
                });
            }
        });
    })();
    </script>
<script>
(function () {
    var MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>';
    var SUN = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
    var root = document.documentElement, btn = document.getElementById("theme-toggle");
    function paint() { btn.innerHTML = root.getAttribute("data-theme") === "dark" ? SUN : MOON; }
    btn.addEventListener("click", function () {
        var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("mt-theme", next); } catch (e) {}
        paint();
    });
    paint();
})();
</script>
<!-- Dashboard polish: greeting, stat icons, search -->
<script>
(function () {
    function $(id) { return document.getElementById(id); }
    function esc(v) { return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }

    /* greeting, date and clock */
    function tick() {
        var now = new Date(), h = now.getHours();
        var word = h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
        var who = ($("logged-user") ? $("logged-user").textContent : "").replace(/\s*\(.*$/, "").replace(/,.*$/, "").trim();
        if ($("dh-greet")) { $("dh-greet").textContent = word + (who && who !== "Admin" ? ", " + who : ""); }
        if ($("dh-date")) { $("dh-date").textContent = now.toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long", year: "numeric" }); }
        if ($("dh-time")) { $("dh-time").textContent = now.toLocaleTimeString(); }
        var src = $("ov-level"), dst = $("dh-level");
        if (src && dst) {
            dst.textContent = src.textContent;
            dst.style.color = { "Secure": "#3ddbb0", "Elevated": "#ffb454", "High": "#ff7a3d", "Critical": "#ff5b66" }[src.textContent] || "#3ddbb0";
        }
    }
    tick();
    setInterval(tick, 1000);

    /* icons on the four stat cards */
    var icons = ["i-laptop", "i-list", "i-flame", "i-shield"];
    document.querySelectorAll("#dashboard .stats-grid .stat-card").forEach(function (card, i) {
        if (card.querySelector(".dh-ico") || !icons[i]) { return; }
        var s = document.createElement("span");
        s.className = "dh-ico";
        s.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#' + icons[i] + '"/></svg>';
        card.appendChild(s);
    });

    /* search: pages, alerts and devices */
    var input = $("mt-search-input"), box = $("mt-search-results"), items = [], active = -1;
    if (!input || !box) { return; }

    function label(btn) {
        return Array.prototype.filter.call(btn.childNodes, function (n) { return n.nodeType === 3; })
            .map(function (n) { return n.textContent; }).join("").trim();
    }
    function go(page) {
        var b = document.querySelector('.nav-button[data-page="' + page + '"]');
        if (b) { b.click(); }
        close();
        input.value = "";
        input.blur();
    }
    function close() { box.hidden = true; active = -1; }
    function mark() {
        Array.prototype.forEach.call(box.querySelectorAll(".sr-item"), function (el, i) { el.classList.toggle("on", i === active); });
    }

    function gather(q) {
        var out = [];
        Array.prototype.filter.call(document.querySelectorAll(".nav-button"), function (b) {
            return !b.hidden && b.dataset.page && label(b).toLowerCase().indexOf(q) !== -1;
        }).slice(0, 7).forEach(function (b) { out.push({ group: "Pages", title: label(b), sub: "Open page", page: b.dataset.page }); });
        if (q) {
            var ev = (typeof lastEvents !== "undefined" && Array.isArray(lastEvents)) ? lastEvents : [];
            ev.filter(function (e) { return [e.type, e.device, e.id, e.severity, e.status, e.source_ip].join(" ").toLowerCase().indexOf(q) !== -1; })
              .slice(0, 5).forEach(function (e) { out.push({ group: "Alerts and events", title: e.type, sub: [e.device, e.severity, e.status].join(" \u00b7 "), page: "threats" }); });
            var dv = (typeof lastDevices !== "undefined" && Array.isArray(lastDevices)) ? lastDevices : [];
            dv.filter(function (d) { return [d.name, d.ip, d.os].join(" ").toLowerCase().indexOf(q) !== -1; })
              .slice(0, 5).forEach(function (d) { out.push({ group: "Devices", title: d.name, sub: [d.os, d.ip, d.online ? "Online" : "Offline"].join(" \u00b7 "), page: "devices" }); });
        }
        return out;
    }

    function render() {
        var q = input.value.trim().toLowerCase();
        items = gather(q);
        active = items.length ? 0 : -1;
        var html = "", last = "";
        if (!items.length) { html = '<div class="sr-empty">No matches for \u201c' + esc(input.value.trim()) + '\u201d.</div>'; }
        items.forEach(function (it, i) {
            if (it.group !== last) { html += '<div class="sr-group">' + esc(it.group) + "</div>"; last = it.group; }
            html += '<button type="button" class="sr-item" data-i="' + i + '"><b>' + esc(it.title) + "</b><small>" + esc(it.sub) + "</small></button>";
        });
        box.innerHTML = html;
        box.hidden = false;
        mark();
    }

    input.addEventListener("focus", render);
    input.addEventListener("input", render);
    input.addEventListener("keydown", function (e) {
        if (e.key === "ArrowDown") { e.preventDefault(); if (items.length) { active = (active + 1) % items.length; mark(); } }
        else if (e.key === "ArrowUp") { e.preventDefault(); if (items.length) { active = (active - 1 + items.length) % items.length; mark(); } }
        else if (e.key === "Enter") { e.preventDefault(); if (items[active]) { go(items[active].page); } }
        else if (e.key === "Escape") { close(); input.blur(); }
    });
    box.addEventListener("click", function (e) {
        var b = e.target.closest("[data-i]");
        if (b && items[Number(b.dataset.i)]) { go(items[Number(b.dataset.i)].page); }
    });
    document.addEventListener("click", function (e) {
        if (!e.target.closest("#mt-search")) { close(); }
        var g = e.target.closest("[data-goto]");
        if (g) { go(g.dataset.goto); }
    });
    document.addEventListener("keydown", function (e) {
        var tag = (document.activeElement && document.activeElement.tagName) || "";
        var typing = /INPUT|TEXTAREA|SELECT/.test(tag);
        if ((e.key === "/" && !typing) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k")) { e.preventDefault(); input.focus(); input.select(); }
    });
})();
</script>
<script id="mt-locks">
(function () {
    var CLOSED = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
    var OPEN = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 7.5-2"/></svg>';
    var FEATURE_PAGES = { docscan: "document_scan", autopilot: "autopilot", assistant: "assistant", scanner: "page_scanner", threats: "page_threats", network: "page_network" };
    var LOCK_CARD_PAGES = { scanner: "Vulnerability Scanner", threats: "Threat Detection", network: "Network Monitoring" };
    var plans = {};
    function get(url) { return fetch(url, { credentials: "same-origin" }).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; }); }
    function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ""; }

    function pill(page, needs) {
        var h = document.querySelector("#" + page + " h2");
        if (!h) { return; }
        var old = h.querySelector(".pkg-pill");
        if (old) { old.remove(); }
        var p = document.createElement("span");
        p.className = "pkg-pill";
        p.textContent = cap(needs) + " package";
        h.appendChild(p);
    }

    function pageLock(page, needs, unlocked, staff) {
        var sec = document.getElementById(page), name = LOCK_CARD_PAGES[page];
        if (!sec || !name) { return; }
        var card = sec.querySelector(".pg-lockcard");
        if (unlocked || staff) { sec.classList.remove("pg-locked"); if (card) { card.remove(); } return; }
        sec.classList.add("pg-locked");
        if (card) { return; }
        var info = plans[needs] || {};
        card = document.createElement("div");
        card.className = "panel pg-lockcard";
        card.innerHTML = '<div class="svc-lockicon">' + CLOSED + "</div><h3>" + name + " is locked</h3>" +
            "<p>This is part of <b>" + (info.name || cap(needs)) + "</b>" + (info.price ? " ($" + info.price + " / month)" : "") +
            ". It unlocks as soon as your payment goes through.</p>" +
            '<div class="actions" style="margin-top:14px"><button type="button" class="btn-small svc-unlock" data-svc-open="billing">Unlock with ' + (info.name || cap(needs)) + "</button></div>";
        var h = sec.querySelector("h2");
        if (h && h.nextSibling) { h.parentNode.insertBefore(card, h.nextSibling); } else { sec.appendChild(card); }
    }

    function mark(page, needs, unlocked, staff) {
        pill(page, needs);
        pageLock(page, needs, unlocked, staff);
        var b = document.querySelector('.nav-button[data-page="' + page + '"]');
        if (!b) { return; }
        var old = b.querySelector(".nav-lock");
        if (old) { old.remove(); }
        if (unlocked && !staff) { return; }          // paid for: no lock
        var tag = document.createElement("span");
        tag.className = "nav-lock" + (unlocked ? " open" : "");
        tag.innerHTML = (unlocked ? OPEN : CLOSED) + "<span>" + cap(needs) + "</span>";
        tag.title = unlocked ? "MellowTech staff access (customers need " + cap(needs) + ")" : "Locked: pay for " + cap(needs) + " to unlock";
        b.appendChild(tag);
    }

    function refresh() {
        Promise.all([get("/api/features"), get("/api/services"), get("/api/auth/me"), get("/api/billing")]).then(function (res) {
            if (res[3] && res[3].plans) { res[3].plans.forEach(function (p) { plans[p.key] = p; }); }
            var feats = res[0], svcs = res[1], staff = !!(res[2] && res[2].user && res[2].user.is_platform);
            if (feats && feats.features) {
                feats.features.forEach(function (f) {
                    Object.keys(FEATURE_PAGES).forEach(function (page) {
                        if (FEATURE_PAGES[page] === f.key) { mark(page, f.needs, f.unlocked, staff); }
                    });
                });
            }
            if (Array.isArray(svcs)) {
                svcs.forEach(function (s) { if (s.needs) { mark("svc-" + s.key, s.needs, s.unlocked !== false, staff); } });
            }
        });
    }
    document.addEventListener("DOMContentLoaded", function () {
        refresh();
        setInterval(function () { if (!document.hidden) { refresh(); } }, 30000);
        document.addEventListener("click", function (e) { if (e.target.closest(".nav-button")) { setTimeout(refresh, 400); } });
    });
})();
</script>
</body>
</html>