<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#07111d">
    <title>MellowTech | Reset Password</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2l9 3v7c0 5.5-3.8 8.6-9 10-5.2-1.4-9-4.5-9-10V5z' fill='%230d1b2a'/%3E%3Cpath d='M8 12l3 3 5-6' fill='none' stroke='%233ddbb0' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">

    <style>
        :root {
            --bg: #07111d; --ink: #0d1b2a; --text: #eaf2fb; --mute: #8fa6bf;
            --teal: #3ddbb0; --blue: #4aa8ff; --bad: #b42318; --ok: #12906e;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
            background:
                radial-gradient(900px 600px at 12% 8%, rgba(74,168,255,.16), transparent 60%),
                radial-gradient(800px 600px at 92% 92%, rgba(61,219,176,.14), transparent 60%),
                var(--bg);
            min-height: 100vh; display: flex; flex-direction: column;
            justify-content: center; align-items: center; padding: 24px; color: #17202a;
        }
        body::before {
            content: ""; position: fixed; inset: 0; pointer-events: none;
            background-image:
                linear-gradient(rgba(143,166,191,.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(143,166,191,.05) 1px, transparent 1px);
            background-size: 48px 48px;
            -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
        }
        .shell {
            position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr;
            width: min(920px, 100%); border-radius: 20px; overflow: hidden; background: #fff;
            box-shadow: 0 0 0 1px rgba(255,255,255,.06), 0 30px 80px rgba(0,0,0,.55), 0 0 90px rgba(61,219,176,.08);
            animation: rise .7s cubic-bezier(.22,1,.36,1) both;
        }
        .shell.shake { animation: shake .45s; }
        @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
        @keyframes shake {
            0%,100% { transform: translateX(0); } 20% { transform: translateX(-9px); }
            40% { transform: translateX(8px); } 60% { transform: translateX(-6px); } 80% { transform: translateX(4px); }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes pop { 0% { transform: scale(.6); opacity: 0; } 70% { transform: scale(1.08); } 100% { transform: scale(1); opacity: 1; } }

        /* ---------- brand side ---------- */
        .brand-panel {
            position: relative; display: flex; flex-direction: column; justify-content: space-between;
            gap: 28px; padding: 44px 38px 32px; color: var(--text); overflow: hidden;
            background:
                radial-gradient(500px 300px at 0% 0%, rgba(74,168,255,.22), transparent 65%),
                radial-gradient(420px 300px at 100% 100%, rgba(61,219,176,.18), transparent 65%),
                linear-gradient(160deg, #0f2236 0%, #0a1a2b 100%);
        }
        .mark { position: relative; width: 96px; height: 96px; margin-bottom: 20px; }
        .mark svg { position: absolute; inset: 0; width: 100%; height: 100%; }
        .ring { transform: rotate(-90deg); }
        .ring circle { fill: none; stroke-width: 6; }
        .ring .track { stroke: rgba(143,166,191,.18); }
        .ring .arc { stroke: var(--teal); stroke-linecap: round; stroke-dasharray: 327; stroke-dashoffset: 327;
            filter: drop-shadow(0 0 7px var(--teal)); animation: sweep 1.8s .3s cubic-bezier(.22,1,.36,1) forwards; }
        @keyframes sweep { to { stroke-dashoffset: 82; } }
        .shield { padding: 28px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
        .logo { font-size: 25px; font-weight: 700; letter-spacing: 3px; color: #fff; }
        .subtitle { margin-top: 3px; font-size: 11px; letter-spacing: 2.5px; color: var(--mute); }

        .steps { list-style: none; display: grid; gap: 0; position: relative; }
        .steps li { display: flex; gap: 14px; align-items: flex-start; padding-bottom: 20px; position: relative; opacity: .55; transition: opacity .3s; }
        .steps li:last-child { padding-bottom: 0; }
        .steps li:not(:last-child)::after {
            content: ""; position: absolute; left: 14px; top: 32px; bottom: 2px; width: 2px; background: rgba(143,166,191,.22);
        }
        .steps li.on, .steps li.done { opacity: 1; }
        .steps .n {
            flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center;
            font-size: 13px; font-weight: 700; color: var(--mute);
            border: 1px solid rgba(143,166,191,.35); background: rgba(255,255,255,.04);
        }
        .steps li.on .n { color: var(--teal); border-color: rgba(61,219,176,.6); background: rgba(61,219,176,.12); box-shadow: 0 0 0 4px rgba(61,219,176,.1); }
        .steps li.done .n { color: #07111d; background: var(--teal); border-color: var(--teal); }
        .steps b { display: block; font-size: 14px; color: #fff; margin-bottom: 2px; }
        .steps span { font-size: 13px; line-height: 1.5; color: var(--mute); }

        .chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .chip {
            display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 999px;
            font-size: 12px; font-weight: 600; color: var(--text);
            background: rgba(255,255,255,.06); border: 1px solid rgba(143,166,191,.22);
        }
        .chip svg { width: 14px; height: 14px; fill: none; stroke: var(--teal); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        /* ---------- form side ---------- */
        .form-panel { background: #fff; padding: 44px 42px 28px; display: flex; flex-direction: column; justify-content: center; }
        .greet { font-size: 12px; font-weight: 700; letter-spacing: 1.6px; color: var(--ok); text-transform: uppercase; margin-bottom: 8px; }
        h1 { font-size: 25px; margin-bottom: 6px; color: var(--ink); }
        .lead { font-size: 14px; color: #68737d; margin-bottom: 24px; line-height: 1.5; }

        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #25313d; }
        .field { position: relative; }
        .field > svg {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px;
            fill: none; stroke: #8a95a1; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; pointer-events: none;
        }
        input[type="email"], input[type="password"], input[type="text"] {
            width: 100%; padding: 13px 14px 13px 44px; border: 1.5px solid #d8dee3; border-radius: 10px;
            font-size: 15px; font-family: inherit; background: #fafbfc;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }
        input:focus { outline: none; border-color: var(--ink); background: #fff; box-shadow: 0 0 0 4px rgba(61,219,176,.28); }
        .pw-wrap input { padding-right: 66px; }
        .pw-toggle {
            position: absolute; right: 6px; top: 50%; transform: translateY(-50%); padding: 7px 10px;
            border: none; border-radius: 7px; background: transparent; color: #4a5560;
            font-size: 13px; font-weight: 600; cursor: pointer;
        }
        .pw-toggle:hover { background: #eef1f4; }

        .meter { display: flex; gap: 5px; margin-top: 8px; }
        .meter i { flex: 1; height: 4px; border-radius: 4px; background: #e4e9ee; transition: background .25s; }
        .meter-text { margin-top: 5px; font-size: 12px; color: #68737d; min-height: 16px; }
        .match { margin-top: 5px; font-size: 12px; font-weight: 600; min-height: 16px; }
        .match.ok { color: var(--ok); } .match.no { color: var(--bad); }

        .submit {
            position: relative; width: 100%; padding: 14px; margin-top: 4px; border: none; border-radius: 10px;
            background: linear-gradient(135deg, #0d1b2a 0%, #1d3550 100%); color: #fff;
            font-size: 15px; font-weight: 700; font-family: inherit; cursor: pointer; overflow: hidden;
            box-shadow: 0 8px 20px rgba(13,27,42,.28); transition: transform .15s, box-shadow .15s;
        }
        .submit::after {
            content: ""; position: absolute; top: 0; left: -80%; width: 50%; height: 100%;
            background: linear-gradient(100deg, transparent, rgba(255,255,255,.22), transparent);
            transform: skewX(-20deg); transition: left .6s;
        }
        .submit:hover { transform: translateY(-1px); box-shadow: 0 12px 26px rgba(13,27,42,.34); }
        .submit:hover::after { left: 130%; }
        .submit:disabled { opacity: .75; cursor: default; transform: none; }
        .spinner {
            display: none; width: 16px; height: 16px; margin-right: 9px; vertical-align: -3px;
            border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite;
        }
        .submit.busy .spinner { display: inline-block; }

        #message { margin-top: 14px; text-align: center; font-size: 13px; font-weight: 600; border-radius: 8px; line-height: 1.5; }
        #message.error { color: var(--bad); background: #fdecec; padding: 10px 12px; }
        #message.ok { color: var(--ok); background: #e6f7f1; padding: 12px; }

        /* success state */
        .done-box { text-align: center; padding: 6px 0 4px; }
        .done-icon {
            width: 72px; height: 72px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center;
            background: #e6f7f1; animation: pop .5s cubic-bezier(.22,1,.36,1) both;
        }
        .done-icon svg { width: 34px; height: 34px; fill: none; stroke: var(--ok); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
        .done-box h2 { font-size: 20px; color: var(--ink); margin-bottom: 8px; }
        .done-box p { font-size: 14px; color: #68737d; line-height: 1.6; }
        .done-box .mail { color: var(--ink); font-weight: 700; word-break: break-all; }
        .tips { margin: 16px 0 4px; padding: 12px 14px; border-radius: 10px; background: #f5f8fb; font-size: 12.5px; color: #55616d; line-height: 1.6; text-align: left; }
        .linkbtn {
            margin-top: 12px; background: none; border: none; font-family: inherit; font-size: 13px; font-weight: 700;
            color: var(--ink); cursor: pointer; text-decoration: underline;
        }
        .linkbtn:disabled { color: #9aa4ae; text-decoration: none; cursor: default; }
        .ghost {
            display: inline-block; margin-top: 16px; padding: 12px 22px; border-radius: 10px; border: 1.5px solid #d8dee3;
            text-decoration: none; font-weight: 700; font-size: 14px; color: var(--ink); transition: border-color .15s, transform .15s;
        }
        .ghost:hover { border-color: var(--ink); transform: translateY(-1px); }

        .back { margin-top: 20px; text-align: center; font-size: 13px; color: #4a5560; }
        .back a { color: var(--ink); font-weight: 700; text-decoration: none; }
        .back a:hover { text-decoration: underline; }
        .security-note {
            margin-top: 18px; padding-top: 14px; border-top: 1px solid #eef1f4;
            display: flex; justify-content: center; align-items: center; gap: 8px;
            color: #7b858e; font-size: 11px; line-height: 1.5; text-align: center;
        }
        .security-note svg { width: 14px; height: 14px; flex: none; fill: none; stroke: #7b858e; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .page-foot { position: relative; z-index: 1; margin-top: 18px; font-size: 12px; color: var(--mute); }
        [hidden] { display: none !important; }

        @media (max-width: 820px) {
            .shell { grid-template-columns: 1fr; }
            .brand-panel { padding: 24px; gap: 16px; }
            .steps, .chips { display: none; }
            .mark { width: 64px; height: 64px; margin-bottom: 10px; }
            .shield { padding: 18px; }
            .form-panel { padding: 30px 24px 22px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .shell, .shell.shake, .ring .arc, .spinner, .done-icon { animation: none; }
            .ring .arc { stroke-dashoffset: 82; }
        }
    </style>
</head>

<body>
    <div class="shell" id="shell">

        <!-- ========== BRAND SIDE ========== -->
        <aside class="brand-panel">
            <div>
                <div class="mark" aria-hidden="true">
                    <svg class="ring" viewBox="0 0 120 120">
                        <circle class="track" cx="60" cy="60" r="52"/>
                        <circle class="arc" cx="60" cy="60" r="52"/>
                    </svg>
                    <svg class="shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                </div>
                <div class="logo">MELLOWTECH</div>
                <div class="subtitle">CYBERSECURITY PLATFORM</div>
            </div>

            <ol class="steps" id="steps">
                <li id="step1" class="on"><span class="n">1</span><div><b>Request a reset link</b><span>Enter the email you signed up with.</span></div></li>
                <li id="step2"><span class="n">2</span><div><b>Open the email</b><span>The link works once and expires in 30 minutes.</span></div></li>
                <li id="step3"><span class="n">3</span><div><b>Choose a new password</b><span>Pick a strong one and sign back in.</span></div></li>
            </ol>

            <div class="chips">
                <span class="chip"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>One-time secure link</span>
                <span class="chip"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>Other devices signed out</span>
            </div>
        </aside>

        <!-- ========== FORM SIDE ========== -->
        <main class="form-panel">

            <!-- STEP 1: ask for a link -->
            <div id="ask-area">
                <div class="greet">Account recovery</div>
                <h1>Forgot Password?</h1>
                <p class="lead">No problem. Enter your email and we will send you a secure link to reset it.</p>

                <form id="ask-form" novalidate>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <div class="field">
                            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                            <input type="email" id="email" placeholder="you@company.co.za" autocomplete="email"
                                   autocapitalize="none" spellcheck="false" required autofocus>
                        </div>
                    </div>
                    <button type="submit" class="submit" id="ask-button"><span class="spinner" aria-hidden="true"></span><span id="ask-label">Send Reset Link</span></button>
                </form>
            </div>

            <!-- STEP 1 done: link sent -->
            <div id="sent-area" hidden>
                <div class="done-box">
                    <div class="done-icon"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></div>
                    <h2>Check your inbox</h2>
                    <p>If <span class="mail" id="sent-email"></span> has an account, a reset link is on its way.</p>
                    <div class="tips">
                        &bull; The link works once and expires in 30 minutes.<br>
                        &bull; Can&rsquo;t see it? Look in your spam or junk folder.<br>
                        &bull; Testing on your own computer? The link is printed in the black server window.
                    </div>
                    <button type="button" class="linkbtn" id="resend" disabled>Send again</button>
                </div>
            </div>

            <!-- STEP 3: choose a new password -->
            <div id="new-area" hidden>
                <div class="greet">Almost there</div>
                <h1>Choose a New Password</h1>
                <p class="lead">Pick a strong password you have not used before.</p>

                <form id="new-form" novalidate>
                    <div class="form-group">
                        <label for="password">New password</label>
                        <div class="field pw-wrap">
                            <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
                            <input type="password" id="password" placeholder="At least 10 characters" autocomplete="new-password" maxlength="128" required>
                            <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password">Show</button>
                        </div>
                        <div class="meter" id="meter"><i></i><i></i><i></i><i></i></div>
                        <div class="meter-text" id="meter-text">Use 10 or more characters with a mix of letters and numbers.</div>
                    </div>

                    <div class="form-group">
                        <label for="password2">Repeat new password</label>
                        <div class="field">
                            <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
                            <input type="password" id="password2" placeholder="Type the password again" autocomplete="new-password" maxlength="128" required>
                        </div>
                        <div class="match" id="match"></div>
                    </div>

                    <button type="submit" class="submit" id="new-button"><span class="spinner" aria-hidden="true"></span><span id="new-label">Save New Password</span></button>
                </form>
            </div>

            <!-- final success -->
            <div id="success-area" hidden>
                <div class="done-box">
                    <div class="done-icon"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg></div>
                    <h2>Password updated</h2>
                    <p>Your password has been changed and your other sessions were signed out.<br>
                       Taking you to sign in in <b id="count">4</b>&hellip;</p>
                    <a class="ghost" href="login.html">Sign in now</a>
                </div>
            </div>

            <div id="message" role="alert"></div>

            <p class="back" id="back-link"><a href="login.html">&larr; Back to sign in</a></p>

            <div class="security-note">
                <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>
                <span>MellowTech Security Environment. Reset requests are logged.</span>
            </div>
        </main>
    </div>

    <div class="page-foot">&copy; 2026 MellowTech (Pty) Ltd. All rights reserved.</div>

    <script>
        var token = new URLSearchParams(window.location.search).get("token");

        function el(id) { return document.getElementById(id); }

        function show(text, kind) {
            var box = el("message");
            box.textContent = text;
            box.className = kind || "";
        }

        function shake() {
            var shell = el("shell");
            shell.classList.remove("shake");
            void shell.offsetWidth;
            shell.classList.add("shake");
        }

        function busy(buttonId, labelId, on, idle, working) {
            var b = el(buttonId);
            b.disabled = on;
            b.classList.toggle("busy", on);
            el(labelId).textContent = on ? working : idle;
        }

        function setStep(n) {
            ["step1", "step2", "step3"].forEach(function (id, i) {
                var li = el(id);
                li.className = i + 1 < n ? "done" : (i + 1 === n ? "on" : "");
                li.querySelector(".n").textContent = i + 1 < n ? "\u2713" : String(i + 1);
            });
        }

        async function post(path, body) {
            var response = await fetch(path, {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });
            var data = await response.json().catch(function () { return null; });
            return { ok: response.ok, status: response.status, data: data };
        }

        function wrongServer(status) {
            return "The server sent an unexpected reply (error " + status + "). Open this page at http://127.0.0.1:5000/reset.html";
        }

        /* ---------- which screen to start on ---------- */
        if (token) {
            el("ask-area").hidden = true;
            el("new-area").hidden = false;
            setStep(3);
        }

        /* ---------- ask for a reset link ---------- */
        var cooldownTimer = null;

        function startCooldown() {
            var left = 45;
            var btn = el("resend");
            btn.disabled = true;
            clearInterval(cooldownTimer);
            btn.textContent = "Send again in " + left + "s";
            cooldownTimer = setInterval(function () {
                left--;
                if (left <= 0) {
                    clearInterval(cooldownTimer);
                    btn.disabled = false;
                    btn.textContent = "Send again";
                } else {
                    btn.textContent = "Send again in " + left + "s";
                }
            }, 1000);
        }

        async function requestLink(email, fromResend) {
            var idle = "Send Reset Link";
            if (!fromResend) { busy("ask-button", "ask-label", true, idle, "Sending..."); }
            show("", "");

            try {
                var result = await post("/api/auth/forgot", { email: email });

                if (result.data === null) {
                    show(wrongServer(result.status), "error");
                    shake();
                    busy("ask-button", "ask-label", false, idle, "");
                    return;
                }
                if (!result.ok) {
                    show(result.data.error || "Something went wrong. Please try again.", "error");
                    shake();
                    busy("ask-button", "ask-label", false, idle, "");
                    return;
                }

                el("ask-area").hidden = true;
                el("sent-area").hidden = false;
                el("sent-email").textContent = email;
                setStep(2);
                startCooldown();
                if (fromResend) { show("A new link was requested.", "ok"); }

            } catch (error) {
                show("Cannot reach the server. Start it with: python app.py, then open http://127.0.0.1:5000", "error");
                shake();
                busy("ask-button", "ask-label", false, idle, "");
            }
        }

        el("ask-form").addEventListener("submit", function (event) {
            event.preventDefault();
            var email = el("email").value.trim();
            if (email.indexOf("@") < 1) {
                show("Please enter a valid email address.", "error");
                shake();
                return;
            }
            requestLink(email, false);
        });

        el("resend").addEventListener("click", function () {
            requestLink(el("sent-email").textContent, true);
        });

        /* ---------- password strength + match ---------- */
        var pw = el("password");
        var pw2 = el("password2");
        var colors = ["#d92d20", "#f79009", "#d4a017", "#12b76a"];
        var words = ["Too weak", "Weak", "Fair", "Good", "Strong"];

        function score(p) {
            var s = 0;
            if (p.length >= 10) s++;
            if (p.length >= 14) s++;
            if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++;
            if (/\d/.test(p) && /[^A-Za-z0-9]/.test(p)) s++;
            return p.length < 10 ? Math.min(s, 1) : s;
        }

        function updateMeter() {
            var p = pw.value;
            var bars = document.querySelectorAll("#meter i");
            var text = el("meter-text");
            if (!p) {
                bars.forEach(function (b) { b.style.background = ""; });
                text.textContent = "Use 10 or more characters with a mix of letters and numbers.";
                return;
            }
            var s = score(p);
            bars.forEach(function (b, i) { b.style.background = i < s ? colors[Math.max(s - 1, 0)] : ""; });
            text.textContent = p.length < 10 ? "Too short: use at least 10 characters." : "Strength: " + words[s];
        }

        function updateMatch() {
            var box = el("match");
            if (!pw2.value) { box.textContent = ""; box.className = "match"; return; }
            var same = pw.value === pw2.value;
            box.textContent = same ? "Passwords match" : "Passwords do not match yet";
            box.className = "match " + (same ? "ok" : "no");
        }

        pw.addEventListener("input", function () { updateMeter(); updateMatch(); });
        pw2.addEventListener("input", updateMatch);

        el("pw-toggle").addEventListener("click", function () {
            var reveal = pw.type === "password";
            pw.type = reveal ? "text" : "password";
            pw2.type = pw.type;
            this.textContent = reveal ? "Hide" : "Show";
            this.setAttribute("aria-label", reveal ? "Hide password" : "Show password");
        });

        /* ---------- save the new password ---------- */
        el("new-form").addEventListener("submit", async function (event) {
            event.preventDefault();
            var idle = "Save New Password";

            if (pw.value.length < 10) { show("Use at least 10 characters for your password.", "error"); shake(); return; }
            if (pw.value !== pw2.value) { show("The two passwords do not match.", "error"); shake(); return; }

            busy("new-button", "new-label", true, idle, "Saving...");
            show("", "");

            try {
                var result = await post("/api/auth/reset", { token: token, password: pw.value });

                if (result.data === null) {
                    show(wrongServer(result.status), "error");
                    shake();
                    busy("new-button", "new-label", false, idle, "");
                    return;
                }
                if (!result.ok) {
                    show(result.data.error || "Could not change the password. Please request a new link.", "error");
                    shake();
                    busy("new-button", "new-label", false, idle, "");
                    return;
                }

                el("new-area").hidden = true;
                el("back-link").hidden = true;
                el("success-area").hidden = false;
                show("", "");
                setStep(4);

                var left = 4;
                var timer = setInterval(function () {
                    left--;
                    el("count").textContent = String(left);
                    if (left <= 0) {
                        clearInterval(timer);
                        window.location.href = "/login.html";
                    }
                }, 1000);

            } catch (error) {
                show("Cannot reach the server. Start it with: python app.py, then open http://127.0.0.1:5000", "error");
                shake();
                busy("new-button", "new-label", false, idle, "");
            }
        });
    </script>
</body>
</html>