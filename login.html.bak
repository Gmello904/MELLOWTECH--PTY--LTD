 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        /* Stops VS Code Live Server's auto-reload socket (it caused an endless reload loop). */
        (function () {
            var Native = window.WebSocket;
            if (!Native) return;
            function Blocked() {
                window.__mtLiveReloadBlocked = true;
                return { readyState: 3, close: function () {}, send: function () {},
                         addEventListener: function () {}, removeEventListener: function () {} };
            }
            window.WebSocket = function (url, protocols) {
                if (/\/ws$/.test(String(url).split("?")[0])) return Blocked();
                return protocols === undefined ? new Native(url) : new Native(url, protocols);
            };
            window.WebSocket.prototype = Native.prototype;
            ["CONNECTING", "OPEN", "CLOSING", "CLOSED"].forEach(function (k, i) { window.WebSocket[k] = i; });
        })();
    </script>
    <meta name="theme-color" content="#07111d">
    <title>MellowTech | Secure Sign In</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2l9 3v7c0 5.5-3.8 8.6-9 10-5.2-1.4-9-4.5-9-10V5z' fill='%230d1b2a'/%3E%3Cpath d='M8 12l3 3 5-6' fill='none' stroke='%233ddbb0' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">

    <style>
        :root {
            --bg: #07111d;
            --ink: #0d1b2a;
            --well: #0f2236;
            --line: #26405c;
            --text: #eaf2fb;
            --mute: #8fa6bf;
            --teal: #3ddbb0;
            --blue: #4aa8ff;
            --bad: #b42318;
            --ok: #12906e;
            --warn: #92560a;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { min-height: 100%; }

        body {
            font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
            background:
                radial-gradient(900px 600px at 12% 8%, rgba(74, 168, 255, .16), transparent 60%),
                radial-gradient(800px 600px at 92% 92%, rgba(61, 219, 176, .14), transparent 60%),
                var(--bg);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
            color: #17202a;
            overflow-x: hidden;
        }

        /* subtle grid + animated network background */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(143, 166, 191, .05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(143, 166, 191, .05) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
            -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
            pointer-events: none;
        }

        #bg-canvas {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        /* ---------- Card ---------- */
        .shell {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            width: min(940px, 100%);
            border-radius: 20px;
            overflow: hidden;
            background: #fff;
            box-shadow:
                0 0 0 1px rgba(255, 255, 255, .06),
                0 30px 80px rgba(0, 0, 0, .55),
                0 0 90px rgba(61, 219, 176, .08);
            animation: rise .7s cubic-bezier(.22, 1, .36, 1) both;
        }

        .shell.shake { animation: shake .45s; }

        @keyframes rise {
            from { opacity: 0; transform: translateY(18px) scale(.985); }
            to { opacity: 1; transform: none; }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-9px); }
            40% { transform: translateX(8px); }
            60% { transform: translateX(-6px); }
            80% { transform: translateX(4px); }
        }

        /* ---------- Brand side ---------- */
        .brand-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 28px;
            padding: 44px 40px 32px;
            color: var(--text);
            background:
                radial-gradient(500px 300px at 0% 0%, rgba(74, 168, 255, .22), transparent 65%),
                radial-gradient(420px 300px at 100% 100%, rgba(61, 219, 176, .18), transparent 65%),
                linear-gradient(160deg, #0f2236 0%, #0a1a2b 100%);
            overflow: hidden;
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            right: -140px;
            top: -140px;
            border-radius: 50%;
            border: 1px solid rgba(143, 166, 191, .12);
            box-shadow: 0 0 0 40px rgba(143, 166, 191, .04), 0 0 0 80px rgba(143, 166, 191, .025);
            pointer-events: none;
        }

        .brand-top { position: relative; z-index: 1; }

        .mark { position: relative; width: 112px; height: 112px; margin-bottom: 22px; }
        .mark svg { position: absolute; inset: 0; width: 100%; height: 100%; }
        .ring { transform: rotate(-90deg); }
        .ring circle { fill: none; stroke-width: 6; }
        .ring .track { stroke: rgba(143, 166, 191, .18); }
        .ring .arc {
            stroke: var(--teal);
            stroke-linecap: round;
            stroke-dasharray: 327;
            stroke-dashoffset: 327;
            filter: drop-shadow(0 0 7px var(--teal));
            animation: sweep 1.8s .3s cubic-bezier(.22, 1, .36, 1) forwards;
        }
        .ring-spin { animation: spin 14s linear infinite; transform-origin: 50% 50%; }
        .ring-spin circle { fill: none; stroke: rgba(74, 168, 255, .35); stroke-width: 1; stroke-dasharray: 3 9; }
        .shield { padding: 32px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

        @keyframes sweep { to { stroke-dashoffset: 82; } }
        @keyframes spin { to { transform: rotate(360deg); } }

        .logo { font-size: 26px; font-weight: 700; letter-spacing: 3px; color: #fff; }
        .subtitle { margin-top: 3px; font-size: 11px; letter-spacing: 2.5px; color: var(--mute); }

        /* rotating feature carousel */
        .features { position: relative; z-index: 1; }

        .slide-box { position: relative; min-height: 112px; }

        .slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity .6s, transform .6s;
            pointer-events: none;
        }

        .slide.on { opacity: 1; transform: none; pointer-events: auto; }

        .slide h3 { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 650; color: #fff; margin-bottom: 8px; }
        .slide h3 svg { width: 20px; height: 20px; fill: none; stroke: var(--teal); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
        .slide p { font-size: 14px; line-height: 1.6; color: var(--mute); max-width: 36ch; }

        .dots { display: flex; gap: 8px; margin-top: 14px; }
        .dot {
            width: 22px; height: 4px; border: 0; border-radius: 4px; padding: 0;
            background: rgba(143, 166, 191, .28); cursor: pointer; transition: background .3s, width .3s;
        }
        .dot.on { background: var(--teal); width: 36px; }
        .dot:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }

        /* status chips */
        .chips { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 8px; }

        .chip {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 6px 12px; border-radius: 999px;
            font-size: 12px; font-weight: 600; color: var(--text);
            background: rgba(255, 255, 255, .06);
            border: 1px solid rgba(143, 166, 191, .22);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }

        .chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--mute); }
        .chip.live i { background: var(--teal); box-shadow: 0 0 0 0 rgba(61, 219, 176, .6); animation: pulse 2s infinite; }
        .chip.down i { background: #ff6b6b; }
        .chip svg { width: 14px; height: 14px; fill: none; stroke: var(--teal); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(61, 219, 176, .55); }
            70% { box-shadow: 0 0 0 8px rgba(61, 219, 176, 0); }
            100% { box-shadow: 0 0 0 0 rgba(61, 219, 176, 0); }
        }

        /* ---------- Form side ---------- */
        .form-panel {
            background: #fff;
            padding: 44px 42px 28px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .greet { font-size: 12px; font-weight: 700; letter-spacing: 1.6px; color: var(--ok); text-transform: uppercase; margin-bottom: 8px; }
        h1 { font-size: 26px; margin-bottom: 6px; color: var(--ink); letter-spacing: -.2px; }
        .lead { font-size: 14px; color: #68737d; margin-bottom: 26px; }

        .form-group { margin-bottom: 16px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 7px; color: #25313d; }

        .field { position: relative; }
        .field > svg {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            width: 18px; height: 18px; fill: none; stroke: #8a95a1; stroke-width: 1.8;
            stroke-linecap: round; stroke-linejoin: round; pointer-events: none; transition: stroke .15s;
        }

        input[type="email"], input[type="password"], input[type="text"] {
            width: 100%;
            padding: 13px 14px 13px 44px;
            border: 1.5px solid #d8dee3;
            border-radius: 10px;
            font-size: 15px;
            font-family: inherit;
            background: #fafbfc;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }

        input:focus { outline: none; border-color: var(--ink); background: #fff; box-shadow: 0 0 0 4px rgba(61, 219, 176, .28); }
        .field:focus-within > svg { stroke: var(--ink); }

        .pw-wrap input { padding-right: 68px; }
        .pw-toggle {
            position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
            padding: 7px 10px; border: none; border-radius: 7px;
            background: transparent; color: #4a5560; font-size: 13px; font-weight: 600; cursor: pointer;
        }
        .pw-toggle:hover { background: #eef1f4; }
        .pw-toggle:focus-visible, .login-button:focus-visible { outline: 3px solid var(--teal); outline-offset: 2px; }

        .hint { margin-top: 7px; font-size: 12px; color: var(--warn); font-weight: 600; }

        .row-between { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 2px 0 18px; font-size: 13px; }
        .remember { display: flex; align-items: center; gap: 8px; color: #4a5560; cursor: pointer; user-select: none; }
        .remember input { width: 16px; height: 16px; accent-color: var(--ink); cursor: pointer; }
        .row-between a { color: var(--ink); font-weight: 600; text-decoration: none; }
        .row-between a:hover { text-decoration: underline; }

        .login-button {
            position: relative;
            width: 100%; padding: 14px;
            border: none; border-radius: 10px;
            background: linear-gradient(135deg, #0d1b2a 0%, #1d3550 100%);
            color: #fff;
            font-size: 15px; font-weight: 700; font-family: inherit; letter-spacing: .3px; cursor: pointer;
            box-shadow: 0 8px 20px rgba(13, 27, 42, .28);
            transition: transform .15s, box-shadow .15s, filter .15s;
            overflow: hidden;
        }
        .login-button::after {
            content: "";
            position: absolute; top: 0; left: -80%; width: 50%; height: 100%;
            background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .22), transparent);
            transform: skewX(-20deg);
            transition: left .6s;
        }
        .login-button:hover { transform: translateY(-1px); box-shadow: 0 12px 26px rgba(13, 27, 42, .34); }
        .login-button:hover::after { left: 130%; }
        .login-button:active { transform: translateY(0); }
        .login-button:disabled { opacity: .75; cursor: default; transform: none; }

        .spinner {
            display: none;
            width: 16px; height: 16px; margin-right: 9px; vertical-align: -3px;
            border: 2px solid rgba(255, 255, 255, .35); border-top-color: #fff; border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        .login-button.busy .spinner { display: inline-block; }

        #login-message {
            min-height: 20px; margin-top: 14px; padding: 0; text-align: center;
            font-size: 13px; font-weight: 600; border-radius: 8px;
        }
        #login-message.error { color: var(--bad); background: #fdecec; padding: 10px 12px; }
        #login-message.ok { color: var(--ok); background: #e6f7f1; padding: 10px 12px; }

        .or { display: flex; align-items: center; gap: 12px; margin: 20px 0 14px; font-size: 12px; color: #7b858e; }
        .or::before, .or::after { content: ""; flex: 1; height: 1px; background: #e4e9ee; }

        .social-row { display: flex; gap: 10px; }
        .social-button {
            flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px;
            padding: 11px; border: 1.5px solid #d8dee3; border-radius: 10px; background: #fff;
            text-decoration: none; font-size: 14px; font-weight: 600; color: var(--ink);
            transition: border-color .15s, background-color .15s, transform .15s, box-shadow .15s;
        }
        .social-button svg { width: 18px; height: 18px; flex: none; }
        .social-button:hover { border-color: var(--ink); background: #f5f8fb; transform: translateY(-1px); box-shadow: 0 6px 14px rgba(13, 27, 42, .08); }
        .social-button:focus-visible { outline: 3px solid var(--teal); outline-offset: 2px; }

        .register { margin-top: 18px; text-align: center; font-size: 13px; color: #4a5560; }
        .register a { color: var(--ink); font-weight: 700; }

        .security-note {
            margin-top: 20px; padding-top: 16px; border-top: 1px solid #eef1f4;
            display: flex; justify-content: center; align-items: center; gap: 8px;
            color: #7b858e; font-size: 11px; line-height: 1.5; text-align: center;
        }
        .security-note svg { width: 14px; height: 14px; flex: none; fill: none; stroke: #7b858e; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

        .foot { margin-top: 10px; text-align: center; font-size: 11px; color: #9aa4ae; }

        .page-foot {
            position: relative; z-index: 1;
            margin-top: 18px; text-align: center; font-size: 12px; color: var(--mute);
        }

        body { flex-direction: column; }

        @media (max-width: 800px) {
            .shell { grid-template-columns: 1fr; }
            .brand-panel { padding: 26px 24px; gap: 16px; }
            .mark { width: 72px; height: 72px; margin-bottom: 12px; }
            .shield { padding: 20px; }
            .slide-box { min-height: 96px; }
            .features .dots { margin-top: 8px; }
            .form-panel { padding: 32px 24px 24px; }
        }

        @media (max-width: 480px) {
            .chips { display: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            .shell, .shell.shake { animation: none; }
            .ring .arc { animation: none; stroke-dashoffset: 82; }
            .ring-spin, .chip.live i, .spinner { animation: none; }
            .slide { transition: none; }
            input, .login-button, .social-button { transition: none; }
        }
    </style>
</head>

<body>
    <canvas id="bg-canvas" aria-hidden="true"></canvas>

    <div class="shell" id="shell">

        <!-- ========== BRAND SIDE ========== -->
        <aside class="brand-panel">

            <div class="brand-top">
                <div class="mark" aria-hidden="true">
                    <svg class="ring-spin" viewBox="0 0 120 120"><circle cx="60" cy="60" r="57"/></svg>
                    <svg class="ring" viewBox="0 0 120 120">
                        <circle class="track" cx="60" cy="60" r="52" stroke-dasharray="327"/>
                        <circle class="arc" cx="60" cy="60" r="52"/>
                    </svg>
                    <svg class="shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                </div>
                <div class="logo">MELLOWTECH</div>
                <div class="subtitle">CYBERSECURITY PLATFORM</div>
            </div>

            <div class="features">
                <div class="slide-box" id="slides" aria-live="off">
                    <div class="slide on">
                        <h3><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/></svg>Live device protection</h3>
                        <p>Watch every connected laptop in real time, run virus scans and isolate a threat with one click.</p>
                    </div>
                    <div class="slide">
                        <h3><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>Instant threat blocking</h3>
                        <p>Block an attacking address on all your laptops at once. It lifts itself when the time is up.</p>
                    </div>
                    <div class="slide">
                        <h3><svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M2 20h20"/></svg>Clear security insight</h3>
                        <p>Alerts sorted by severity, a full activity log and a plan that grows with your business.</p>
                    </div>
                </div>
                <div class="dots" id="dots" role="tablist" aria-label="Platform highlights">
                    <button type="button" class="dot on" aria-label="Show highlight 1"></button>
                    <button type="button" class="dot" aria-label="Show highlight 2"></button>
                    <button type="button" class="dot" aria-label="Show highlight 3"></button>
                </div>
            </div>

            <div class="chips">
                <span class="chip" id="server-chip"><i></i><span id="server-text">Checking server...</span></span>
                <span class="chip"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>Encrypted sessions</span>
                <span class="chip"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>Activity logged</span>
            </div>

        </aside>

        <!-- ========== FORM SIDE ========== -->
        <main class="form-panel">

            <div class="greet" id="greeting">Welcome back</div>
            <h1>Administrator Login</h1>
            <p class="lead">Sign in to open the security dashboard.</p>

            <form onsubmit="login(event)" novalidate>
                <div class="form-group">
                    <label for="username">Email</label>
                    <div class="field">
                        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                        <input type="email" id="username" placeholder="you@company.co.za"
                               autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="field pw-wrap">
                        <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
                        <input type="password" id="password" placeholder="Enter password"
                               autocomplete="current-password" aria-describedby="caps-warning" required>
                        <button type="button" class="pw-toggle" id="pw-toggle"
                                aria-label="Show password" aria-pressed="false">Show</button>
                    </div>
                    <p class="hint" id="caps-warning" hidden>Caps Lock is on.</p>
                </div>

                <div class="row-between">
                    <label class="remember"><input type="checkbox" id="remember"> Remember my email</label>
                    <a href="reset.html">Forgot password?</a>
                </div>

                <button type="submit" class="login-button" id="login-button"><span class="spinner" aria-hidden="true"></span><span id="login-label">Sign In</span></button>
            </form>

            <div id="login-message" role="alert"></div>

            <div id="social" hidden>
                <p class="or">or continue with</p>
                <div class="social-row">
                    <a class="social-button" id="google-button" href="/auth/google/start" hidden>
                        <svg viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/>
                            <path fill="#FBBC05" d="M10.5 28.7c-.5-1.5-.8-3.1-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.3 0 20 0 24s.9 7.7 2.6 10.8l7.9-6.1z"/>
                            <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.9 2.3-8.4 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/>
                        </svg>Google
                    </a>
                    <a class="social-button" id="github-button" href="/auth/github/start" hidden>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#0d1b2a" d="M12 .5C5.6.5.5 5.6.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.3 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 015.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0023.5 12C23.5 5.6 18.4.5 12 .5z"/></svg>GitHub
                    </a>
                </div>
            </div>

            <p class="register">New to MellowTech? <a href="register.html">Create an account</a></p>

            <div class="security-note">
                <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>
                <span>MellowTech Security Environment. Authorised users only. Sign-in activity is logged.</span>
            </div>
            <div class="foot" id="clock"></div>

        </main>
    </div>

    <div class="page-foot">&copy; 2026 MellowTech (Pty) Ltd. All rights reserved.</div>

    <script>
        /* ---------------- helpers ---------------- */
        function setMessage(text, kind) {
            var message = document.getElementById("login-message");
            message.textContent = text;
            message.className = kind || "";
        }

        function shakeCard() {
            var shell = document.getElementById("shell");
            shell.classList.remove("shake");
            void shell.offsetWidth;
            shell.classList.add("shake");
        }

        function setBusy(busy) {
            var button = document.getElementById("login-button");
            button.disabled = busy;
            button.classList.toggle("busy", busy);
            document.getElementById("login-label").textContent = busy ? "Signing in..." : "Sign In";
        }

        function wrongServer(status) {
            return "The server sent an unexpected reply (error " + status + "). Open this page at " +
                   "http://127.0.0.1:5000/ after starting start.bat, not through VS Code Live Server.";
        }

        /* ---------------- remember my email (the email only, never the password) ---------------- */
        function savedEmail() {
            try { return localStorage.getItem("mt-email") || ""; } catch (e) { return ""; }
        }
        function rememberEmail(email, keep) {
            try {
                if (keep) { localStorage.setItem("mt-email", email); }
                else { localStorage.removeItem("mt-email"); }
            } catch (e) { /* storage may be blocked; that is fine */ }
        }

        (function () {
            var email = savedEmail();
            if (email) {
                document.getElementById("username").value = email;
                document.getElementById("remember").checked = true;
                document.getElementById("password").focus();
            }
        })();

        /* ---------------- sign in ---------------- */
        async function login(event) {
            event.preventDefault();

            var emailField = document.getElementById("username");
            var passwordField = document.getElementById("password");
            var email = emailField.value.trim();

            if (!email || !passwordField.value) {
                setMessage("Please enter your email and password.", "error");
                shakeCard();
                return;
            }

            setBusy(true);
            setMessage("", "");

            try {
                var response = await fetch("/api/auth/login", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email: email, password: passwordField.value })
                });
                var data = await response.json().catch(function () { return null; });

                if (data === null) {
                    setMessage(wrongServer(response.status), "error");
                    shakeCard();
                    passwordField.value = "";
                    setBusy(false);
                    return;
                }
                if (response.ok) {
                    rememberEmail(email, document.getElementById("remember").checked);
                    setMessage("Signed in. Opening dashboard...", "ok");
                    window.location.href = "/index.html";
                    return;
                }
                setMessage(data.error || "Could not sign in.", "error");
            } catch (error) {
                setMessage("Cannot reach the server. Start it with: python app.py, then open http://127.0.0.1:5000", "error");
            }

            shakeCard();
            passwordField.value = "";
            passwordField.focus();
            setBusy(false);
        }

        /* ---------------- Google / GitHub buttons (only when the server has them on) ---------------- */
        fetch("/api/auth/providers").then(function (r) { return r.json(); }).then(function (p) {
            ["google", "github"].forEach(function (name) {
                if (p[name]) {
                    document.getElementById(name + "-button").hidden = false;
                    document.getElementById("social").hidden = false;
                }
            });
        }).catch(function () {});

        var SIGN_IN_ERRORS = {idle_timeout: "You were signed out after a few minutes of inactivity.",
            provider_off: "That sign-in method is not turned on.",
            oauth_failed: "Sign-in with that account did not work. Please try again.",
            oauth_denied: "Sign-in was cancelled.",
            oauth_unverified: "That account has no verified email address, so we cannot use it.",
            pending: "Your account is waiting for approval. We will email you as soon as it is ready.",
            rejected: "Your account request was not approved. Please contact MellowTech."
        };
        var errorCode = new URLSearchParams(location.search).get("error");
        if (errorCode && SIGN_IN_ERRORS[errorCode]) { setMessage(SIGN_IN_ERRORS[errorCode], "error"); }

        /* ---------------- show / hide password + caps lock warning ---------------- */
        (function () {
            var field = document.getElementById("password");
            var toggle = document.getElementById("pw-toggle");
            var caps = document.getElementById("caps-warning");

            toggle.addEventListener("click", function () {
                var show = field.type === "password";
                field.type = show ? "text" : "password";
                toggle.textContent = show ? "Hide" : "Show";
                toggle.setAttribute("aria-pressed", String(show));
                toggle.setAttribute("aria-label", show ? "Hide password" : "Show password");
            });

            field.addEventListener("keyup", function (e) {
                caps.hidden = !e.getModifierState("CapsLock");
            });
            field.addEventListener("blur", function () { caps.hidden = true; });
        })();

        /* ---------------- live server status chip ---------------- */
        (function () {
            var chip = document.getElementById("server-chip");
            var text = document.getElementById("server-text");
            var started = performance.now();

            fetch("/api/status", { cache: "no-store" }).then(function (r) { return r.json(); }).then(function (d) {
                if (d.status !== "online") { throw new Error("not online"); }
                var ms = Math.round(performance.now() - started);
                chip.className = "chip live";
                text.textContent = "Server online \u00B7 " + ms + " ms";
            }).catch(function () {
                chip.className = "chip down";
                text.textContent = "Server not reachable";
                setMessage("This page is not connected to the MellowTech server. Start start.bat, then open " +
                           "http://127.0.0.1:5000/ (not the address Live Server gives you).", "error");
            });
        })();

        /* ---------------- greeting and clock ---------------- */
        (function () {
            var hour = new Date().getHours();
            var word = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
            document.getElementById("greeting").textContent = word;

            var clock = document.getElementById("clock");
            function tick() {
                clock.textContent = new Date().toLocaleString(undefined, {
                    weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit"
                });
            }
            tick();
            setInterval(tick, 30000);
        })();

        /* ---------------- rotating feature highlights ---------------- */
        (function () {
            var slides = document.querySelectorAll("#slides .slide");
            var dots = document.querySelectorAll("#dots .dot");
            var current = 0;
            var timer = null;
            var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            function show(index) {
                current = (index + slides.length) % slides.length;
                slides.forEach(function (s, i) { s.classList.toggle("on", i === current); });
                dots.forEach(function (d, i) { d.classList.toggle("on", i === current); });
            }

            function start() {
                if (reduce) { return; }
                clearInterval(timer);
                timer = setInterval(function () { show(current + 1); }, 5200);
            }

            dots.forEach(function (dot, i) {
                dot.addEventListener("click", function () { show(i); start(); });
            });

            start();
        })();

        /* ---------------- animated network background ---------------- */
        (function () {
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { return; }

            var canvas = document.getElementById("bg-canvas");
            var ctx = canvas.getContext("2d");
            var nodes = [];
            var width = 0;
            var height = 0;
            var ratio = Math.min(window.devicePixelRatio || 1, 2);
            var running = true;

            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                canvas.width = width * ratio;
                canvas.height = height * ratio;
                ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

                var count = Math.max(24, Math.min(70, Math.round(width * height / 26000)));
                nodes = [];
                for (var i = 0; i < count; i++) {
                    nodes.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        vx: (Math.random() - 0.5) * 0.28,
                        vy: (Math.random() - 0.5) * 0.28
                    });
                }
            }

            function frame() {
                if (!running) { return; }
                ctx.clearRect(0, 0, width, height);

                for (var i = 0; i < nodes.length; i++) {
                    var a = nodes[i];
                    a.x += a.vx;
                    a.y += a.vy;
                    if (a.x < 0 || a.x > width) { a.vx *= -1; }
                    if (a.y < 0 || a.y > height) { a.vy *= -1; }

                    ctx.beginPath();
                    ctx.arc(a.x, a.y, 1.6, 0, Math.PI * 2);
                    ctx.fillStyle = "rgba(61, 219, 176, .55)";
                    ctx.fill();

                    for (var j = i + 1; j < nodes.length; j++) {
                        var b = nodes[j];
                        var dx = a.x - b.x;
                        var dy = a.y - b.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 130) {
                            ctx.beginPath();
                            ctx.moveTo(a.x, a.y);
                            ctx.lineTo(b.x, b.y);
                            ctx.strokeStyle = "rgba(74, 168, 255," + (0.16 * (1 - dist / 130)).toFixed(3) + ")";
                            ctx.lineWidth = 1;
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(frame);
            }

            document.addEventListener("visibilitychange", function () {
                running = !document.hidden;
                if (running) { requestAnimationFrame(frame); }
            });

            window.addEventListener("resize", resize);
            resize();
            requestAnimationFrame(frame);
        })();
    </script>
</body>
</html>