<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#07111d">
    <title>MellowTech | Create Account</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2l9 3v7c0 5.5-3.8 8.6-9 10-5.2-1.4-9-4.5-9-10V5z' fill='%230d1b2a'/%3E%3Cpath d='M8 12l3 3 5-6' fill='none' stroke='%233ddbb0' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">

    <style>
        :root {
            --bg: #07111d; --ink: #0d1b2a; --text: #eaf2fb; --mute: #8fa6bf;
            --teal: #3ddbb0; --blue: #4aa8ff; --bad: #b42318; --ok: #12906e;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
            background:
                radial-gradient(900px 600px at 12% 8%, rgba(74,168,255,.16), transparent 60%),
                radial-gradient(800px 600px at 92% 92%, rgba(61,219,176,.14), transparent 60%),
                var(--bg);
            min-height: 100vh; display: flex; flex-direction: column;
            justify-content: center; align-items: center; padding: 24px; color: #17202a;
        }
        body::before {
            content: ""; position: fixed; inset: 0; pointer-events: none;
            background-image:
                linear-gradient(rgba(143,166,191,.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(143,166,191,.05) 1px, transparent 1px);
            background-size: 48px 48px;
            -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
        }
        .shell {
            position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.1fr;
            width: min(980px, 100%); border-radius: 20px; overflow: hidden; background: #fff;
            box-shadow: 0 0 0 1px rgba(255,255,255,.06), 0 30px 80px rgba(0,0,0,.55), 0 0 90px rgba(61,219,176,.08);
            animation: rise .7s cubic-bezier(.22,1,.36,1) both;
        }
        @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
        @keyframes spin { to { transform: rotate(360deg); } }

        .brand-panel {
            position: relative; display: flex; flex-direction: column; justify-content: space-between;
            gap: 28px; padding: 44px 38px 32px; color: var(--text); overflow: hidden;
            background:
                radial-gradient(500px 300px at 0% 0%, rgba(74,168,255,.22), transparent 65%),
                radial-gradient(420px 300px at 100% 100%, rgba(61,219,176,.18), transparent 65%),
                linear-gradient(160deg, #0f2236 0%, #0a1a2b 100%);
        }
        .mark { position: relative; width: 96px; height: 96px; margin-bottom: 20px; }
        .mark svg { position: absolute; inset: 0; width: 100%; height: 100%; }
        .ring { transform: rotate(-90deg); }
        .ring circle { fill: none; stroke-width: 6; }
        .ring .track { stroke: rgba(143,166,191,.18); }
        .ring .arc { stroke: var(--teal); stroke-linecap: round; stroke-dasharray: 327; stroke-dashoffset: 327;
            filter: drop-shadow(0 0 7px var(--teal)); animation: sweep 1.8s .3s cubic-bezier(.22,1,.36,1) forwards; }
        @keyframes sweep { to { stroke-dashoffset: 82; } }
        .shield { padding: 28px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
        .logo { font-size: 25px; font-weight: 700; letter-spacing: 3px; color: #fff; }
        .subtitle { margin-top: 3px; font-size: 11px; letter-spacing: 2.5px; color: var(--mute); }

        .steps { list-style: none; display: grid; gap: 16px; }
        .steps li { display: flex; gap: 14px; align-items: flex-start; }
        .steps .n {
            flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center;
            font-size: 13px; font-weight: 700; color: var(--teal);
            border: 1px solid rgba(61,219,176,.45); background: rgba(61,219,176,.08);
        }
        .steps b { display: block; font-size: 14px; color: #fff; margin-bottom: 2px; }
        .steps span { font-size: 13px; line-height: 1.5; color: var(--mute); }

        .chips { display: flex; flex-wrap: wrap; gap: 8px; }
        .chip {
            display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 999px;
            font-size: 12px; font-weight: 600; color: var(--text);
            background: rgba(255,255,255,.06); border: 1px solid rgba(143,166,191,.22);
        }
        .chip svg { width: 14px; height: 14px; fill: none; stroke: var(--teal); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        .form-panel { background: #fff; padding: 38px 40px 26px; display: flex; flex-direction: column; justify-content: center; }
        .greet { font-size: 12px; font-weight: 700; letter-spacing: 1.6px; color: var(--ok); text-transform: uppercase; margin-bottom: 8px; }
        h1 { font-size: 25px; margin-bottom: 6px; color: var(--ink); }
        .lead { font-size: 14px; color: #68737d; margin-bottom: 20px; }

        .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #25313d; }
        .field { position: relative; }
        .field > svg {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px;
            fill: none; stroke: #8a95a1; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; pointer-events: none;
        }
        input[type="text"], input[type="email"], input[type="password"] {
            width: 100%; padding: 12px 13px 12px 42px; border: 1.5px solid #d8dee3; border-radius: 10px;
            font-size: 15px; font-family: inherit; background: #fafbfc;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }
        input:focus { outline: none; border-color: var(--ink); background: #fff; box-shadow: 0 0 0 4px rgba(61,219,176,.28); }
        .pw-wrap input { padding-right: 66px; }
        .pw-toggle {
            position: absolute; right: 6px; top: 50%; transform: translateY(-50%); padding: 7px 10px;
            border: none; border-radius: 7px; background: transparent; color: #4a5560;
            font-size: 13px; font-weight: 600; cursor: pointer;
        }
        .pw-toggle:hover { background: #eef1f4; }

        .meter { display: flex; gap: 5px; margin-top: 8px; }
        .meter i { flex: 1; height: 4px; border-radius: 4px; background: #e4e9ee; transition: background .25s; }
        .meter-text { margin-top: 5px; font-size: 12px; color: #68737d; min-height: 16px; }
        .match { margin-top: 5px; font-size: 12px; font-weight: 600; min-height: 16px; }
        .match.ok { color: var(--ok); } .match.no { color: var(--bad); }

        .submit {
            position: relative; width: 100%; padding: 14px; margin-top: 4px; border: none; border-radius: 10px;
            background: linear-gradient(135deg, #0d1b2a 0%, #1d3550 100%); color: #fff;
            font-size: 15px; font-weight: 700; font-family: inherit; cursor: pointer;
            box-shadow: 0 8px 20px rgba(13,27,42,.28); transition: transform .15s, box-shadow .15s;
        }
        .submit:hover { transform: translateY(-1px); box-shadow: 0 12px 26px rgba(13,27,42,.34); }
        .submit:disabled { opacity: .75; cursor: default; transform: none; }
        .spinner {
            display: none; width: 16px; height: 16px; margin-right: 9px; vertical-align: -3px;
            border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite;
        }
        .submit.busy .spinner { display: inline-block; }

        #message { margin-top: 14px; text-align: center; font-size: 13px; font-weight: 600; border-radius: 8px; line-height: 1.5; }
        #message.error { color: var(--bad); background: #fdecec; padding: 10px 12px; }
        #message.ok { color: var(--ok); background: #e6f7f1; padding: 12px; }

        .or { display: flex; align-items: center; gap: 12px; margin: 16px 0 12px; font-size: 12px; color: #7b858e; }
        .or::before, .or::after { content: ""; flex: 1; height: 1px; background: #e4e9ee; }
        .social-row { display: flex; gap: 10px; }
        .social-button {
            flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 10px;
            border: 1.5px solid #d8dee3; border-radius: 10px; background: #fff; text-decoration: none;
            font-size: 14px; font-weight: 600; color: var(--ink); transition: border-color .15s, transform .15s;
        }
        .social-button svg { width: 18px; height: 18px; }
        .social-button:hover { border-color: var(--ink); transform: translateY(-1px); }

        .terms { margin-top: 12px; font-size: 12px; color: #7b858e; text-align: center; line-height: 1.5; }
        .register { margin-top: 14px; text-align: center; font-size: 13px; color: #4a5560; }
        .register a { color: var(--ink); font-weight: 700; }
        .page-foot { position: relative; z-index: 1; margin-top: 18px; font-size: 12px; color: var(--mute); }
        [hidden] { display: none !important; }

        @media (max-width: 820px) {
            .shell { grid-template-columns: 1fr; }
            .brand-panel { padding: 24px; gap: 16px; }
            .steps, .chips { display: none; }
            .mark { width: 64px; height: 64px; margin-bottom: 10px; }
            .shield { padding: 18px; }
            .form-panel { padding: 28px 22px 22px; }
            .two { grid-template-columns: 1fr; gap: 0; }
        }
        @media (prefers-reduced-motion: reduce) { .shell, .ring .arc, .spinner { animation: none; } .ring .arc { stroke-dashoffset: 82; } }
    </style>
</head>

<body>
    <div class="shell">

        <aside class="brand-panel">
            <div>
                <div class="mark" aria-hidden="true">
                    <svg class="ring" viewBox="0 0 120 120">
                        <circle class="track" cx="60" cy="60" r="52"/>
                        <circle class="arc" cx="60" cy="60" r="52"/>
                    </svg>
                    <svg class="shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                </div>
                <div class="logo">MELLOWTECH</div>
                <div class="subtitle">CYBERSECURITY PLATFORM</div>
            </div>

            <ol class="steps">
                <li><span class="n">1</span><div><b>Create your account</b><span>Tell us about your company. It takes about a minute.</span></div></li>
                <li><span class="n">2</span><div><b>Confirm your email</b><span>We send you a secure link to verify it is really you.</span></div></li>
                <li><span class="n">3</span><div><b>Connect your laptops</b><span>Install the agent and watch your devices in real time.</span></div></li>
            </ol>

            <div class="chips">
                <span class="chip"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>Encrypted sessions</span>
                <span class="chip"><svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>Email verified</span>
            </div>
        </aside>

        <main class="form-panel">
            <div class="greet">Get started</div>
            <h1>Create an Account</h1>
            <p class="lead">Protect your devices and network in minutes.</p>

            <form id="register-form" novalidate>
                <div class="form-group">
                    <label for="company">Company name</label>
                    <div class="field">
                        <svg viewBox="0 0 24 24"><path d="M4 21V5l8-2v18M12 9h8v12M8 9h.01M8 13h.01M8 17h.01M16 13h.01M16 17h.01"/></svg>
                        <input type="text" id="company" placeholder="Your company" autocomplete="organization" maxlength="120" required>
                    </div>
                </div>

                <div class="two">
                    <div class="form-group">
                        <label for="name">Your name</label>
                        <div class="field">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            <input type="text" id="name" placeholder="Full name" autocomplete="name" maxlength="120" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <div class="field">
                            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                            <input type="email" id="email" placeholder="you@company.co.za" autocomplete="email" autocapitalize="none" spellcheck="false" required>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="field pw-wrap">
                        <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
                        <input type="password" id="password" placeholder="At least 10 characters" autocomplete="new-password" maxlength="128" required>
                        <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password">Show</button>
                    </div>
                    <div class="meter" id="meter"><i></i><i></i><i></i><i></i></div>
                    <div class="meter-text" id="meter-text">Use 10 or more characters with a mix of letters and numbers.</div>
                </div>

                <div class="form-group">
                    <label for="password2">Repeat password</label>
                    <div class="field">
                        <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
                        <input type="password" id="password2" placeholder="Type the password again" autocomplete="new-password" maxlength="128" required>
                    </div>
                    <div class="match" id="match"></div>
                </div>

                <button type="submit" class="submit" id="submit"><span class="spinner" aria-hidden="true"></span><span id="submit-label">Create Account</span></button>
            </form>

            <div id="message" role="alert"></div>

            <div id="social" hidden>
                <p class="or">or sign up with</p>
                <div class="social-row">
                    <a class="social-button" id="google-button" href="/auth/google/start" hidden>
                        <svg viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/>
                            <path fill="#FBBC05" d="M10.5 28.7c-.5-1.5-.8-3.1-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.3 0 20 0 24s.9 7.7 2.6 10.8l7.9-6.1z"/>
                            <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.9 2.3-8.4 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/>
                        </svg>Google
                    </a>
                    <a class="social-button" id="github-button" href="/auth/github/start" hidden>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#0d1b2a" d="M12 .5C5.6.5.5 5.6.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.3 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 015.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0023.5 12C23.5 5.6 18.4.5 12 .5z"/></svg>GitHub
                    </a>
                </div>
            </div>

            <p class="terms">By creating an account you agree to use MellowTech responsibly. Sign-up activity is logged.</p>
            <p class="register">Already have an account? <a href="login.html">Sign in</a></p>
        </main>
    </div>

    <div class="page-foot">&copy; 2026 MellowTech (Pty) Ltd. All rights reserved.</div>

    <script>
        var form = document.getElementById("register-form");
        var submit = document.getElementById("submit");
        var messageBox = document.getElementById("message");
        var pw = document.getElementById("password");
        var pw2 = document.getElementById("password2");

        function show(text, kind) {
            messageBox.textContent = text;
            messageBox.className = kind || "";
        }

        function busy(on) {
            submit.disabled = on;
            submit.classList.toggle("busy", on);
            document.getElementById("submit-label").textContent = on ? "Creating account..." : "Create Account";
        }

        /* Google / GitHub buttons only when the server has them switched on */
        fetch("/api/auth/providers").then(function (r) { return r.json(); }).then(function (p) {
            ["google", "github"].forEach(function (name) {
                if (p[name]) {
                    document.getElementById(name + "-button").hidden = false;
                    document.getElementById("social").hidden = false;
                }
            });
        }).catch(function () {});

        /* show / hide password */
        document.getElementById("pw-toggle").addEventListener("click", function () {
            var reveal = pw.type === "password";
            pw.type = reveal ? "text" : "password";
            pw2.type = pw.type;
            this.textContent = reveal ? "Hide" : "Show";
            this.setAttribute("aria-label", reveal ? "Hide password" : "Show password");
        });

        /* password strength meter */
        function score(p) {
            var s = 0;
            if (p.length >= 10) s++;
            if (p.length >= 14) s++;
            if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++;
            if (/\d/.test(p) && /[^A-Za-z0-9]/.test(p)) s++;
            return p.length < 10 ? Math.min(s, 1) : s;
        }
        var colors = ["#d92d20", "#f79009", "#d4a017", "#12b76a"];
        var words = ["Too weak", "Weak", "Fair", "Good", "Strong"];

        function updateMeter() {
            var p = pw.value, bars = document.querySelectorAll("#meter i"), text = document.getElementById("meter-text");
            if (!p) {
                bars.forEach(function (b) { b.style.background = ""; });
                text.textContent = "Use 10 or more characters with a mix of letters and numbers.";
                return;
            }
            var s = score(p);
            bars.forEach(function (b, i) { b.style.background = i < s ? colors[Math.max(s - 1, 0)] : ""; });
            text.textContent = p.length < 10 ? "Too short: use at least 10 characters." : "Strength: " + words[s];
        }

        function updateMatch() {
            var box = document.getElementById("match");
            if (!pw2.value) { box.textContent = ""; box.className = "match"; return; }
            var same = pw.value === pw2.value;
            box.textContent = same ? "Passwords match" : "Passwords do not match yet";
            box.className = "match " + (same ? "ok" : "no");
        }

        pw.addEventListener("input", function () { updateMeter(); updateMatch(); });
        pw2.addEventListener("input", updateMatch);

        /* opened from the confirmation email: register.html?verify=TOKEN */
        var verifyToken = new URLSearchParams(window.location.search).get("verify");
        if (verifyToken) {
            form.hidden = true;
            document.getElementById("social").hidden = true;
            document.querySelector(".lead").textContent = "Checking your confirmation link...";
            fetch("/api/auth/verify", {
                method: "POST", credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ token: verifyToken })
            }).then(function (response) {
                return response.json().catch(function () { return {}; }).then(function (data) {
                    document.querySelector(".lead").textContent = response.ok ? "Email confirmed." : "Link problem.";
                    show(response.ok ? (data.message || "Email confirmed.") : (data.error || "This confirmation link is not valid."),
                         response.ok ? "ok" : "error");
                });
            }).catch(function () {
                show("Cannot connect to the MellowTech server. Please try again.", "error");
            });
        }

        /* create the account */
        form.addEventListener("submit", async function (event) {
            event.preventDefault();

            var company = document.getElementById("company").value.trim();
            var name = document.getElementById("name").value.trim();
            var email = document.getElementById("email").value.trim();

            if (company.length < 2 || name.length < 2 || email.indexOf("@") < 1) {
                show("Please fill in your company, your name and a valid email address.", "error");
                return;
            }
            if (pw.value.length < 10) { show("Use at least 10 characters for your password.", "error"); return; }
            if (pw.value !== pw2.value) { show("The two passwords do not match.", "error"); return; }

            busy(true);
            show("", "");

            try {
                var response = await fetch("/api/auth/register", {
                    method: "POST", credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ company: company, name: name, email: email, password: pw.value })
                });
                var data = await response.json().catch(function () { return null; });

                if (data === null) {
                    show("The server sent an unexpected reply (error " + response.status + "). Open this page at http://127.0.0.1:5000/register.html", "error");
                    busy(false);
                    return;
                }
                if (!response.ok) {
                    show(data.error || "Could not create the account. Please try again.", "error");
                    busy(false);
                    return;
                }
                form.hidden = true;
                document.getElementById("social").hidden = true;
                document.querySelector(".lead").textContent = "Check your inbox.";
                show(data.message || "Almost done. We sent a confirmation link to your email.", "ok");
            } catch (error) {
                show("Cannot reach the server. Start it with: python app.py, then open http://127.0.0.1:5000", "error");
                busy(false);
            }
        });
    </script>
</body>
</html>